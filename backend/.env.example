# ============================================================================
# Process Mining SaaS - Backend Configuration
# ============================================================================
#
# QUICK START:
#   1. Copy this file: cp .env.example .env
#   2. Modify values as needed (defaults work for local development)
#   3. Run: make dev (or uvicorn src.api.main:app --reload --port 8001)
#
# ENVIRONMENT VARIABLE NAMING:
#   All settings use UPPER_SNAKE_CASE in this file
#   They map to lower_snake_case in config.py
#
# ============================================================================


# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Application name (shown in API docs and logs)
APP_NAME="Process Mining API"

# Application version (shown in /health endpoint)
APP_VERSION="1.0.0"

# Debug mode - enables:
#   - Detailed error messages with stack traces
#   - Auto-reload on code changes
#   - Additional logging
# ⚠️  Set to 'false' in production!
DEBUG=true


# ============================================================================
# API SETTINGS
# ============================================================================

# API prefix for all routes (e.g., /api/v1/datasets)
API_PREFIX="/api/v1"

# CORS allowed origins (comma-separated)
# Use "*" for development, restrict in production
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4200,http://localhost:5173,http://localhost:8080"


# ============================================================================
# DATABASE
# ============================================================================

# SQLite (default for development)
DATABASE_URL="sqlite+aiosqlite:///./process_mining.db"

# PostgreSQL (recommended for production)
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/process_mining"

# Connection pool settings (PostgreSQL only)
# DB_POOL_SIZE=5             # Number of connections to keep open
# DB_MAX_OVERFLOW=10         # Max additional connections when pool is full
# DB_POOL_RECYCLE=3600       # Recycle connections after N seconds


# ============================================================================
# AUTHENTICATION
# ============================================================================

# Enable/disable authentication
# Set to 'false' for local development to bypass login
AUTH_ENABLED=false

# JWT secret key for signing tokens
# ⚠️  CRITICAL: Change this in production! Use a long random string.
#     Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET="dev-secret-change-in-production-use-secrets-token-urlsafe-32"

# JWT algorithm (HS256 is standard)
JWT_ALGORITHM="HS256"

# Token expiration in minutes (1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440


# ============================================================================
# LOGGING & OBSERVABILITY
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG = verbose logging (development)
# INFO = normal logging (production)
LOG_LEVEL="DEBUG"

# JSON log format (set to true for production log aggregators)
LOG_JSON=false

# Request ID header for distributed tracing
# REQUEST_ID_HEADER="X-Request-ID"


# ============================================================================
# REDIS & CELERY (Background Jobs)
# ============================================================================

# Redis connection (for caching and Celery message broker)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0

# Full Redis URL (alternative to individual settings)
# REDIS_URL="redis://localhost:6379/0"

# Celery broker (task queue)
CELERY_BROKER_URL="redis://localhost:6379/0"

# Celery result backend (stores task results)
CELERY_RESULT_BACKEND="redis://localhost:6379/1"


# ============================================================================
# CACHE
# ============================================================================

# Enable/disable caching
CACHE_ENABLED=true

# Default cache TTL in seconds (3600 = 1 hour)
CACHE_DEFAULT_TTL=3600


# ============================================================================
# FILE STORAGE (Local)
# ============================================================================

# Directory for uploaded files
UPLOAD_DIR="./data/uploads"

# Directory for generated process models
MODELS_DIR="./data/models"


# ============================================================================
# OBJECT STORAGE (S3 / MinIO)
# ============================================================================

# S3 endpoint URL
# - Leave empty/unset for AWS S3
# - Set to MinIO URL for local development: http://localhost:9000
S3_ENDPOINT_URL=""

# AWS/MinIO credentials
# For local MinIO: use minioadmin/minioadmin
# For AWS: use IAM credentials or instance profile
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# AWS region (required for AWS S3, optional for MinIO)
S3_REGION="us-east-1"

# S3 bucket names
S3_BUCKET_RAW="pm-raw-dev"          # Raw uploaded files
S3_BUCKET_MODELS="pm-models-dev"    # Trained ML models
S3_BUCKET_CACHE="pm-cache-dev"      # Cached analytics results

# Presigned URL expiry in seconds (for secure file downloads)
S3_PRESIGNED_URL_EXPIRY=3600

# Maximum file size in bytes (5 GB default)
S3_MAX_FILE_SIZE_BYTES=5368709120


# ============================================================================
# OPTIONAL: OPENTELEMETRY TRACING
# ============================================================================

# Enable OpenTelemetry tracing
# OTEL_ENABLED=false

# OpenTelemetry exporter endpoint (e.g., Jaeger, Zipkin, Tempo)
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# Service name for traces
# OTEL_SERVICE_NAME="process-mining-api"


# ============================================================================
# OPTIONAL: SENTRY ERROR TRACKING
# ============================================================================

# Sentry DSN (leave empty to disable)
# SENTRY_DSN=""

# Environment name for Sentry (development, staging, production)
# SENTRY_ENVIRONMENT="development"


# ============================================================================
# DEVELOPMENT HELPERS
# ============================================================================

# Force sync mode for background tasks (useful for debugging)
# FORCE_SYNC_TASKS=false

# Disable rate limiting for development
# RATE_LIMIT_DISABLED=true
