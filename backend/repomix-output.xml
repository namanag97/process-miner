class ProcessType(str, Enum):
    """Type of process data."""

    TRADITIONAL = "traditional"  # Single-case event log
    OBJECT_CENTRIC = "object_centric"  # OCEL 2.0


class SourceFormat(str, Enum):
    """Supported source file formats."""

    CSV = "csv"
    XES = "xes"
    XLSX = "xlsx"
    JSONOCEL = "jsonocel"
    SQLITE = "sqlite"
    XMLOCEL = "xmlocel"


