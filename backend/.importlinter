[importlinter]
root_package = src
include_external_packages = false

# =============================================================================
# Clean Architecture Contracts
# =============================================================================
# Architecture Layers (inner → outer, dependencies flow outward only):
#   domain       → Pure business logic, entities, value objects (NO external deps)
#   application  → Use cases, services (depends on domain)
#   infrastructure → DB, external APIs, messaging (depends on domain, application)  
#   presentation → API routers, DTOs (depends on all layers)
# =============================================================================

# Contract 1: Layered Architecture - Dependencies must flow outward
[importlinter:contract:1]
name = Layered Architecture
type = layers
layers = 
    src.presentation
    src.infrastructure
    src.application
    src.domain

# Contract 2: Domain layer must be pure (no infrastructure dependencies)
[importlinter:contract:2]
name = Domain Independence
type = forbidden
source_modules = 
    src.domain
forbidden_modules = 
    src.infrastructure
    src.presentation

# Contract 3: Application layer cannot depend on presentation
[importlinter:contract:3]
name = Application Independence from Presentation
type = forbidden
source_modules = 
    src.application
forbidden_modules = 
    src.presentation
