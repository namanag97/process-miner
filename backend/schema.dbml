Table organizations {
  id VARCHAR(36) [pk, not null]
  name VARCHAR(255) [not null]
  slug VARCHAR(100) [not null]
  plan VARCHAR(50) [not null]
  created_at DATETIME [not null]
  updated_at DATETIME
}


Table projects {
  id VARCHAR(36) [pk, not null]
  workspace_id VARCHAR(36)
  name VARCHAR(255) [not null]
  description TEXT
  tags_json TEXT
  total_files INTEGER [not null]
  total_analyses INTEGER [not null]
  created_at DATETIME [not null]
  updated_at DATETIME
}
Ref: projects.workspace_id > workspaces.id


Table users {
  id VARCHAR(36) [pk, not null]
  org_id VARCHAR(36)
  email VARCHAR(255) [not null]
  name VARCHAR(255)
  auth_provider VARCHAR(50) [not null]
  auth_provider_id VARCHAR(255)
  role VARCHAR(50) [not null]
  password_hash VARCHAR(255)
  created_at DATETIME [not null]
  last_login_at DATETIME
}
Ref: users.org_id > organizations.id


Table workspaces {
  id VARCHAR(36) [pk, not null]
  org_id VARCHAR(36) [not null]
  name VARCHAR(255) [not null]
  description TEXT
  created_at DATETIME [not null]
  updated_at DATETIME
}
Ref: workspaces.org_id > organizations.id


Table workspace_members {
  id VARCHAR(36) [pk, not null]
  workspace_id VARCHAR(36) [not null]
  user_id VARCHAR(36) [not null]
  role VARCHAR(20) [not null]
  joined_at DATETIME [not null]
}
Ref: workspace_members.user_id > users.id
Ref: workspace_members.workspace_id > workspaces.id


Table async_jobs {
  id VARCHAR(36) [pk, not null]
  task_id VARCHAR(255)
  user_id VARCHAR(36)
  job_type VARCHAR(50) [not null]
  status VARCHAR(20) [not null]
  progress INTEGER [not null]
  stage VARCHAR(100)
  entity_type VARCHAR(50)
  entity_id VARCHAR(36)
  parent_job_id VARCHAR(36)
  parameters_json TEXT
  result_json TEXT
  error TEXT
  error_message TEXT
  created_at DATETIME [not null]
  started_at DATETIME
  completed_at DATETIME
  updated_at DATETIME
}
Ref: async_jobs.parent_job_id > async_jobs.id


Table error_logs {
  id VARCHAR(36) [pk, not null]
  timestamp DATETIME [not null]
  level VARCHAR(20) [not null]
  exception_type VARCHAR(255) [not null]
  exception_message TEXT [not null]
  stack_trace TEXT
  request_id VARCHAR(36)
  user_id VARCHAR(36)
  endpoint VARCHAR(255)
  method VARCHAR(10)
  context_json TEXT
  resolved BOOLEAN [not null]
  resolved_at DATETIME
  resolved_by VARCHAR(36)
  notes TEXT
}


Table datasets {
  id VARCHAR(36) [pk, not null]
  name VARCHAR(255) [not null]
  source_file VARCHAR(500)
  source_format VARCHAR(20) [not null]
  project_id VARCHAR(36)
  total_cases INTEGER [not null]
  total_events INTEGER [not null]
  total_activities INTEGER [not null]
  activities_json TEXT
  statistics_json TEXT
  status VARCHAR(20) [not null]
  error_message TEXT
  mapping_json TEXT
  column_suggestions_json TEXT
  detected_columns_json TEXT
  file_size_bytes INTEGER
  storage_key VARCHAR(500)
  validation_job_id VARCHAR(36)
  ingestion_job_id VARCHAR(36)
  source_dataset_id VARCHAR(36)
  filter_config_json TEXT
  is_filtered BOOLEAN [not null]
  filter_stats_json TEXT
  created_at DATETIME [not null]
  updated_at DATETIME
}
Ref: datasets.validation_job_id > async_jobs.id
Ref: datasets.project_id > projects.id
Ref: datasets.ingestion_job_id > async_jobs.id
Ref: datasets.source_dataset_id > datasets.id


Table dataset_columns {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  name VARCHAR(255) [not null]
  dtype VARCHAR(50) [not null]
  position INTEGER [not null]
  sample_values_json TEXT
  null_count INTEGER [not null]
  null_percentage FLOAT [not null]
  unique_count INTEGER [not null]
  suggested_role VARCHAR(50)
  suggestion_confidence FLOAT
  created_at DATETIME [not null]
}
Ref: dataset_columns.dataset_id > datasets.id


Table dataset_column_mappings {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  case_id_column VARCHAR(255) [not null]
  activity_column VARCHAR(255) [not null]
  timestamp_column VARCHAR(255) [not null]
  timestamp_format VARCHAR(100)
  resource_column VARCHAR(255)
  additional_columns_json TEXT
  confidence_scores_json TEXT
