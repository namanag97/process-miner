  created_at DATETIME [not null]
}
Ref: uploaded_files.dataset_id > datasets.id


Table process_cases {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  case_id VARCHAR(255) [not null]
  variant_key TEXT
  start_time DATETIME
  end_time DATETIME
}
Ref: process_cases.dataset_id > datasets.id


Table process_events {
  id VARCHAR(36) [pk, not null]
  case_ref_id VARCHAR(36) [not null]
  activity_id INTEGER
  resource_id INTEGER
  activity VARCHAR(255) [not null]
  resource VARCHAR(255)
  timestamp DATETIME [not null]
  attributes_json TEXT
}
Ref: process_events.case_ref_id > process_cases.id
Ref: process_events.resource_id > lookup_resources.id
Ref: process_events.activity_id > lookup_activities.id


Table analyses {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  name VARCHAR(255) [not null]
  analysis_type VARCHAR(50) [not null]
  config_json TEXT
  status VARCHAR(20) [not null]
  error_message TEXT
  result_summary_json TEXT
