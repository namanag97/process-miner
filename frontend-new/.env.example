# Frontend Environment Configuration
# Copy this file to .env.local for local development

# ==============================================
# API Configuration
# ==============================================

# Base URL for the backend API
VITE_API_BASE_URL=http://localhost:8001

# ==============================================
# Authentication
# ==============================================

# Enable real authentication (requires backend auth service)
# Set to 'true' in production, 'false' for mock auth
VITE_USE_REAL_AUTH=false

# Authentication API URL (only used when VITE_USE_REAL_AUTH=true)
VITE_AUTH_API_URL=http://localhost:8001/auth

# ==============================================
# Feature Flags
# ==============================================

# Enable developer tools and debugging
VITE_ENABLE_DEV_TOOLS=true

# Enable mock data for development
VITE_ENABLE_MOCK_DATA=false

# ==============================================
# Error Tracking (Optional)
# ==============================================

# Sentry DSN for error reporting (leave empty to disable)
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ==============================================
# App Info
# ==============================================

# Application version (set by CI/CD)
VITE_APP_VERSION=0.0.0-dev
