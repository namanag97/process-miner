// ============================================================================
// PROCESS MINING SaaS - PRODUCTION SCHEMA
// ============================================================================
// 
// Domain: Process Mining analytics platform
// Key Capabilities:
//   - Event log ingestion (traditional + OCEL 2.0)
//   - Process discovery (15+ algorithms)
//   - Conformance checking
//   - Prediction & recommendations
//   - Durable workflow orchestration (Temporal.io integration)
//
// Design Principles:
//   - Soft deletes on core entities (data recovery)
//   - Audit trails (created_by, created_at, updated_at)
//   - File storage paths instead of BLOBs (scalability)
//   - Denormalization where query performance demands it
//   - Comprehensive indexing for high-volume tables
//   - JSON for flexible configs, normalized columns for queryable data
//
// ============================================================================


// ============================================================================
// SECTION 1: MULTI-TENANCY & ACCESS CONTROL
// ============================================================================

Table organizations {
  id VARCHAR(36) [pk, not null]
  name VARCHAR(255) [not null]
  slug VARCHAR(100) [not null, unique]
  plan VARCHAR(50) [not null, default: 'free'] // 'free', 'pro', 'enterprise'
  settings_json JSON // Feature flags, limits, branding
  created_at DATETIME [not null]
  updated_at DATETIME
  deleted_at DATETIME // Soft delete

  indexes {
    slug [unique]
    (deleted_at, slug)
  }
}


Table users {
  id VARCHAR(36) [pk, not null]
  org_id VARCHAR(36)
  email VARCHAR(255) [not null]
  name VARCHAR(255)
  avatar_url VARCHAR(500)
  auth_provider VARCHAR(50) [not null] // 'email', 'google', 'saml'
  auth_provider_id VARCHAR(255)
  role VARCHAR(50) [not null, default: 'member'] // 'owner', 'admin', 'member', 'viewer'
  password_hash VARCHAR(255)
  preferences_json JSON // UI preferences, default algorithm params
  created_at DATETIME [not null]
  last_login_at DATETIME

  indexes {
    org_id
    email [unique]
    (auth_provider, auth_provider_id)
  }
}
Ref: users.org_id > organizations.id


Table workspaces {
  id VARCHAR(36) [pk, not null]
  org_id VARCHAR(36) [not null]
  name VARCHAR(255) [not null]
  description TEXT
  created_by VARCHAR(36) [not null]
  created_at DATETIME [not null]
  updated_at DATETIME

  indexes {
    org_id
    created_by
  }
}
Ref: workspaces.org_id > organizations.id
Ref: workspaces.created_by > users.id


Table workspace_members {
  id VARCHAR(36) [pk, not null]
  workspace_id VARCHAR(36) [not null]
  user_id VARCHAR(36) [not null]
  role VARCHAR(20) [not null, default: 'member'] // 'admin', 'member', 'viewer'
  joined_at DATETIME [not null]

  indexes {
    workspace_id
    user_id
    (workspace_id, user_id) [unique]
  }
}
Ref: workspace_members.workspace_id > workspaces.id
Ref: workspace_members.user_id > users.id


// ============================================================================
// SECTION 2: PROJECTS & DATASETS
// ============================================================================

Table projects {
  id VARCHAR(36) [pk, not null]
  workspace_id VARCHAR(36)
  created_by VARCHAR(36) [not null]
  name VARCHAR(255) [not null]
  description TEXT
  tags JSON // ["healthcare", "finance", "pilot"]
  settings_json JSON // Project-level defaults
  created_at DATETIME [not null]
  updated_at DATETIME
  deleted_at DATETIME // Soft delete

  indexes {
    workspace_id
    created_by
    deleted_at
  }
}
Ref: projects.workspace_id > workspaces.id
Ref: projects.created_by > users.id


// The core entity - an event log (traditional or object-centric)
Table datasets {
  id VARCHAR(36) [pk, not null]
  project_id VARCHAR(36)
  created_by VARCHAR(36) [not null]
  
  // Identity
  name VARCHAR(255) [not null]
  description TEXT
  
  // Type: determines which tables hold the actual events
  log_type VARCHAR(20) [not null, default: 'traditional'] // 'traditional' or 'ocel'
  
  // Source information
  source_file VARCHAR(500) // Original filename
  source_format VARCHAR(20) [not null] // 'csv', 'xes', 'parquet', 'ocel_json', 'ocel_xml'
  file_size_bytes BIGINT
  storage_key VARCHAR(500) // S3/GCS key for raw file
  
  // Processing status
  status VARCHAR(30) [not null, default: 'pending'] 
  // 'pending', 'validating', 'mapping', 'ingesting', 'computing_stats', 'ready', 'failed'
  error_message TEXT
  
  // Lineage (for filtered datasets)
  source_dataset_id VARCHAR(36) // Parent dataset if this is filtered
  is_filtered BOOLEAN [not null, default: false]
  filter_config_json JSON // Filter criteria applied
  
  // Job references (for status tracking)
  ingestion_workflow_id VARCHAR(36)
  
  // Timestamps
  created_at DATETIME [not null]
  updated_at DATETIME
  deleted_at DATETIME // Soft delete

  indexes {
    project_id
    created_by
    source_dataset_id
    status
    log_type
    deleted_at
    ingestion_workflow_id
  }
}
Ref: datasets.project_id > projects.id
Ref: datasets.created_by > users.id
Ref: datasets.source_dataset_id > datasets.id
Ref: datasets.ingestion_workflow_id > workflows.id


// Detected columns during upload (before mapping)
Table dataset_columns {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  name VARCHAR(255) [not null]
  dtype VARCHAR(50) [not null] // 'string', 'integer', 'float', 'datetime', 'boolean'
  position INTEGER [not null]
  sample_values JSON // ["value1", "value2", ...]
  null_count INTEGER [not null, default: 0]
  null_percentage FLOAT [not null, default: 0]
  unique_count INTEGER [not null, default: 0]
  
  // AI-suggested role
  suggested_role VARCHAR(50) // 'case_id', 'activity', 'timestamp', 'resource', 'attribute'
  suggestion_confidence FLOAT // 0.0 - 1.0
  
  created_at DATETIME [not null]

  indexes {
    dataset_id
    (dataset_id, position)
  }
}
Ref: dataset_columns.dataset_id > datasets.id


// User-confirmed column mappings
Table dataset_column_mappings {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null, unique] // One mapping per dataset
  
  // Required mappings
  case_id_column VARCHAR(255) [not null]
  activity_column VARCHAR(255) [not null]
  timestamp_column VARCHAR(255) [not null]
  timestamp_format VARCHAR(100) // e.g., '%Y-%m-%d %H:%M:%S'
  
  // Optional mappings
  resource_column VARCHAR(255)
  cost_column VARCHAR(255)
  end_timestamp_column VARCHAR(255) // For duration calculation
  
  // Additional attributes to import
  additional_columns JSON // ["column1", "column2"]
  
  // Metadata
  auto_mapped BOOLEAN [not null, default: false]
  confidence_scores JSON // {"case_id": 0.95, "activity": 0.88, ...}
  
  created_at DATETIME [not null]
  updated_at DATETIME

  indexes {
    dataset_id [unique]
  }
}
Ref: dataset_column_mappings.dataset_id > datasets.id


// Computed statistics (expensive to calculate, so cached here)
Table dataset_statistics {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null, unique]
  
  // Volume metrics
  total_events BIGINT [not null]
  total_cases BIGINT [not null]
  total_activities INTEGER [not null]
  total_variants BIGINT [not null]
  total_resources INTEGER
  
  // Time boundaries
  first_event_at DATETIME
  last_event_at DATETIME
  log_duration_seconds BIGINT // Total time span
  
  // Case duration statistics (in seconds)
  avg_case_duration FLOAT
  median_case_duration FLOAT
  min_case_duration FLOAT
  max_case_duration FLOAT
  stddev_case_duration FLOAT
  
  // Case length statistics (number of events)
  avg_case_length FLOAT
  min_case_length INTEGER
  max_case_length INTEGER
  
  // Variant analysis
  variant_coverage_80 INTEGER // Number of variants covering 80% of cases
  unique_variant_ratio FLOAT // variants / cases (high = spaghetti)
  
  // Activity distribution
  activities_json JSON // [{"name": "A", "count": 100, "pct": 0.15}, ...]
  
  // Resource distribution
  resources_json JSON // [{"name": "John", "count": 50}, ...]
  
  // Computation metadata
  computed_at DATETIME [not null]
  computation_time_ms INTEGER

  indexes {
    dataset_id [unique]
  }
}
Ref: dataset_statistics.dataset_id > datasets.id


// Original uploaded files (may have multiple per dataset for chunked uploads)
Table uploaded_files {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  filename VARCHAR(500) [not null]
  storage_path VARCHAR(1000) [not null] // S3/GCS path
  size_bytes BIGINT
  mime_type VARCHAR(100)
  checksum_sha256 VARCHAR(64)
  uploaded_by VARCHAR(36) [not null]
  created_at DATETIME [not null]

  indexes {
    dataset_id
    uploaded_by
    checksum_sha256
  }
}
Ref: uploaded_files.dataset_id > datasets.id
Ref: uploaded_files.uploaded_by > users.id


// ============================================================================
// SECTION 3: EVENT STORAGE (Traditional Case-Centric)
// ============================================================================

// Normalized lookup: activities
Table lookup_activities {
  id INTEGER [pk, not null, increment]
  dataset_id VARCHAR(36) [not null]
  name VARCHAR(255) [not null]
  
  // Optional enrichment
  category VARCHAR(100) // User-defined grouping
  color VARCHAR(7) // Hex color for visualization
  
  indexes {
    dataset_id
    (dataset_id, name) [unique]
  }
}
Ref: lookup_activities.dataset_id > datasets.id


// Normalized lookup: resources
Table lookup_resources {
  id INTEGER [pk, not null, increment]
  dataset_id VARCHAR(36) [not null]
  name VARCHAR(255) [not null]
  
  // Optional enrichment
  role VARCHAR(100)
  department VARCHAR(100)
  
  indexes {
    dataset_id
    (dataset_id, name) [unique]
  }
}
Ref: lookup_resources.dataset_id > datasets.id


// Process cases (one row per case/trace)
Table process_cases {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  case_id VARCHAR(255) [not null] // Original case ID from source
  
  // Precomputed case-level metrics
  variant_id VARCHAR(36) // FK to variants table
  event_count INTEGER [not null, default: 0]
  start_time DATETIME
  end_time DATETIME
  duration_seconds BIGINT // end - start
  
  // Case attributes (from source data)
  attributes_json JSON

  indexes {
    dataset_id
    (dataset_id, case_id) [unique]
    variant_id
    start_time
    duration_seconds
  }
}
Ref: process_cases.dataset_id > datasets.id
Ref: process_cases.variant_id > process_variants.id


// Process variants (unique activity sequences)
Table process_variants {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  
  // The sequence (as activity IDs or names)
  activity_sequence JSON [not null] // [1, 3, 5, 2] (activity IDs)
  activity_sequence_hash VARCHAR(64) [not null] // For fast lookup
  
  // Statistics
  case_count INTEGER [not null, default: 0]
  frequency_percent FLOAT // case_count / total_cases * 100
  avg_duration_seconds FLOAT
  
  indexes {
    dataset_id
    (dataset_id, activity_sequence_hash) [unique]
    case_count
  }
}
Ref: process_variants.dataset_id > datasets.id


// Process events (the big table - potentially millions of rows)
Table process_events {
  id VARCHAR(36) [pk, not null]
  
  // Denormalized for query performance (critical!)
  dataset_id VARCHAR(36) [not null]
  
  // References
  case_ref_id VARCHAR(36) [not null]
  activity_id INTEGER [not null]
  resource_id INTEGER // Nullable - not all logs have resources
  
  // Core event data
  timestamp DATETIME [not null]
  end_timestamp DATETIME // If available (for duration)
  
  // Event attributes
  attributes_json JSON // {"cost": 50.00, "priority": "high", ...}
  
  // Position in case (for sequence queries)
  event_index INTEGER [not null] // 0, 1, 2, ... within case

  indexes {
    dataset_id
    case_ref_id
    activity_id
    resource_id
    (dataset_id, timestamp) // Critical: time-range queries
    (dataset_id, activity_id) // Activity filtering
    (case_ref_id, event_index) // Trace reconstruction
  }
}
Ref: process_events.dataset_id > datasets.id
Ref: process_events.case_ref_id > process_cases.id
Ref: process_events.activity_id > lookup_activities.id
Ref: process_events.resource_id > lookup_resources.id


// ============================================================================
// SECTION 4: OCEL 2.0 (Object-Centric Event Logs)
// ============================================================================

// Event types in OCEL (scoped to dataset)
Table ocel2_event_types {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null] // Scoped to dataset
  name VARCHAR(255) [not null]
  attributes_schema JSON // Expected attributes for this event type

  indexes {
    dataset_id
    (dataset_id, name) [unique]
  }
}
Ref: ocel2_event_types.dataset_id > datasets.id


// Object types in OCEL (scoped to dataset)
Table ocel2_object_types {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null] // Scoped to dataset
  name VARCHAR(255) [not null]
  attributes_schema JSON // Expected attributes for this object type

  indexes {
    dataset_id
    (dataset_id, name) [unique]
  }
}
Ref: ocel2_object_types.dataset_id > datasets.id


// OCEL Events
Table ocel2_events {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null] // Denormalized
  event_type_id VARCHAR(36) [not null]
  timestamp DATETIME [not null]
  attributes JSON
  created_at DATETIME [not null]

  indexes {
    dataset_id
    event_type_id
    (dataset_id, timestamp)
  }
}
Ref: ocel2_events.dataset_id > datasets.id
Ref: ocel2_events.event_type_id > ocel2_event_types.id


// OCEL Objects
Table ocel2_objects {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null] // Denormalized
  object_type_id VARCHAR(36) [not null]
  object_id VARCHAR(255) [not null] // Original object identifier
  attributes JSON
  created_at DATETIME [not null]

  indexes {
    dataset_id
    object_type_id
    (dataset_id, object_id)
  }
}
Ref: ocel2_objects.dataset_id > datasets.id
Ref: ocel2_objects.object_type_id > ocel2_object_types.id


// Event-to-Object relationships
Table ocel2_e2o_relations {
  id VARCHAR(36) [pk, not null]
  event_id VARCHAR(36) [not null]
  object_id VARCHAR(36) [not null]
  qualifier VARCHAR(50) [not null] // Relationship type: 'created', 'modified', 'references'

  indexes {
    event_id
    object_id
    (event_id, object_id, qualifier) [unique]
  }
}
Ref: ocel2_e2o_relations.event_id > ocel2_events.id
Ref: ocel2_e2o_relations.object_id > ocel2_objects.id


// Object-to-Object relationships
Table ocel2_o2o_relations {
  id VARCHAR(36) [pk, not null]
  source_object_id VARCHAR(36) [not null]
  target_object_id VARCHAR(36) [not null]
  qualifier VARCHAR(50) [not null] // 'belongs_to', 'part_of', 'related_to'
  attributes JSON
  valid_from DATETIME
  valid_to DATETIME // Temporal validity
  created_at DATETIME [not null]

  indexes {
    source_object_id
    target_object_id
    qualifier
  }
}
Ref: ocel2_o2o_relations.source_object_id > ocel2_objects.id
Ref: ocel2_o2o_relations.target_object_id > ocel2_objects.id


// Object attribute changes over time
Table ocel2_object_changes {
  id VARCHAR(36) [pk, not null]
  object_id VARCHAR(36) [not null]
  event_id VARCHAR(36) // The event that triggered the change (optional)
  attribute_name VARCHAR(255) [not null]
  old_value TEXT
  new_value TEXT
  changed_at DATETIME [not null]

  indexes {
    object_id
    event_id
    (object_id, changed_at)
  }
}
Ref: ocel2_object_changes.object_id > ocel2_objects.id
Ref: ocel2_object_changes.event_id > ocel2_events.id


// ============================================================================
// SECTION 5: WORKFLOW ORCHESTRATION (Temporal.io Integration)
// ============================================================================

// Workflow executions (maps to Temporal workflows)
Table workflows {
  id VARCHAR(36) [pk, not null]
  
  // Temporal integration
  temporal_workflow_id VARCHAR(255) // Temporal's workflow ID
  temporal_run_id VARCHAR(255) // Temporal's run ID
  
  // Ownership
  org_id VARCHAR(36) [not null]
  user_id VARCHAR(36) [not null] // Who triggered it
  
  // Workflow definition
  workflow_type VARCHAR(50) [not null]
  // Types: 'ingestion', 'discovery', 'conformance', 'prediction', 'export', 'batch_analysis'
  
  // Context: what entity is this workflow for?
  entity_type VARCHAR(50) // 'dataset', 'model', 'analysis'
  entity_id VARCHAR(36)
  
  // Input/Output
  input_params JSON [not null] // Parameters passed to workflow
  output_result JSON // Final result (on completion)
  
  // Status tracking
  status VARCHAR(20) [not null, default: 'pending']
  // 'pending', 'running', 'completed', 'failed', 'cancelled', 'timed_out'
  progress_percent INTEGER [not null, default: 0] // 0-100
  current_step VARCHAR(100) // Human-readable current step
  
  // Error handling
  error_code VARCHAR(50)
  error_message TEXT
  retry_count INTEGER [not null, default: 0]
  
  // Timing
  created_at DATETIME [not null]
  started_at DATETIME
  completed_at DATETIME
  
  // Timeout configuration
  timeout_seconds INTEGER

  indexes {
    org_id
    user_id
    workflow_type
    status
    (entity_type, entity_id)
    temporal_workflow_id
    created_at
    (status, workflow_type) // For queue processing
  }
}
Ref: workflows.org_id > organizations.id
Ref: workflows.user_id > users.id


// Individual tasks within a workflow
Table workflow_tasks {
  id VARCHAR(36) [pk, not null]
  workflow_id VARCHAR(36) [not null]
  
  // Task identity
  task_name VARCHAR(100) [not null] // 'validate_file', 'parse_columns', 'ingest_events'
  task_order INTEGER [not null] // Execution order
  
  // Temporal activity mapping
  temporal_activity_id VARCHAR(255)
  
  // Status
  status VARCHAR(20) [not null, default: 'pending']
  // 'pending', 'running', 'completed', 'failed', 'skipped'
  progress_percent INTEGER [not null, default: 0]
  
  // Input/Output for this specific task
  input_params JSON
  output_result JSON
  
  // Error details
  error_message TEXT
  error_details JSON // Stack trace, context
  
  // Timing
  started_at DATETIME
  completed_at DATETIME
  duration_ms INTEGER

  indexes {
    workflow_id
    (workflow_id, task_order)
    status
  }
}
Ref: workflow_tasks.workflow_id > workflows.id


// ============================================================================
// SECTION 6: PROCESS MODELS
// ============================================================================

// Discovered or uploaded process models
Table process_models {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) // Can be null for manually uploaded models
  created_by VARCHAR(36) [not null]
  
  // Identity
  name VARCHAR(255) [not null]
  description TEXT
  
  // Model type and format
  model_type VARCHAR(50) [not null]
  // 'petri_net', 'process_tree', 'bpmn', 'dfg', 'heuristics_net', 'declare', 'transition_system'
  
  model_format VARCHAR(50) [not null]
  // 'pnml', 'bpmn_xml', 'json', 'dot', 'pm4py_pickle'
  
  // Storage (NOT BLOB - file path)
  storage_path VARCHAR(500) // Path to serialized model file
  
  // Quick-access graph structure (for rendering without loading full model)
  graph_json JSON // Nodes, edges, layout hints
  
  // Discovery metadata (null if manually uploaded)
  discovery_algorithm VARCHAR(50) // 'alpha', 'heuristic', 'inductive', 'inductive_infrequent', etc.
  discovery_params JSON // Parameters used: {"noise_threshold": 0.2, "dependency_thresh": 0.5}
  discovery_workflow_id VARCHAR(36) // The workflow that created this
  
  // Model source
  is_discovered BOOLEAN [not null, default: true] // false if manually uploaded
  is_reference BOOLEAN [not null, default: false] // true if this is the "ground truth" model
  
  // Version tracking
  version INTEGER [not null, default: 1]
  parent_model_id VARCHAR(36) // For model evolution tracking
  
  created_at DATETIME [not null]

  indexes {
    dataset_id
    created_by
    model_type
    discovery_algorithm
    discovery_workflow_id
    parent_model_id
    is_reference
  }
}
Ref: process_models.dataset_id > datasets.id
Ref: process_models.created_by > users.id
Ref: process_models.discovery_workflow_id > workflows.id
Ref: process_models.parent_model_id > process_models.id


// Model quality metrics (can have multiple evaluations per model)
Table process_model_metrics {
  id VARCHAR(36) [pk, not null]
  model_id VARCHAR(36) [not null]
  dataset_id VARCHAR(36) [not null] // Which dataset was used for evaluation
  
  // The Four Quality Dimensions
  fitness FLOAT // 0.0 - 1.0: Does model replay the log?
  precision FLOAT // 0.0 - 1.0: Does model allow only observed behavior?
  generalization FLOAT // 0.0 - 1.0: Does model generalize to unseen traces?
  simplicity FLOAT // 0.0 - 1.0: How simple is the model?
  
  // Composite score
  f_score FLOAT // Harmonic mean of fitness and precision
  
  // Conformance details
  fitting_traces_count INTEGER
  non_fitting_traces_count INTEGER
  fitting_traces_percent FLOAT
  average_trace_fitness FLOAT
  
  // Alignment-based metrics
  average_alignment_cost FLOAT
  alignment_details JSON // Per-trace alignment costs
  
  // Structural metrics
  total_places INTEGER // Petri net specific
  total_transitions INTEGER
  total_arcs INTEGER
  silent_transitions INTEGER
  complexity_score FLOAT // Weighted complexity measure
  
  // Evaluation metadata
  evaluation_method VARCHAR(50) // 'token_replay', 'alignment', 'footprint'
  computation_time_ms INTEGER
  computed_at DATETIME [not null]

  indexes {
    model_id
    dataset_id
    (model_id, dataset_id)
    fitness
    f_score
  }
}
Ref: process_model_metrics.model_id > process_models.id
Ref: process_model_metrics.dataset_id > datasets.id


// Cached graph layouts (expensive to compute)
Table graph_cache {
  id VARCHAR(36) [pk, not null]
  model_id VARCHAR(36) [not null]
  
  // Cache key components
  abstraction_level INTEGER [not null, default: 0] // 0 = full detail
  layout_algorithm VARCHAR(50) [not null] // 'dagre', 'elk', 'dot', 'force'
  filter_params_hash VARCHAR(64) // Hash of any filtering applied
  
  // Cached content
  layout_json JSON // Node positions, edge paths
  svg_content TEXT // Pre-rendered SVG (optional)
  
  // Cache management
  created_at DATETIME [not null]
  expires_at DATETIME
  access_count INTEGER [not null, default: 0]
  last_accessed_at DATETIME

  indexes {
    model_id
    (model_id, abstraction_level, layout_algorithm, filter_params_hash) [unique]
    expires_at
  }
}
Ref: graph_cache.model_id > process_models.id


// ============================================================================
// SECTION 7: ANALYSES & RESULTS
// ============================================================================

// Generic analysis runs (conformance, bottleneck, social network, etc.)
Table analyses {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  created_by VARCHAR(36) [not null]
  
  // Analysis identity
  name VARCHAR(255) [not null]
  analysis_type VARCHAR(50) [not null]
  // Types: 'conformance', 'bottleneck', 'social_network', 'variant_analysis', 
  //        'root_cause', 'decision_point', 'batching', 'resource_utilization'
  
  // Configuration
  config_json JSON // Analysis-specific parameters
  
  // Reference model (for conformance)
  model_id VARCHAR(36)
  
  // Status
  status VARCHAR(20) [not null, default: 'pending']
  error_message TEXT
  workflow_id VARCHAR(36)
  
  // Results (structure depends on analysis_type)
  result_summary JSON // Key findings (always populated on success)
  result_full_path VARCHAR(500) // Path to full results file (for large results)
  
  // Timing
  created_at DATETIME [not null]
  completed_at DATETIME

  indexes {
    dataset_id
    created_by
    model_id
    analysis_type
    status
    workflow_id
  }
}
Ref: analyses.dataset_id > datasets.id
Ref: analyses.created_by > users.id
Ref: analyses.model_id > process_models.id
Ref: analyses.workflow_id > workflows.id


// Conformance checking results (detailed)
Table conformance_results {
  id VARCHAR(36) [pk, not null]
  analysis_id VARCHAR(36) [not null, unique] // Links to parent analysis
  dataset_id VARCHAR(36) [not null]
  model_id VARCHAR(36) [not null]
  
  // Overall metrics
  fitness FLOAT [not null]
  precision FLOAT
  generalization FLOAT
  
  // Method used
  method VARCHAR(50) [not null] // 'token_replay', 'alignment', 'footprint'
  
  // Detailed conformance info
  total_traces INTEGER [not null]
  fitting_traces INTEGER [not null]
  non_fitting_traces INTEGER [not null]
  
  // Deviation analysis
  deviations_json JSON // [{trace_id, deviation_type, activity, expected, actual}, ...]
  deviation_patterns JSON // Common deviation patterns with frequencies
  
  // Diagnostics
  diagnostics_json JSON // Algorithm-specific diagnostic info
  
  created_at DATETIME [not null]

  indexes {
    analysis_id [unique]
    dataset_id
    model_id
    (dataset_id, model_id)
  }
}
Ref: conformance_results.analysis_id > analyses.id
Ref: conformance_results.dataset_id > datasets.id
Ref: conformance_results.model_id > process_models.id


// Cached analytics (for dashboard widgets, frequently accessed metrics)
Table analytics_cache {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  
  // Cache key
  metric_type VARCHAR(50) [not null]
  // Types: 'activity_frequency', 'case_duration_distribution', 'resource_workload',
  //        'throughput_time', 'bottleneck_activities', 'daily_case_volume'
  parameters_hash VARCHAR(64) // Hash of any parameters (date range, filters)
  
  // Cached result
  result_json JSON [not null]
  
  // Cache management
  computed_at DATETIME [not null]
  ttl_seconds INTEGER [not null, default: 3600] // 1 hour default
  expires_at DATETIME [not null]

  indexes {
    dataset_id
    (dataset_id, metric_type, parameters_hash) [unique]
    expires_at
  }
}
Ref: analytics_cache.dataset_id > datasets.id


// ============================================================================
// SECTION 8: PREDICTION & RECOMMENDATIONS
// ============================================================================

// Trained prediction models
Table prediction_models {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  created_by VARCHAR(36) [not null]
  
  // Model identity
  name VARCHAR(255) [not null]
  
  // What it predicts
  target_type VARCHAR(50) [not null]
  // 'next_activity', 'remaining_time', 'outcome', 'sla_breach', 'resource'
  
  // Algorithm used
  algorithm VARCHAR(50) [not null]
  // 'lstm', 'transformer', 'random_forest', 'xgboost', 'markov'
  
  // Model storage (NOT BLOB)
  storage_path VARCHAR(500) [not null]
  
  // Training configuration
  training_config JSON // Hyperparameters, feature engineering settings
  
  // Evaluation metrics
  metrics_json JSON // {"accuracy": 0.85, "mae": 3600, "f1": 0.82, ...}
  
  // Status
  status VARCHAR(20) [not null, default: 'training']
  // 'training', 'ready', 'deprecated', 'failed'
  
  workflow_id VARCHAR(36)
  
  // Timing
  trained_at DATETIME
  training_duration_seconds INTEGER
  created_at DATETIME [not null]

  indexes {
    dataset_id
    created_by
    target_type
    algorithm
    status
    workflow_id
  }
}
Ref: prediction_models.dataset_id > datasets.id
Ref: prediction_models.created_by > users.id
Ref: prediction_models.workflow_id > workflows.id


// Individual predictions (for running cases)
Table predictions {
  id VARCHAR(36) [pk, not null]
  model_id VARCHAR(36) [not null]
  
  // What case/prefix this is for
  case_id VARCHAR(255) [not null] // External case identifier
  case_prefix_json JSON // The events seen so far
  
  // The prediction
  prediction_json JSON [not null] // Structure depends on target_type
  confidence FLOAT // 0.0 - 1.0
  
  // For outcome tracking
  actual_outcome JSON // Filled in later for evaluation
  was_correct BOOLEAN
  
  predicted_at DATETIME [not null]

  indexes {
    model_id
    case_id
    predicted_at
    (model_id, case_id)
  }
}
Ref: predictions.model_id > prediction_models.id


// Actionable recommendations
Table recommendations {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  case_id VARCHAR(255) [not null]
  
  // Trigger
  signal_type VARCHAR(50) [not null]
  // 'sla_risk', 'bottleneck_detected', 'deviation_predicted', 'resource_overload'
  signal_data JSON // Evidence for the signal
  
  // Recommended action
  action_type VARCHAR(50) [not null]
  // 'escalate', 'reassign', 'skip_activity', 'notify', 'investigate'
  action_params JSON // Specific action parameters
  action_description TEXT // Human-readable description
  
  // Prioritization
  priority VARCHAR(20) [not null] // 'critical', 'high', 'medium', 'low'
  expected_impact JSON // {"time_saved": 3600, "cost_saved": 100}
  
  // State machine
  state VARCHAR(20) [not null, default: 'pending']
  // 'pending', 'viewed', 'accepted', 'dismissed', 'expired'
  
  // User interaction
  handled_by VARCHAR(36)
  handled_at DATETIME
  feedback TEXT
  
  created_at DATETIME [not null]
  expires_at DATETIME

  indexes {
    dataset_id
    (dataset_id, case_id)
    priority
    state
    signal_type
    created_at
    handled_by
  }
}
Ref: recommendations.dataset_id > datasets.id
Ref: recommendations.handled_by > users.id


// ============================================================================
// SECTION 9: SOCIAL NETWORK ANALYSIS
// ============================================================================

Table social_networks {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  created_by VARCHAR(36) [not null]
  analysis_id VARCHAR(36) // Parent analysis if part of analysis run
  
  // Network type
  network_type VARCHAR(50) [not null]
  // 'handover', 'working_together', 'subcontracting', 'similar_activities'
  
  // Network data (nodes = resources, edges = relationships)
  graph_json JSON // {nodes: [...], edges: [...], ...}
  
  // Network metrics
  metrics_json JSON
  // {
  //   "density": 0.45,
  //   "avg_degree": 3.2,
  //   "clustering_coefficient": 0.67,
  //   "top_central_resources": ["John", "Jane"],
  //   "communities": [[...], [...]]
  // }
  
  created_at DATETIME [not null]

  indexes {
    dataset_id
    created_by
    analysis_id
    network_type
  }
}
Ref: social_networks.dataset_id > datasets.id
Ref: social_networks.created_by > users.id
Ref: social_networks.analysis_id > analyses.id


// ============================================================================
// SECTION 10: HIERARCHICAL PROCESS MODELS (Abstraction)
// ============================================================================

// Activity grouping/abstraction definitions
Table activity_mappings {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null]
  created_by VARCHAR(36) [not null]
  
  name VARCHAR(200) [not null]
  description TEXT
  
  // Abstraction level (0 = original, 1 = first abstraction, etc.)
  level INTEGER [not null]
  
  // The mapping rules
  mapping_rules JSON [not null]
  // [{"original": ["Check A", "Check B", "Check C"], "abstracted": "Verification"}, ...]
  
  created_at DATETIME [not null]
  updated_at DATETIME

  indexes {
    dataset_id
    created_by
    level
  }
}
Ref: activity_mappings.dataset_id > datasets.id
Ref: activity_mappings.created_by > users.id


// Process models at different abstraction levels
Table hierarchical_models {
  id VARCHAR(36) [pk, not null]
  mapping_id VARCHAR(36) [not null]
  
  level INTEGER [not null]
  
  // Model data
  graph_json JSON [not null]
  storage_path VARCHAR(500) // PNML or other format
  
  // Metrics
  activity_count INTEGER [not null]
  edge_count INTEGER [not null]
  
  created_at DATETIME [not null]

  indexes {
    mapping_id
    (mapping_id, level)
  }
}
Ref: hierarchical_models.mapping_id > activity_mappings.id


// ============================================================================
// SECTION 11: OBJECT-CENTRIC PETRI NETS
// ============================================================================

// OC-PNs discovered from OCEL logs
Table oc_petri_nets {
  id VARCHAR(36) [pk, not null]
  dataset_id VARCHAR(36) [not null] // Must be an OCEL dataset
  created_by VARCHAR(36) [not null]
  
  name VARCHAR(255) [not null]
  
  // Which object types are in this net
  object_types JSON // ["Order", "Item", "Customer"]
  
  // Model storage
  storage_path VARCHAR(500)
  graph_json JSON
  
  // Discovery metadata
  discovery_algorithm VARCHAR(50)
  discovery_params JSON
  workflow_id VARCHAR(36)
  
  created_at DATETIME [not null]

  indexes {
    dataset_id
    created_by
    workflow_id
  }
}
Ref: oc_petri_nets.dataset_id > datasets.id
Ref: oc_petri_nets.created_by > users.id
Ref: oc_petri_nets.workflow_id > workflows.id


// ============================================================================
// SECTION 12: SYSTEM & OPERATIONS
// ============================================================================

// Error logging (for debugging and monitoring)
Table error_logs {
  id VARCHAR(36) [pk, not null]
  
  // When and what
  timestamp DATETIME [not null]
  level VARCHAR(20) [not null] // 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
  
  // Error details
  exception_type VARCHAR(255) [not null]
  exception_message TEXT [not null]
  stack_trace TEXT
  
  // Context
  request_id VARCHAR(36)
  user_id VARCHAR(36)
  org_id VARCHAR(36)
  endpoint VARCHAR(255)
  method VARCHAR(10)
  context_json JSON // Any additional context
  
  // Resolution tracking
  resolved BOOLEAN [not null, default: false]
  resolved_at DATETIME
  resolved_by VARCHAR(36)
  resolution_notes TEXT

  indexes {
    timestamp
    level
    user_id
    org_id
    resolved
    (level, resolved, timestamp) // For monitoring dashboard
    exception_type
  }
}
Ref: error_logs.user_id > users.id
Ref: error_logs.resolved_by > users.id


// API usage tracking (for billing and rate limiting)
Table api_usage {
  id VARCHAR(36) [pk, not null]
  org_id VARCHAR(36) [not null]
  user_id VARCHAR(36)
  
  // What was used
  resource_type VARCHAR(50) [not null] // 'discovery', 'conformance', 'prediction', 'storage'
  operation VARCHAR(50) [not null]
  
  // Quantity
  quantity INTEGER [not null, default: 1] // Events processed, API calls, etc.
  
  // Billing period
  period_start DATE [not null]
  period_end DATE [not null]
  
  recorded_at DATETIME [not null]

  indexes {
    org_id
    user_id
    (org_id, period_start, period_end)
    resource_type
  }
}
Ref: api_usage.org_id > organizations.id
Ref: api_usage.user_id > users.id


// Feature flags and A/B tests
Table feature_flags {
  id VARCHAR(36) [pk, not null]
  name VARCHAR(100) [not null, unique]
  description TEXT
  
  // Targeting
  enabled BOOLEAN [not null, default: false]
  enabled_for_orgs JSON // ["org_id_1", "org_id_2"] or null for all
  enabled_for_users JSON // ["user_id_1", ...] or null for all
  percentage_rollout INTEGER // 0-100 for gradual rollout
  
  // Configuration
  config_json JSON // Feature-specific config
  
  created_at DATETIME [not null]
  updated_at DATETIME

  indexes {
    name [unique]
    enabled
  }
}
