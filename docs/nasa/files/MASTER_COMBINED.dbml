// ============================================================================
// L2-110: IDENTITY & ACCESS MANAGEMENT SYSTEM (IAMS)
// File: L1-100_ground_segment/L2-110_identity_access.dbml
// Segment: L1-100 Ground Segment
// ============================================================================
// Subsystems:
//   L3-111: Authentication Subsystem
//   L3-112: Authorization Subsystem
//   L3-113: Session Management Subsystem
// ============================================================================
// Interfaces:
//   IF-001: Provides auth tokens to ALL systems
//   IF-IAMS-001: Receives user credentials
//   IF-IAMS-002: Integrates with SSO providers
// ============================================================================

// ============================================================================
// L3-111: AUTHENTICATION SUBSYSTEM
// ============================================================================

Table auth_providers {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Provider instance ID']
  org_id uuid [ref: > organizations.id, note: 'FK to tenant']
  
  provider_type sso_provider_type [not null, note: 'SAML, OIDC, etc.']
  name varchar(255) [not null, note: 'Display name']
  is_enabled boolean [default: true]
  is_default boolean [default: false, note: 'Default for org']
  
  // Provider Configuration (encrypted)
  config_encrypted text [not null, note: 'Encrypted JSON config']
  
  // SAML specific
  entity_id varchar(500) [default: null]
  sso_url varchar(500) [default: null]
  certificate text [default: null]
  
  // OIDC specific
  client_id varchar(255) [default: null]
  client_secret_encrypted varchar(500) [default: null]
  authorization_url varchar(500) [default: null]
  token_url varchar(500) [default: null]
  userinfo_url varchar(500) [default: null]
  
  // Attribute Mapping
  attribute_mapping jsonb [default: '{}', note: 'Maps provider attrs to user fields']
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, provider_type)
    (org_id, is_default)
  }
  
  Note: 'SSO provider configurations for federated authentication'
}

Table auth_attempts {
  id uuid [pk, default: `gen_random_uuid()`]
  
  email varchar(255) [not null]
  org_id uuid [ref: > organizations.id, default: null]
  user_id uuid [ref: > users.id, default: null]
  
  attempt_type auth_attempt_type [not null]
  status auth_attempt_status [not null]
  
  // Context
  ip_address inet [not null]
  user_agent text [default: null]
  
  // Geo (resolved async)
  geo_country varchar(2) [default: null]
  geo_region varchar(100) [default: null]
  geo_city varchar(100) [default: null]
  
  // Failure details
  failure_reason varchar(100) [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (email, created_at)
    (user_id, created_at)
    (ip_address, created_at)
    (status, created_at)
  }
  
  Note: 'Tracks all authentication attempts for security monitoring'
}

Table password_reset_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id, not null]
  
  token_hash varchar(255) [not null, unique]
  
  expires_at timestamp [not null]
  used_at timestamp [default: null]
  
  // Context
  requested_ip inet [default: null]
  used_ip inet [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    token_hash [unique]
    (user_id, expires_at)
  }
  
  Note: 'Password reset tokens with expiration'
}

Table mfa_configurations {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id, not null, unique]
  
  is_enabled boolean [default: false]
  
  // TOTP
  totp_secret_encrypted varchar(255) [default: null]
  totp_verified_at timestamp [default: null]
  
  // Backup codes
  backup_codes_hash text[] [default: '{}', note: 'Hashed backup codes']
  backup_codes_used int [default: 0]
  
  // Recovery
  recovery_email varchar(255) [default: null]
  recovery_phone varchar(20) [default: null]
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    user_id [unique]
  }
  
  Note: 'MFA configuration per user'
}

Table mfa_challenges {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id, not null]
  session_id uuid [ref: > sessions.id, default: null]
  
  challenge_type mfa_challenge_type [not null]
  status mfa_challenge_status [default: 'PENDING']
  
  // For email/SMS codes
  code_hash varchar(255) [default: null]
  
  attempts int [default: 0]
  max_attempts int [default: 3]
  
  expires_at timestamp [not null]
  verified_at timestamp [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (user_id, status, expires_at)
  }
  
  Note: 'Active MFA challenges'
}

// ============================================================================
// L3-112: AUTHORIZATION SUBSYSTEM
// ============================================================================

Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, default: null, note: 'null = system role']
  
  name varchar(100) [not null]
  display_name varchar(255) [not null]
  description text [default: null]
  
  is_system boolean [default: false, note: 'Built-in immutable role']
  is_default boolean [default: false, note: 'Assigned to new users']
  
  // Role hierarchy
  parent_role_id uuid [ref: > roles.id, default: null]
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, name) [unique]
    (org_id, is_default)
  }
  
  Note: 'Role definitions (system and custom)'
}

Table permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  
  resource_type varchar(100) [not null, note: 'Entity type (process, dashboard, etc.)']
  action varchar(50) [not null, note: 'Action (create, read, update, delete, execute)']
  
  name varchar(100) [not null, unique]
  display_name varchar(255) [not null]
  description text [default: null]
  
  // Grouping
  category varchar(100) [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (resource_type, action) [unique]
    category
  }
  
  Note: 'Permission definitions (system-managed)'
}

Table role_permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  role_id uuid [ref: > roles.id, not null]
  permission_id uuid [ref: > permissions.id, not null]
  
  // Conditions (optional ABAC)
  conditions jsonb [default: null, note: 'Attribute-based conditions']
  
  granted_at timestamp [default: `now()`]
  
  indexes {
    (role_id, permission_id) [unique]
    permission_id
  }
  
  Note: 'Role-to-permission assignments'
}

Table user_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id, not null]
  role_id uuid [ref: > roles.id, not null]
  
  // Scope (optional - for resource-specific roles)
  scope_type varchar(100) [default: null, note: 'e.g., process, project']
  scope_id uuid [default: null, note: 'Specific resource ID']
  
  granted_by uuid [ref: > users.id, default: null]
  granted_at timestamp [default: `now()`]
  expires_at timestamp [default: null]
  
  indexes {
    (user_id, role_id, scope_type, scope_id) [unique]
    (role_id)
    (scope_type, scope_id)
  }
  
  Note: 'User-to-role assignments with optional scoping'
}

Table resource_permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  
  resource_type varchar(100) [not null]
  resource_id uuid [not null]
  
  // Grantee (one of these)
  user_id uuid [ref: > users.id, default: null]
  team_id uuid [ref: > teams.id, default: null]
  role_id uuid [ref: > roles.id, default: null]
  
  permission permission_level [not null]
  
  // Inheritance
  inherited_from uuid [ref: > resource_permissions.id, default: null]
  
  granted_by uuid [ref: > users.id]
  granted_at timestamp [default: `now()`]
  expires_at timestamp [default: null]
  
  indexes {
    (resource_type, resource_id)
    user_id
    team_id
    role_id
  }
  
  Note: 'Direct resource-level permissions'
}

// ============================================================================
// L3-113: SESSION MANAGEMENT SUBSYSTEM
// ============================================================================

Table sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id, not null]
  
  // Token
  token_hash varchar(255) [not null, unique]
  refresh_token_hash varchar(255) [default: null]
  
  // Device info
  device_id varchar(255) [default: null]
  device_name varchar(255) [default: null]
  device_type device_type [default: null]
  
  // Context
  ip_address inet [default: null]
  user_agent text [default: null]
  
  // Geo
  geo_country varchar(2) [default: null]
  geo_city varchar(100) [default: null]
  
  // Lifecycle
  is_active boolean [default: true]
  last_activity_at timestamp [default: `now()`]
  expires_at timestamp [not null]
  revoked_at timestamp [default: null]
  revoked_reason varchar(100) [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    token_hash [unique]
    (user_id, is_active)
    (user_id, expires_at)
    last_activity_at
  }
  
  Note: 'Active user sessions'
}

Table api_keys {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  user_id uuid [ref: > users.id, default: null, note: 'null = org-level key']
  
  name varchar(255) [not null]
  description text [default: null]
  
  key_prefix varchar(10) [not null, note: 'First 8 chars for identification']
  key_hash varchar(255) [not null, unique]
  
  // Permissions
  scopes text[] [default: '{}', note: 'Allowed API scopes']
  
  // Restrictions
  allowed_ips inet[] [default: null, note: 'IP whitelist']
  rate_limit_per_minute int [default: 60]
  
  status api_key_status [default: 'ACTIVE']
  
  // Usage tracking
  last_used_at timestamp [default: null]
  last_used_ip inet [default: null]
  total_requests bigint [default: 0]
  
  expires_at timestamp [default: null]
  
  created_at timestamp [default: `now()`]
  revoked_at timestamp [default: null]
  revoked_by uuid [ref: > users.id, default: null]
  
  indexes {
    key_prefix
    key_hash [unique]
    (org_id, status)
    (user_id, status)
  }
  
  Note: 'API keys for programmatic access'
}

Table oauth_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id, not null]
  provider_id uuid [ref: > auth_providers.id, not null]
  
  access_token_encrypted text [not null]
  refresh_token_encrypted text [default: null]
  
  token_type varchar(50) [default: 'Bearer']
  scope text [default: null]
  
  expires_at timestamp [default: null]
  refresh_expires_at timestamp [default: null]
  
  // Provider user info
  provider_user_id varchar(255) [default: null]
  provider_email varchar(255) [default: null]
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (user_id, provider_id) [unique]
  }
  
  Note: 'OAuth tokens from external providers'
}

// ============================================================================
// SUPPORTING ENUMS FOR THIS SYSTEM
// ============================================================================

Enum auth_attempt_type {
  PASSWORD [note: 'Username/password login']
  SSO [note: 'SSO provider login']
  API_KEY [note: 'API key auth']
  MFA [note: 'MFA verification']
  REFRESH [note: 'Token refresh']
}

Enum auth_attempt_status {
  SUCCESS
  FAILED_CREDENTIALS
  FAILED_MFA
  FAILED_LOCKED
  FAILED_DISABLED
  FAILED_EXPIRED
}

Enum mfa_challenge_type {
  TOTP [note: 'Time-based OTP']
  SMS [note: 'SMS code']
  EMAIL [note: 'Email code']
  BACKUP_CODE [note: 'Backup code']
  PUSH [note: 'Push notification']
}

Enum mfa_challenge_status {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

Enum device_type {
  DESKTOP
  MOBILE
  TABLET
  API
  UNKNOWN
}
-e 


// ============================================================================
// L2-120: TENANT MANAGEMENT SYSTEM (TMS)
// File: L1-100_ground_segment/L2-120_tenant_management.dbml
// Segment: L1-100 Ground Segment
// ============================================================================
// Subsystems:
//   L3-121: Organization Subsystem
//   L3-122: User Management Subsystem
//   L3-123: Team & Permission Subsystem
// ============================================================================
// Interfaces:
//   IF-TMS-001: Provides org context to ALL systems
//   IF-TMS-002: User identity to IAMS
// ============================================================================

// ============================================================================
// L3-121: ORGANIZATION SUBSYSTEM
// ============================================================================

Table organizations {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Identity
  name varchar(255) [not null, note: 'Display name']
  slug varchar(50) [unique, not null, note: 'URL-safe identifier']
  
  // Plan & Status
  plan plan_type [default: 'TRIAL']
  status org_status [default: 'ACTIVE']
  
  // Trial info
  trial_started_at timestamp [default: `now()`]
  trial_ends_at timestamp [default: null]
  
  // Quotas
  max_users int [default: 10]
  max_processes int [default: 50]
  max_event_logs int [default: 100]
  max_storage_bytes bigint [default: 10737418240, note: '10GB default']
  max_api_calls_per_month bigint [default: 10000]
  
  // Usage Counters (denormalized for performance)
  current_users int [default: 0]
  current_processes int [default: 0]
  current_event_logs int [default: 0]
  used_storage_bytes bigint [default: 0]
  api_calls_this_month bigint [default: 0]
  
  // Feature Flags
  feature_ocel_enabled boolean [default: false]
  feature_llm_enabled boolean [default: false]
  feature_privacy_enabled boolean [default: false]
  feature_ml_enabled boolean [default: false]
  feature_sna_enabled boolean [default: false]
  feature_simulation_enabled boolean [default: false]
  feature_advanced_connectors boolean [default: false]
  
  // Defaults
  default_timezone varchar(50) [default: 'UTC']
  default_locale varchar(10) [default: 'en']
  default_date_format varchar(50) [default: 'YYYY-MM-DD']
  
  // Billing
  billing_email varchar(255) [default: null]
  billing_address jsonb [default: null]
  stripe_customer_id varchar(255) [default: null]
  
  // Branding
  logo_url text [default: null]
  primary_color varchar(7) [default: '#2563eb']
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp [default: null]
  
  indexes {
    slug [unique]
    status
    plan
    (status, plan)
  }
  
  Note: 'Multi-tenant organization (tenant) records'
}

Table org_settings {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, unique, not null]
  
  // Security Settings
  sso_enabled boolean [default: false]
  sso_enforced boolean [default: false, note: 'Require SSO for all users']
  mfa_required boolean [default: false]
  password_min_length int [default: 8]
  password_require_special boolean [default: true]
  password_expiry_days int [default: 0, note: '0 = no expiry']
  session_timeout_minutes int [default: 480]
  max_sessions_per_user int [default: 5]
  
  // Domain Settings
  allowed_email_domains text[] [default: '{}', note: 'Restrict signup to these domains']
  auto_join_enabled boolean [default: false]
  
  // Data Settings
  data_retention_days int [default: 365]
  data_export_enabled boolean [default: true]
  
  // Process Mining Defaults
  default_case_column varchar(100) [default: 'case:concept:name']
  default_activity_column varchar(100) [default: 'concept:name']
  default_timestamp_column varchar(100) [default: 'time:timestamp']
  default_resource_column varchar(100) [default: 'org:resource']
  
  // LLM Settings
  llm_provider llm_provider_type [default: null]
  llm_api_key_encrypted text [default: null]
  llm_model varchar(100) [default: null]
  llm_max_tokens_per_request int [default: 4096]
  llm_monthly_token_budget bigint [default: 1000000]
  
  // Privacy Defaults
  default_privacy_algorithm privacy_algorithm [default: 'NONE']
  default_epsilon float [default: 1.0]
  
  // Notification Settings
  notification_email_enabled boolean [default: true]
  notification_slack_enabled boolean [default: false]
  notification_slack_webhook text [default: null]
  notification_teams_enabled boolean [default: false]
  notification_teams_webhook text [default: null]
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    org_id [unique]
  }
  
  Note: 'Organization-level configuration settings'
}

Table org_invitations {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  email varchar(255) [not null]
  role user_role [default: 'VIEWER']
  team_ids uuid[] [default: '{}', note: 'Auto-add to teams on accept']
  
  token_hash varchar(255) [not null, unique]
  
  invited_by uuid [ref: > users.id, not null]
  message text [default: null, note: 'Personal message from inviter']
  
  status invitation_status [default: 'PENDING']
  
  expires_at timestamp [not null]
  accepted_at timestamp [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    token_hash [unique]
    (org_id, email)
    (org_id, status)
  }
  
  Note: 'Pending user invitations'
}

Table org_subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  plan plan_type [not null]
  status subscription_status [default: 'ACTIVE']
  
  // Billing
  billing_cycle billing_cycle [default: 'MONTHLY']
  price_cents int [not null]
  currency varchar(3) [default: 'USD']
  
  // Stripe
  stripe_subscription_id varchar(255) [default: null]
  stripe_price_id varchar(255) [default: null]
  
  // Dates
  current_period_start timestamp [not null]
  current_period_end timestamp [not null]
  canceled_at timestamp [default: null]
  cancel_at_period_end boolean [default: false]
  
  // Trial
  trial_start timestamp [default: null]
  trial_end timestamp [default: null]
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, status)
    stripe_subscription_id
  }
  
  Note: 'Subscription billing records'
}

// ============================================================================
// L3-122: USER MANAGEMENT SUBSYSTEM
// ============================================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  // Identity
  email varchar(255) [not null]
  email_verified boolean [default: false]
  email_verified_at timestamp [default: null]
  
  // Authentication
  password_hash varchar(255) [default: null, note: 'null if SSO-only']
  password_changed_at timestamp [default: null]
  
  // Status
  role user_role [default: 'VIEWER']
  status user_status [default: 'PENDING']
  
  // Profile
  first_name varchar(100) [default: null]
  last_name varchar(100) [default: null]
  display_name varchar(200) [default: null]
  avatar_url text [default: null]
  phone varchar(20) [default: null]
  
  // Preferences
  timezone varchar(50) [default: null, note: 'null = use org default']
  locale varchar(10) [default: null]
  date_format varchar(50) [default: null]
  
  // UI Preferences
  ui_theme ui_theme [default: 'SYSTEM']
  ui_sidebar_collapsed boolean [default: false]
  ui_dashboard_id uuid [default: null, note: 'Default dashboard']
  
  // Notification Preferences
  notify_email_enabled boolean [default: true]
  notify_email_digest boolean [default: true]
  notify_email_alerts boolean [default: true]
  notify_in_app_enabled boolean [default: true]
  notify_slack_enabled boolean [default: false]
  notify_slack_dm_url text [default: null]
  
  // Activity
  last_login_at timestamp [default: null]
  last_activity_at timestamp [default: null]
  login_count int [default: 0]
  
  // Security
  failed_login_count int [default: 0]
  locked_until timestamp [default: null]
  must_change_password boolean [default: false]
  
  // Metadata
  invited_by uuid [ref: > users.id, default: null]
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp [default: null]
  
  indexes {
    (org_id, email) [unique]
    (org_id, status)
    (org_id, role)
    email
  }
  
  Note: 'User accounts within organizations'
}

Table user_activity_log {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id, not null]
  org_id uuid [ref: > organizations.id, not null]
  
  activity_type user_activity_type [not null]
  
  // Context
  entity_type varchar(100) [default: null]
  entity_id uuid [default: null]
  entity_name varchar(255) [default: null]
  
  // Details
  details jsonb [default: null]
  
  // Request context
  ip_address inet [default: null]
  user_agent text [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (user_id, created_at)
    (org_id, created_at)
    (entity_type, entity_id)
  }
  
  Note: 'User activity tracking for analytics'
}

// ============================================================================
// L3-123: TEAM & PERMISSION SUBSYSTEM
// ============================================================================

Table teams {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  name varchar(255) [not null]
  slug varchar(100) [not null]
  description text [default: null]
  
  // Visual
  color varchar(7) [default: '#6366f1']
  icon varchar(50) [default: 'users']
  
  // Settings
  is_default boolean [default: false, note: 'Auto-add new users']
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, slug) [unique]
    (org_id, name)
    (org_id, is_default)
  }
  
  Note: 'Team groupings within organizations'
}

Table team_members {
  id uuid [pk, default: `gen_random_uuid()`]
  team_id uuid [ref: > teams.id, not null]
  user_id uuid [ref: > users.id, not null]
  
  role team_role [default: 'MEMBER']
  
  added_by uuid [ref: > users.id, default: null]
  added_at timestamp [default: `now()`]
  
  indexes {
    (team_id, user_id) [unique]
    user_id
  }
  
  Note: 'Team membership'
}

Table projects {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  name varchar(255) [not null]
  slug varchar(100) [not null]
  description text [default: null]
  
  // Visual
  color varchar(7) [default: '#10b981']
  icon varchar(50) [default: 'folder']
  
  // Status
  status project_status [default: 'ACTIVE']
  
  // Ownership
  owner_id uuid [ref: > users.id, default: null]
  owner_team_id uuid [ref: > teams.id, default: null]
  
  // Visibility
  visibility visibility_type [default: 'TEAM']
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  archived_at timestamp [default: null]
  
  indexes {
    (org_id, slug) [unique]
    (org_id, status)
    owner_id
    owner_team_id
  }
  
  Note: 'Projects for organizing processes and resources'
}

Table project_members {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [ref: > projects.id, not null]
  
  // Member (one of these)
  user_id uuid [ref: > users.id, default: null]
  team_id uuid [ref: > teams.id, default: null]
  
  role permission_level [default: 'VIEW']
  
  added_by uuid [ref: > users.id]
  added_at timestamp [default: `now()`]
  
  indexes {
    (project_id, user_id)
    (project_id, team_id)
    user_id
    team_id
  }
  
  Note: 'Project access control'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum invitation_status {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

Enum subscription_status {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
}

Enum billing_cycle {
  MONTHLY
  YEARLY
}

Enum ui_theme {
  LIGHT
  DARK
  SYSTEM
}

Enum user_activity_type {
  LOGIN
  LOGOUT
  VIEW
  CREATE
  UPDATE
  DELETE
  EXPORT
  SHARE
  EXECUTE
}

Enum project_status {
  ACTIVE
  ARCHIVED
  DELETED
}
-e 


// ============================================================================
// L2-130: AUDIT & COMPLIANCE SYSTEM (ACS)
// File: L1-100_ground_segment/L2-130_audit_compliance.dbml
// Segment: L1-100 Ground Segment
// ============================================================================
// Subsystems:
//   L3-131: Audit Logging Subsystem
//   L3-132: Compliance Rules Subsystem
//   L3-133: Data Retention Subsystem
// ============================================================================
// Interfaces:
//   IF-012: Receives audit events from ALL systems
//   IF-ACS-001: Provides compliance status to dashboards
// ============================================================================

// ============================================================================
// L3-131: AUDIT LOGGING SUBSYSTEM
// ============================================================================

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  user_id uuid [ref: > users.id, default: null, note: 'null for system actions']
  
  // Action
  action audit_action [not null]
  action_category audit_category [not null]
  
  // Target Entity
  entity_type varchar(100) [not null, note: 'Table/resource name']
  entity_id uuid [not null]
  entity_name varchar(255) [default: null, note: 'Human-readable name at time of action']
  
  // Changes (for UPDATE actions)
  before_state jsonb [default: null, note: 'Previous state snapshot']
  after_state jsonb [default: null, note: 'New state snapshot']
  changed_fields text[] [default: '{}', note: 'List of modified fields']
  
  // Context
  reason text [default: null, note: 'User-provided reason']
  
  // Request Context
  ip_address inet [default: null]
  user_agent text [default: null]
  request_id varchar(100) [default: null, note: 'Correlation ID']
  session_id uuid [ref: > sessions.id, default: null]
  
  // Geolocation
  geo_country varchar(2) [default: null]
  geo_region varchar(100) [default: null]
  geo_city varchar(100) [default: null]
  geo_latitude float [default: null]
  geo_longitude float [default: null]
  
  // Risk Assessment
  risk_score int [default: 0, note: '0-100 risk score']
  risk_factors text[] [default: '{}']
  is_flagged boolean [default: false]
  
  timestamp timestamptz [default: `now()`, not null]
  
  indexes {
    (org_id, timestamp)
    (org_id, entity_type, entity_id)
    (org_id, user_id, timestamp)
    (org_id, action, timestamp)
    (org_id, is_flagged)
    request_id
    timestamp
  }
  
  Note: 'Immutable audit trail for all significant actions'
}

Table audit_log_partitions {
  // Note: This is a meta table for partition management
  // Actual audit_logs table should be partitioned by timestamp
  
  id uuid [pk, default: `gen_random_uuid()`]
  partition_name varchar(100) [not null]
  
  start_date date [not null]
  end_date date [not null]
  
  row_count bigint [default: 0]
  size_bytes bigint [default: 0]
  
  status partition_status [default: 'ACTIVE']
  archived_at timestamp [default: null]
  archive_path text [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (start_date, end_date)
    status
  }
  
  Note: 'Partition metadata for audit log management'
}

Table audit_exports {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  // Export Parameters
  start_date timestamp [not null]
  end_date timestamp [not null]
  filters jsonb [default: '{}']
  
  // Status
  status job_status [default: 'PENDING']
  
  // Output
  format export_format [default: 'JSON']
  file_path text [default: null]
  file_size_bytes bigint [default: null]
  record_count bigint [default: null]
  
  // Execution
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  error_message text [default: null]
  
  requested_by uuid [ref: > users.id, not null]
  created_at timestamp [default: `now()`]
  expires_at timestamp [default: null, note: 'When download link expires']
  
  indexes {
    (org_id, status)
    requested_by
  }
  
  Note: 'Audit log export jobs'
}

// ============================================================================
// L3-132: COMPLIANCE RULES SUBSYSTEM
// ============================================================================

Table compliance_frameworks {
  id uuid [pk, default: `gen_random_uuid()`]
  
  name varchar(255) [not null, unique]
  display_name varchar(255) [not null]
  description text [default: null]
  version varchar(20) [default: '1.0']
  
  // Framework type
  framework_type framework_type [not null]
  
  // Metadata
  issuing_body varchar(255) [default: null]
  effective_date date [default: null]
  
  is_system boolean [default: true, note: 'Built-in framework']
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    name [unique]
    framework_type
  }
  
  Note: 'Compliance frameworks (GDPR, HIPAA, SOC2, etc.)'
}

Table compliance_controls {
  id uuid [pk, default: `gen_random_uuid()`]
  framework_id uuid [ref: > compliance_frameworks.id, not null]
  
  control_id varchar(50) [not null, note: 'Framework-specific ID']
  name varchar(255) [not null]
  description text [default: null]
  
  category varchar(100) [default: null]
  
  // Implementation
  implementation_guidance text [default: null]
  
  // Automation
  is_automatable boolean [default: false]
  check_query text [default: null, note: 'SQL/code to verify compliance']
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (framework_id, control_id) [unique]
    (framework_id, category)
  }
  
  Note: 'Individual compliance controls within frameworks'
}

Table compliance_rules {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  name varchar(255) [not null]
  description text [default: null]
  
  // Link to framework (optional)
  control_id uuid [ref: > compliance_controls.id, default: null]
  
  rule_type compliance_rule_type [not null]
  status rule_status [default: 'ACTIVE']
  severity alert_severity [default: 'MEDIUM']
  
  // Rule Definition
  rule_definition jsonb [not null, note: 'Rule logic definition']
  
  // Target
  target_entity_types text[] [default: '{}', note: 'Entity types to check']
  
  // Schedule
  check_schedule varchar(100) [default: '0 * * * *', note: 'Cron for automated checks']
  
  // Enforcement
  enforcement_mode enforcement_mode [default: 'MONITOR']
  auto_remediate boolean [default: false]
  remediation_action jsonb [default: null]
  
  // Grace Period
  grace_period_days int [default: 0]
  
  // Stats
  last_check_at timestamp [default: null]
  last_violation_at timestamp [default: null]
  total_checks bigint [default: 0]
  total_violations bigint [default: 0]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, status)
    (org_id, rule_type)
    control_id
  }
  
  Note: 'Organization-specific compliance rules'
}

Table compliance_checks {
  id uuid [pk, default: `gen_random_uuid()`]
  rule_id uuid [ref: > compliance_rules.id, not null]
  org_id uuid [ref: > organizations.id, not null]
  
  status job_status [default: 'PENDING']
  
  // Scope
  scope_entity_type varchar(100) [default: null]
  scope_entity_id uuid [default: null]
  
  // Results
  entities_checked int [default: 0]
  violations_found int [default: 0]
  compliance_rate float [default: null, note: 'Percentage compliant']
  
  // Execution
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  error_message text [default: null]
  
  triggered_by compliance_trigger [default: 'SCHEDULED']
  triggered_by_user uuid [ref: > users.id, default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (rule_id, created_at)
    (org_id, created_at)
    status
  }
  
  Note: 'Compliance check executions'
}

Table compliance_violations {
  id uuid [pk, default: `gen_random_uuid()`]
  check_id uuid [ref: > compliance_checks.id, not null]
  rule_id uuid [ref: > compliance_rules.id, not null]
  org_id uuid [ref: > organizations.id, not null]
  
  // Violating Entity
  entity_type varchar(100) [not null]
  entity_id uuid [not null]
  entity_name varchar(255) [default: null]
  
  // Violation Details
  violation_details jsonb [not null]
  severity alert_severity [not null]
  
  // Status
  status violation_status [default: 'OPEN']
  
  // Resolution
  resolution_type resolution_type [default: null]
  resolution_notes text [default: null]
  resolved_by uuid [ref: > users.id, default: null]
  resolved_at timestamp [default: null]
  
  // Auto-remediation
  auto_remediated boolean [default: false]
  remediation_action_taken jsonb [default: null]
  
  // Due date (based on grace period)
  due_date timestamp [default: null]
  
  detected_at timestamp [default: `now()`]
  
  indexes {
    (org_id, status)
    (rule_id, status)
    (entity_type, entity_id)
    due_date
    detected_at
  }
  
  Note: 'Individual compliance violations'
}

Table compliance_attestations {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  // Scope
  framework_id uuid [ref: > compliance_frameworks.id, default: null]
  control_id uuid [ref: > compliance_controls.id, default: null]
  
  // Attestation
  attestation_type attestation_type [not null]
  statement text [not null]
  
  // Evidence
  evidence_files text[] [default: '{}']
  evidence_notes text [default: null]
  
  // Validity
  valid_from timestamp [not null]
  valid_until timestamp [default: null]
  
  attested_by uuid [ref: > users.id, not null]
  attested_at timestamp [default: `now()`]
  
  // Review
  reviewed_by uuid [ref: > users.id, default: null]
  reviewed_at timestamp [default: null]
  review_status review_status [default: 'PENDING']
  
  indexes {
    (org_id, framework_id)
    (org_id, control_id)
    (org_id, valid_until)
  }
  
  Note: 'Manual compliance attestations'
}

// ============================================================================
// L3-133: DATA RETENTION SUBSYSTEM
// ============================================================================

Table data_retention_policies {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  name varchar(255) [not null]
  description text [default: null]
  
  // Target
  entity_type varchar(100) [not null, note: 'Table/resource type']
  
  // Retention Period
  retention_days int [not null]
  
  // Action
  action retention_action [default: 'ARCHIVE']
  
  // Archive Settings
  archive_enabled boolean [default: true]
  archive_storage_class varchar(50) [default: 'COLD']
  archive_bucket varchar(255) [default: null]
  archive_compress boolean [default: true]
  archive_encrypt boolean [default: true]
  
  // Schedule
  execution_schedule varchar(100) [default: '0 2 * * *', note: 'Daily at 2 AM']
  
  is_active boolean [default: true]
  
  // Execution Stats
  last_executed_at timestamp [default: null]
  last_execution_status job_status [default: null]
  last_records_processed bigint [default: 0]
  next_execution_at timestamp [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, entity_type) [unique]
    (org_id, is_active)
    next_execution_at
  }
  
  Note: 'Data retention and archival policies'
}

Table data_retention_executions {
  id uuid [pk, default: `gen_random_uuid()`]
  policy_id uuid [ref: > data_retention_policies.id, not null]
  org_id uuid [ref: > organizations.id, not null]
  
  status job_status [default: 'PENDING']
  
  // Scope
  cutoff_date timestamp [not null, note: 'Records older than this']
  
  // Results
  records_scanned bigint [default: 0]
  records_archived bigint [default: 0]
  records_deleted bigint [default: 0]
  records_failed bigint [default: 0]
  bytes_archived bigint [default: 0]
  bytes_freed bigint [default: 0]
  
  // Archive Location
  archive_path text [default: null]
  archive_manifest jsonb [default: null]
  
  // Execution
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  error_message text [default: null]
  error_details jsonb [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (policy_id, created_at)
    (org_id, created_at)
    status
  }
  
  Note: 'Retention policy execution history'
}

Table data_archives {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  execution_id uuid [ref: > data_retention_executions.id, not null]
  
  // Archive Info
  entity_type varchar(100) [not null]
  archive_date date [not null]
  
  // Storage
  storage_path text [not null]
  storage_class varchar(50) [not null]
  
  // Size
  record_count bigint [not null]
  compressed_size_bytes bigint [not null]
  uncompressed_size_bytes bigint [not null]
  
  // Integrity
  checksum varchar(64) [not null]
  checksum_algorithm varchar(20) [default: 'SHA256']
  
  // Encryption
  is_encrypted boolean [default: true]
  encryption_key_id varchar(255) [default: null]
  
  // Restoration
  is_restorable boolean [default: true]
  restore_by_date timestamp [default: null, note: 'After this, archive may be deleted']
  
  // Status
  status archive_status [default: 'AVAILABLE']
  
  archived_at timestamp [default: `now()`]
  deleted_at timestamp [default: null]
  
  indexes {
    (org_id, entity_type, archive_date)
    (org_id, status)
    storage_path
  }
  
  Note: 'Archived data records'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum audit_category {
  AUTHENTICATION [note: 'Login/logout events']
  AUTHORIZATION [note: 'Permission changes']
  DATA_ACCESS [note: 'Read operations']
  DATA_MODIFICATION [note: 'Create/update/delete']
  CONFIGURATION [note: 'Settings changes']
  EXPORT [note: 'Data exports']
  ADMIN [note: 'Administrative actions']
  SYSTEM [note: 'System events']
}

Enum partition_status {
  ACTIVE [note: 'Current partition']
  ARCHIVED [note: 'Moved to cold storage']
  DELETED [note: 'Permanently removed']
}

Enum framework_type {
  REGULATORY [note: 'GDPR, HIPAA, etc.']
  INDUSTRY [note: 'PCI-DSS, SOC2, etc.']
  INTERNAL [note: 'Organization policies']
  CUSTOM [note: 'User-defined']
}

Enum compliance_trigger {
  SCHEDULED [note: 'Cron-based']
  MANUAL [note: 'User-triggered']
  EVENT [note: 'Event-triggered']
  CONTINUOUS [note: 'Real-time']
}

Enum resolution_type {
  FIXED [note: 'Issue resolved']
  MITIGATED [note: 'Risk reduced']
  ACCEPTED [note: 'Risk accepted']
  FALSE_POSITIVE [note: 'Not a real violation']
  TRANSFERRED [note: 'Risk transferred']
}

Enum attestation_type {
  POLICY_ACKNOWLEDGMENT
  CONTROL_IMPLEMENTATION
  RISK_ACCEPTANCE
  AUDIT_COMPLETION
  TRAINING_COMPLETION
}

Enum review_status {
  PENDING
  APPROVED
  REJECTED
}

Enum archive_status {
  AVAILABLE [note: 'Can be restored']
  RESTORING [note: 'Restoration in progress']
  EXPIRED [note: 'Past retention, pending deletion']
  DELETED [note: 'Permanently removed']
}
-e 


// ============================================================================
// L2-210: EVENT LOG MANAGEMENT SYSTEM (ELMS)
// File: L1-200_data_segment/L2-210_event_log.dbml
// Segment: L1-200 Data Segment
// ============================================================================
// Subsystems:
//   L3-211: Traditional Event Log Subsystem (XES/CSV)
//   L3-212: Case Management Subsystem
//   L3-213: Activity Registry Subsystem
// ============================================================================
// PM4Py Modules: pm4py.read, pm4py.write, pm4py.convert, pm4py.stats
// ============================================================================
// Interfaces:
//   IF-002: Provides event logs to PDS (L2-310)
//   IF-003: Provides event logs to CCS (L2-330)
//   IF-007: Receives flattened logs from OCELS (L2-220)
// ============================================================================

// ============================================================================
// L3-211: TRADITIONAL EVENT LOG SUBSYSTEM
// ============================================================================

Table event_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  project_id uuid [ref: > projects.id, default: null]
  
  // Identity
  name varchar(255) [not null]
  description text [default: null]
  tags text[] [default: '{}']
  
  // Status
  status event_log_status [default: 'PENDING']
  
  // Source
  source_type source_type [default: 'FILE_UPLOAD']
  source_connector_id uuid [ref: > connectors.id, default: null]
  source_config jsonb [default: '{}', note: 'Source-specific configuration']
  
  // Format
  format event_log_format [default: 'XES']
  encoding varchar(20) [default: 'UTF-8']
  
  // Column Mapping (XES Standard + Custom)
  // Standard XES attributes
  case_id_column varchar(100) [default: 'case:concept:name', not null]
  activity_column varchar(100) [default: 'concept:name', not null]
  timestamp_column varchar(100) [default: 'time:timestamp', not null]
  start_timestamp_column varchar(100) [default: null, note: 'For interval events']
  
  // Optional standard columns
  resource_column varchar(100) [default: null, note: 'org:resource']
  lifecycle_column varchar(100) [default: null, note: 'lifecycle:transition']
  cost_column varchar(100) [default: null]
  
  // Custom column mappings
  custom_columns jsonb [default: '{}', note: 'Additional attribute mappings']
  
  // Statistics (denormalized for fast access)
  total_events bigint [default: 0]
  total_cases bigint [default: 0]
  total_activities int [default: 0]
  total_variants int [default: 0]
  total_resources int [default: 0]
  
  // Time Range
  data_start_time timestamptz [default: null]
  data_end_time timestamptz [default: null]
  data_span_days int [default: null]
  
  // Storage
  file_path text [default: null]
  file_size_bytes bigint [default: 0]
  file_checksum varchar(64) [default: null, note: 'SHA256']
  storage_format storage_format [default: 'PARQUET', note: 'Internal storage']
  
  // Derivation (for filtered/anonymized logs)
  parent_log_id uuid [ref: > event_logs.id, default: null]
  derivation_type derivation_type [default: null]
  derivation_params jsonb [default: null]
  
  // Privacy
  is_anonymized boolean [default: false]
  privacy_algorithm privacy_algorithm [default: 'NONE']
  privacy_params jsonb [default: '{}']
  
  // Processing
  processing_started_at timestamp [default: null]
  processing_completed_at timestamp [default: null]
  processing_error text [default: null]
  
  // Ownership
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp [default: null]
  
  indexes {
    (org_id, status)
    (org_id, name)
    (project_id)
    (source_connector_id)
    (parent_log_id)
    created_at
  }
  
  Note: 'Event logs in traditional XES/DataFrame format (pm4py.read/write compatible)'
}

Table event_log_columns {
  id uuid [pk, default: `gen_random_uuid()`]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  // Column Identity
  column_name varchar(255) [not null]
  display_name varchar(255) [default: null]
  
  // Type Information
  data_type data_type [not null]
  xes_extension varchar(100) [default: null, note: 'concept, time, org, lifecycle, cost']
  xes_key varchar(100) [default: null, note: 'Full XES key like concept:name']
  
  // Scope
  is_case_attribute boolean [default: false, note: 'Trace-level attribute']
  is_event_attribute boolean [default: true, note: 'Event-level attribute']
  
  // Statistics
  null_count bigint [default: 0]
  null_percentage float [default: 0]
  distinct_count bigint [default: 0]
  
  // For numeric columns
  min_value float [default: null]
  max_value float [default: null]
  avg_value float [default: null]
  
  // For categorical columns
  sample_values jsonb [default: '[]', note: 'Top 10 most frequent values']
  
  // For timestamp columns
  min_timestamp timestamptz [default: null]
  max_timestamp timestamptz [default: null]
  
  column_index int [not null, note: 'Original column order']
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (event_log_id, column_name) [unique]
    (event_log_id, xes_extension)
    (event_log_id, is_case_attribute)
  }
  
  Note: 'Schema information for event log columns'
}

Table events {
  id uuid [pk, default: `gen_random_uuid()`]
  event_log_id uuid [ref: > event_logs.id, not null]
  case_id varchar(255) [not null, note: 'Foreign key to cases.case_id']
  
  // Core Event Attributes (XES standard)
  activity varchar(255) [not null]
  timestamp timestamptz [not null]
  start_timestamp timestamptz [default: null, note: 'For interval events']
  
  // Standard Optional Attributes
  resource varchar(255) [default: null]
  lifecycle_transition lifecycle_transition [default: 'complete']
  cost decimal(15,2) [default: null]
  
  // Extended Attributes (flexible)
  attributes jsonb [default: '{}', note: 'All other event attributes']
  
  // Computed Fields (for performance)
  event_index int [not null, note: 'Position within case (0-based)']
  duration_seconds float [default: null, note: 'Duration if start_timestamp exists']
  
  // For partitioning
  event_date date [not null, note: 'Extracted from timestamp']
  
  indexes {
    (event_log_id, case_id, event_index)
    (event_log_id, activity)
    (event_log_id, timestamp)
    (event_log_id, resource)
    (event_log_id, event_date)
  }
  
  Note: 'Individual events (partitioned by event_log_id and event_date)'
}

// ============================================================================
// L3-212: CASE MANAGEMENT SUBSYSTEM
// ============================================================================

Table cases {
  id uuid [pk, default: `gen_random_uuid()`]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  // Case Identity
  case_id varchar(255) [not null, note: 'Original case identifier']
  
  // Case Attributes (trace-level)
  attributes jsonb [default: '{}']
  
  // Statistics
  event_count int [default: 0]
  activity_count int [default: 0, note: 'Distinct activities']
  resource_count int [default: 0, note: 'Distinct resources']
  
  // Timing
  start_time timestamptz [default: null]
  end_time timestamptz [default: null]
  duration_seconds bigint [default: null]
  
  // Variant
  variant_id uuid [ref: > variants.id, default: null]
  activity_sequence text[] [default: '{}', note: 'Ordered activity list']
  activity_sequence_hash varchar(64) [default: null, note: 'For fast variant matching']
  
  // Performance Metrics
  total_cost decimal(15,2) [default: null]
  total_waiting_time_seconds bigint [default: null]
  total_service_time_seconds bigint [default: null]
  
  // Quality Indicators
  has_rework boolean [default: false]
  rework_count int [default: 0]
  has_loop boolean [default: false]
  
  // Status (if lifecycle tracking enabled)
  is_complete boolean [default: null]
  final_activity varchar(255) [default: null]
  
  indexes {
    (event_log_id, case_id) [unique]
    (event_log_id, variant_id)
    (event_log_id, start_time)
    (event_log_id, duration_seconds)
    (event_log_id, has_rework)
    activity_sequence_hash
  }
  
  Note: 'Case (trace) summary information'
}

Table variants {
  id uuid [pk, default: `gen_random_uuid()`]
  event_log_id uuid [ref: > event_logs.id, not null]
  process_id uuid [ref: > processes.id, default: null]
  
  // Variant Definition
  variant_index int [not null, note: 'Rank by frequency (1 = most common)']
  activity_sequence text[] [not null]
  sequence_hash varchar(64) [not null]
  sequence_length int [not null]
  
  // Frequency
  case_count bigint [default: 0]
  frequency_percent float [default: 0]
  cumulative_percent float [default: 0, note: 'Cumulative frequency']
  
  // Performance (pm4py.stats)
  avg_duration_seconds float [default: null]
  min_duration_seconds float [default: null]
  max_duration_seconds float [default: null]
  median_duration_seconds float [default: null]
  stdev_duration_seconds float [default: null]
  
  // Cost
  avg_cost decimal(15,2) [default: null]
  total_cost decimal(15,2) [default: null]
  
  // Classification
  is_happy_path boolean [default: false, note: 'Most efficient variant']
  is_rework_variant boolean [default: false]
  has_loop boolean [default: false]
  
  // Analysis
  deviation_score float [default: null, note: 'From reference model']
  complexity_score float [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (event_log_id, sequence_hash) [unique]
    (event_log_id, variant_index)
    (event_log_id, case_count)
    (process_id)
  }
  
  Note: 'Process variants (unique activity sequences)'
}

// ============================================================================
// L3-213: ACTIVITY REGISTRY SUBSYSTEM
// ============================================================================

Table activities {
  id uuid [pk, default: `gen_random_uuid()`]
  event_log_id uuid [ref: > event_logs.id, not null]
  process_id uuid [ref: > processes.id, default: null]
  
  // Activity Identity
  name varchar(255) [not null]
  code varchar(50) [default: null, note: 'Short code for display']
  display_name varchar(255) [default: null]
  description text [default: null]
  
  // Category
  category varchar(100) [default: null]
  activity_type activity_type [default: 'TASK']
  
  // Frequency (pm4py.stats)
  occurrence_count bigint [default: 0]
  case_count bigint [default: 0, note: 'Cases containing activity']
  case_coverage_percent float [default: 0]
  
  // Position Statistics
  is_start_activity boolean [default: false]
  is_end_activity boolean [default: false]
  start_count bigint [default: 0]
  end_count bigint [default: 0]
  avg_position float [default: null, note: 'Average position in trace']
  
  // Performance (pm4py.stats service_time)
  avg_duration_seconds float [default: null]
  min_duration_seconds float [default: null]
  max_duration_seconds float [default: null]
  median_duration_seconds float [default: null]
  stdev_duration_seconds float [default: null]
  
  // Waiting Time (pm4py.stats sojourn_time)
  avg_waiting_time_seconds float [default: null]
  
  // Cost
  avg_cost decimal(15,2) [default: null]
  total_cost decimal(15,2) [default: null]
  
  // Rework (pm4py.stats rework)
  rework_count bigint [default: 0]
  rework_rate float [default: 0]
  self_loop_count bigint [default: 0]
  
  // Resources
  resource_count int [default: 0]
  primary_resource varchar(255) [default: null]
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (event_log_id, name) [unique]
    (event_log_id, occurrence_count)
    (event_log_id, is_start_activity)
    (event_log_id, is_end_activity)
    (process_id)
  }
  
  Note: 'Activity statistics and metadata'
}

Table activity_transitions {
  id uuid [pk, default: `gen_random_uuid()`]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  source_activity_id uuid [ref: > activities.id, not null]
  target_activity_id uuid [ref: > activities.id, not null]
  
  // Directly-Follows Frequency
  frequency bigint [default: 0]
  frequency_percent float [default: 0]
  
  // Performance (for Performance DFG)
  avg_duration_seconds float [default: null]
  min_duration_seconds float [default: null]
  max_duration_seconds float [default: null]
  median_duration_seconds float [default: null]
  stdev_duration_seconds float [default: null]
  
  // Probability
  transition_probability float [default: null, note: 'P(target|source)']
  
  indexes {
    (event_log_id, source_activity_id, target_activity_id) [unique]
    (event_log_id, frequency)
  }
  
  Note: 'Activity transition statistics (DFG edges)'
}

Table resources {
  id uuid [pk, default: `gen_random_uuid()`]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  name varchar(255) [not null]
  display_name varchar(255) [default: null]
  
  // Type
  resource_type resource_type [default: 'HUMAN']
  
  // Statistics
  event_count bigint [default: 0]
  case_count bigint [default: 0]
  activity_count int [default: 0]
  
  // Activities
  activities_performed text[] [default: '{}']
  primary_activity varchar(255) [default: null]
  
  // Performance
  avg_events_per_case float [default: null]
  avg_processing_time_seconds float [default: null]
  
  // Workload
  first_event_time timestamptz [default: null]
  last_event_time timestamptz [default: null]
  active_days int [default: 0]
  
  indexes {
    (event_log_id, name) [unique]
    (event_log_id, event_count)
  }
  
  Note: 'Resource (performer) statistics'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum storage_format {
  RAW [note: 'Original file preserved']
  PARQUET [note: 'Apache Parquet']
  ARROW [note: 'Apache Arrow']
  SQLITE [note: 'SQLite database']
}

Enum derivation_type {
  FILTERED [note: 'Filtered from parent']
  ANONYMIZED [note: 'Privacy-processed']
  SAMPLED [note: 'Sampled subset']
  ENRICHED [note: 'Enriched with external data']
  FLATTENED [note: 'Flattened from OCEL']
}

Enum activity_type {
  TASK [note: 'Standard task']
  SUBPROCESS [note: 'Subprocess call']
  GATEWAY [note: 'Decision point']
  EVENT [note: 'External event']
  MILESTONE [note: 'Checkpoint']
  AUTOMATED [note: 'System-executed']
  MANUAL [note: 'Human-executed']
}

Enum resource_type {
  HUMAN [note: 'Human performer']
  SYSTEM [note: 'Automated system']
  ROLE [note: 'Role/group']
  DEPARTMENT [note: 'Organizational unit']
  EXTERNAL [note: 'External party']
}
-e 


// ============================================================================
// L2-220: OBJECT-CENTRIC EVENT LOG SYSTEM (OCELS)
// File: L1-200_data_segment/L2-220_ocel.dbml
// Segment: L1-200 Data Segment
// ============================================================================
// Subsystems:
//   L3-221: OCEL Core Subsystem
//   L3-222: Object Graph Subsystem
//   L3-223: OCEL Flattening Subsystem
// ============================================================================
// PM4Py Modules: pm4py.ocel (full OCEL 2.0 support)
// ============================================================================
// Interfaces:
//   IF-007: Provides flattened logs to ELMS (L2-210)
//   IF-OCEL-001: OC-DFG to Visualization (L2-540)
// ============================================================================

// ============================================================================
// L3-221: OCEL CORE SUBSYSTEM
// ============================================================================

Table ocel_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  project_id uuid [ref: > projects.id, default: null]
  
  // Identity
  name varchar(255) [not null]
  description text [default: null]
  tags text[] [default: '{}']
  
  // Status
  status event_log_status [default: 'PENDING']
  
  // OCEL Version
  ocel_version varchar(10) [default: '2.0', note: 'OCEL standard version']
  
  // Source
  source_type source_type [default: 'FILE_UPLOAD']
  source_format ocel_format [default: 'SQLITE']
  source_connector_id uuid [ref: > connectors.id, default: null]
  
  // Storage
  file_path text [default: null]
  file_size_bytes bigint [default: 0]
  
  // Statistics
  total_events bigint [default: 0]
  total_objects bigint [default: 0]
  total_object_types int [default: 0]
  total_event_types int [default: 0]
  total_relations bigint [default: 0]
  
  // Time Range
  data_start_time timestamptz [default: null]
  data_end_time timestamptz [default: null]
  
  // Processing
  processing_started_at timestamp [default: null]
  processing_completed_at timestamp [default: null]
  processing_error text [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, status)
    (org_id, name)
    (project_id)
  }
  
  Note: 'Object-Centric Event Logs (OCEL 2.0 standard)'
}

Table ocel_object_types {
  id uuid [pk, default: `gen_random_uuid()`]
  ocel_log_id uuid [ref: > ocel_logs.id, not null]
  
  // Type Identity
  name varchar(255) [not null, note: 'Type identifier in OCEL']
  display_name varchar(255) [default: null]
  description text [default: null]
  
  // Visual
  color varchar(7) [default: '#3498db']
  icon varchar(50) [default: 'cube']
  
  // Schema
  attributes_schema jsonb [default: '{}', note: 'Attribute definitions']
  
  // Statistics
  object_count bigint [default: 0]
  avg_events_per_object float [default: null]
  
  indexes {
    (ocel_log_id, name) [unique]
  }
  
  Note: 'Object type definitions in OCEL log'
}

Table ocel_event_types {
  id uuid [pk, default: `gen_random_uuid()`]
  ocel_log_id uuid [ref: > ocel_logs.id, not null]
  
  // Type Identity
  name varchar(255) [not null, note: 'Event type identifier']
  display_name varchar(255) [default: null]
  description text [default: null]
  
  // Visual
  color varchar(7) [default: '#e74c3c']
  
  // Schema
  attributes_schema jsonb [default: '{}']
  
  // Object Type Relationships
  related_object_types uuid[] [default: '{}', note: 'Object types involved']
  
  // Statistics
  event_count bigint [default: 0]
  avg_objects_per_event float [default: null]
  
  indexes {
    (ocel_log_id, name) [unique]
  }
  
  Note: 'Event type definitions in OCEL log'
}

Table ocel_objects {
  id uuid [pk, default: `gen_random_uuid()`]
  ocel_log_id uuid [ref: > ocel_logs.id, not null]
  object_type_id uuid [ref: > ocel_object_types.id, not null]
  
  // Object Identity
  object_id varchar(255) [not null, note: 'Original OCEL object identifier']
  
  // Attributes
  attributes jsonb [default: '{}']
  
  // Lifecycle (pm4py.ocel lifecycle enrichment)
  lifecycle_start timestamptz [default: null]
  lifecycle_end timestamptz [default: null]
  lifecycle_duration_seconds bigint [default: null]
  
  // Event Statistics
  event_count int [default: 0]
  first_event_time timestamptz [default: null]
  last_event_time timestamptz [default: null]
  
  // Relationship Statistics
  related_objects_count int [default: 0]
  
  indexes {
    (ocel_log_id, object_id) [unique]
    (object_type_id)
    (ocel_log_id, lifecycle_start)
  }
  
  Note: 'Individual objects in OCEL log'
}

Table ocel_events {
  id uuid [pk, default: `gen_random_uuid()`]
  ocel_log_id uuid [ref: > ocel_logs.id, not null]
  event_type_id uuid [ref: > ocel_event_types.id, not null]
  
  // Event Identity
  event_id varchar(255) [not null, note: 'Original OCEL event identifier']
  
  // Timestamp
  timestamp timestamptz [not null]
  
  // Attributes
  attributes jsonb [default: '{}']
  
  // Statistics (denormalized)
  object_count int [default: 0]
  
  // Ordering
  event_index bigint [not null, note: 'Global event order']
  
  indexes {
    (ocel_log_id, event_id) [unique]
    (ocel_log_id, timestamp)
    (event_type_id)
    (ocel_log_id, event_index)
  }
  
  Note: 'Individual events in OCEL log'
}

Table ocel_event_objects {
  id uuid [pk, default: `gen_random_uuid()`]
  ocel_event_id uuid [ref: > ocel_events.id, not null]
  ocel_object_id uuid [ref: > ocel_objects.id, not null]
  
  // OCEL 2.0 Qualifier
  qualifier varchar(100) [default: null, note: 'Relationship qualifier']
  
  indexes {
    (ocel_event_id, ocel_object_id, qualifier) [unique]
    (ocel_object_id)
  }
  
  Note: 'Event-to-object relationships (E2O)'
}

// ============================================================================
// L3-222: OBJECT GRAPH SUBSYSTEM (pm4py.ocel object graphs)
// ============================================================================

Table ocel_object_relations {
  id uuid [pk, default: `gen_random_uuid()`]
  ocel_log_id uuid [ref: > ocel_logs.id, not null]
  
  source_object_id uuid [ref: > ocel_objects.id, not null]
  target_object_id uuid [ref: > ocel_objects.id, not null]
  
  // Relation Type (OCEL 2.0)
  qualifier varchar(100) [not null, note: 'Relationship type']
  
  // Derived or explicit
  is_derived boolean [default: false]
  derived_from graph_type [default: null]
  
  indexes {
    (source_object_id, target_object_id, qualifier) [unique]
    (ocel_log_id, qualifier)
    (target_object_id)
  }
  
  Note: 'Object-to-object relationships (O2O)'
}

Table ocel_object_graphs {
  id uuid [pk, default: `gen_random_uuid()`]
  ocel_log_id uuid [ref: > ocel_logs.id, not null]
  
  graph_type graph_type [not null]
  name varchar(255) [not null]
  
  // Graph Statistics
  node_count int [default: 0]
  edge_count int [default: 0]
  
  // Graph Properties
  is_directed boolean [default: true]
  is_weighted boolean [default: false]
  
  // Computation
  computed_at timestamp [default: `now()`]
  computation_params jsonb [default: '{}']
  
  // Storage
  graph_data jsonb [default: null, note: 'Serialized graph for small graphs']
  graph_file_path text [default: null, note: 'External storage for large graphs']
  
  indexes {
    (ocel_log_id, graph_type)
  }
  
  Note: 'Computed object graphs (interaction, inheritance, descendants, cobirth, codeath)'
}

Table ocel_graph_edges {
  id uuid [pk, default: `gen_random_uuid()`]
  graph_id uuid [ref: > ocel_object_graphs.id, not null]
  
  source_object_id uuid [ref: > ocel_objects.id, not null]
  target_object_id uuid [ref: > ocel_objects.id, not null]
  
  weight float [default: 1.0]
  
  // Edge attributes
  attributes jsonb [default: '{}']
  
  indexes {
    (graph_id, source_object_id, target_object_id) [unique]
    (graph_id, source_object_id)
    (graph_id, target_object_id)
  }
  
  Note: 'Edges in object graphs'
}

// ============================================================================
// L3-223: OCEL FLATTENING SUBSYSTEM
// ============================================================================

Table ocel_flattening_configs {
  id uuid [pk, default: `gen_random_uuid()`]
  ocel_log_id uuid [ref: > ocel_logs.id, not null]
  
  name varchar(255) [not null]
  description text [default: null]
  
  // Target Object Type
  object_type_id uuid [ref: > ocel_object_types.id, not null]
  
  // Flattening Strategy
  strategy flattening_strategy [default: 'EXISTENCE']
  
  // Activity Naming
  activity_prefix varchar(100) [default: null]
  include_object_type_in_activity boolean [default: false]
  
  // Attribute Handling
  include_object_attributes boolean [default: true]
  include_event_attributes boolean [default: true]
  attribute_aggregation aggregation_type [default: 'FIRST']
  
  // Related Objects
  include_related_objects boolean [default: false]
  related_object_types uuid[] [default: '{}']
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (ocel_log_id, object_type_id)
  }
  
  Note: 'OCEL flattening configurations'
}

Table ocel_flattened_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  ocel_log_id uuid [ref: > ocel_logs.id, not null]
  config_id uuid [ref: > ocel_flattening_configs.id, not null]
  
  // Result
  event_log_id uuid [ref: > event_logs.id, not null]
  
  // Statistics
  source_events bigint [default: 0]
  source_objects bigint [default: 0]
  result_events bigint [default: 0]
  result_cases bigint [default: 0]
  
  // Execution
  flattened_at timestamp [default: `now()`]
  duration_ms int [default: null]
  
  indexes {
    (ocel_log_id, config_id)
    event_log_id
  }
  
  Note: 'Flattened event logs from OCEL'
}

// OC-DFG (Object-Centric Directly-Follows Graph)
Table ocel_dfg {
  id uuid [pk, default: `gen_random_uuid()`]
  ocel_log_id uuid [ref: > ocel_logs.id, not null]
  object_type_id uuid [ref: > ocel_object_types.id, default: null, note: 'null = all types']
  
  name varchar(255) [not null]
  
  // Type
  is_performance_dfg boolean [default: false]
  
  // Statistics
  edge_count int [default: 0]
  activity_count int [default: 0]
  
  computed_at timestamp [default: `now()`]
  
  indexes {
    (ocel_log_id, object_type_id)
  }
  
  Note: 'Object-Centric DFG (pm4py.ocel OC-DFG)'
}

Table ocel_dfg_edges {
  id uuid [pk, default: `gen_random_uuid()`]
  ocel_dfg_id uuid [ref: > ocel_dfg.id, not null]
  
  source_activity varchar(255) [not null]
  target_activity varchar(255) [not null]
  
  // Frequency
  frequency bigint [default: 0]
  
  // Performance
  avg_duration_seconds float [default: null]
  min_duration_seconds float [default: null]
  max_duration_seconds float [default: null]
  
  indexes {
    (ocel_dfg_id, source_activity, target_activity) [unique]
  }
  
  Note: 'OC-DFG edges'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum graph_type {
  INTERACTION [note: 'Objects interacting via same events']
  INHERITANCE [note: 'Object derivation relationships']
  DESCENDANTS [note: 'Descendant object graph']
  COBIRTH [note: 'Objects created together']
  CODEATH [note: 'Objects ending together']
  CUSTOM [note: 'User-defined graph']
}

Enum flattening_strategy {
  EXISTENCE [note: 'One case per object']
  LIFECYCLE [note: 'Based on object lifecycle']
  LEADING_TYPE [note: 'Using leading object type']
  CUSTOM [note: 'Custom flattening logic']
}
-e 


// ============================================================================
// L2-230: DATA CONNECTOR SYSTEM (DCS)
// File: L1-200_data_segment/L2-230_connectors.dbml
// Segment: L1-200 Data Segment
// ============================================================================
// Subsystems:
//   L3-231: Database Connector Subsystem
//   L3-232: Enterprise System Connector Subsystem (SAP, Camunda)
//   L3-233: Productivity Connector Subsystem (Outlook, GitHub)
//   L3-234: Desktop Connector Subsystem (Browser, Windows)
//   L3-235: Sync Management Subsystem
// ============================================================================
// PM4Py Modules: pm4py.connectors
// ============================================================================

// ============================================================================
// CORE CONNECTOR TABLE
// ============================================================================

Table connectors {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  // Identity
  name varchar(255) [not null]
  description text [default: null]
  code varchar(50) [default: null]
  
  // Connector Type
  connector_type connector_type [not null]
  connector_category connector_category [not null]
  
  // Status
  status connector_status [default: 'INACTIVE']
  
  // Connection (encrypted)
  connection_config_encrypted text [not null]
  
  // Sync Configuration
  sync_mode sync_mode [default: 'MANUAL']
  sync_schedule varchar(100) [default: null, note: 'Cron expression']
  sync_timezone varchar(50) [default: 'UTC']
  
  // Last Sync
  last_sync_at timestamp [default: null]
  last_sync_status job_status [default: null]
  last_sync_records bigint [default: null]
  next_sync_at timestamp [default: null]
  
  // Health Monitoring
  health_status health_status [default: 'UNKNOWN']
  last_health_check_at timestamp [default: null]
  consecutive_failures int [default: 0]
  last_error text [default: null]
  last_error_at timestamp [default: null]
  
  // Quotas
  daily_sync_limit int [default: null]
  daily_syncs_used int [default: 0]
  
  // Metadata
  icon varchar(50) [default: null]
  color varchar(7) [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp [default: null]
  
  indexes {
    (org_id, connector_type)
    (org_id, status)
    (org_id, health_status)
    next_sync_at
  }
  
  Note: 'External data source connectors (pm4py.connectors)'
}

// ============================================================================
// L3-231: DATABASE CONNECTOR SUBSYSTEM
// ============================================================================

Table connector_database_configs {
  id uuid [pk, default: `gen_random_uuid()`]
  connector_id uuid [ref: > connectors.id, unique, not null]
  
  // Database Type
  db_type database_type [not null]
  
  // Connection Details
  host varchar(255) [not null]
  port int [not null]
  database_name varchar(255) [not null]
  schema_name varchar(255) [default: 'public']
  
  // Authentication
  auth_type db_auth_type [default: 'PASSWORD']
  username varchar(255) [default: null]
  // Password stored in connector.connection_config_encrypted
  
  // SSL
  ssl_enabled boolean [default: true]
  ssl_mode varchar(50) [default: 'require']
  ssl_cert_path text [default: null]
  
  // Connection Pool
  pool_size int [default: 5]
  connection_timeout_seconds int [default: 30]
  
  // Extraction Mode
  extraction_mode db_extraction_mode [default: 'TABLE']
  
  // For TABLE mode
  source_table varchar(255) [default: null]
  
  // For QUERY mode
  custom_query text [default: null]
  
  // Column Mapping
  case_id_column varchar(255) [default: null]
  activity_column varchar(255) [default: null]
  timestamp_column varchar(255) [default: null]
  resource_column varchar(255) [default: null]
  additional_columns text[] [default: '{}']
  
  // Incremental Sync
  incremental_enabled boolean [default: false]
  incremental_column varchar(255) [default: null]
  last_incremental_value text [default: null]
  
  // Discovered Schema
  discovered_schema jsonb [default: null]
  schema_discovered_at timestamp [default: null]
  
  indexes {
    connector_id [unique]
  }
  
  Note: 'Database connector configuration'
}

// ============================================================================
// L3-232: ENTERPRISE SYSTEM CONNECTOR SUBSYSTEM
// ============================================================================

Table connector_sap_configs {
  id uuid [pk, default: `gen_random_uuid()`]
  connector_id uuid [ref: > connectors.id, unique, not null]
  
  // SAP Connection
  connection_type sap_connection_type [default: 'RFC']
  
  // For RFC connection
  application_server varchar(255) [default: null]
  system_number varchar(10) [default: null]
  system_id varchar(10) [default: null]
  client varchar(10) [default: null]
  
  // For OData connection
  odata_url varchar(500) [default: null]
  odata_version varchar(10) [default: 'v2']
  
  // Process Type (pm4py.connectors SAP)
  sap_process_type sap_process_type [default: 'O2C']
  
  // For O2C (Order-to-Cash)
  o2c_config jsonb [default: '{}']
  
  // For P2P (Procure-to-Pay)
  p2p_config jsonb [default: '{}']
  
  // For Accounting
  accounting_config jsonb [default: '{}']
  
  // Table Selection
  source_tables text[] [default: '{}']
  
  // Date Filters
  date_from date [default: null]
  date_to date [default: null]
  company_codes text[] [default: '{}']
  
  indexes {
    connector_id [unique]
  }
  
  Note: 'SAP connector configuration (pm4py.connectors.extract_ocel_sap)'
}

Table connector_camunda_configs {
  id uuid [pk, default: `gen_random_uuid()`]
  connector_id uuid [ref: > connectors.id, unique, not null]
  
  // Camunda Connection
  camunda_url varchar(500) [not null]
  api_version varchar(20) [default: 'v1']
  
  // Authentication
  auth_type camunda_auth_type [default: 'BASIC']
  
  // Filters
  process_definition_keys text[] [default: '{}']
  tenant_ids text[] [default: '{}']
  
  // Date Range
  started_after timestamp [default: null]
  started_before timestamp [default: null]
  finished_after timestamp [default: null]
  finished_before timestamp [default: null]
  
  // Include Options
  include_incidents boolean [default: false]
  include_variables boolean [default: true]
  
  indexes {
    connector_id [unique]
  }
  
  Note: 'Camunda BPM connector configuration'
}

// ============================================================================
// L3-233: PRODUCTIVITY CONNECTOR SUBSYSTEM
// ============================================================================

Table connector_outlook_configs {
  id uuid [pk, default: `gen_random_uuid()`]
  connector_id uuid [ref: > connectors.id, unique, not null]
  
  // Microsoft Graph Connection
  tenant_id varchar(255) [default: null]
  
  // OAuth tokens stored in connector.connection_config_encrypted
  
  // Mailbox Selection
  mailbox_type outlook_mailbox_type [default: 'USER']
  mailbox_address varchar(255) [default: null]
  
  // Folder Filters
  folder_names text[] [default: '{}']
  include_subfolders boolean [default: true]
  
  // Date Filters
  date_from timestamp [default: null]
  date_to timestamp [default: null]
  
  // Content Options
  include_body boolean [default: false]
  include_attachments boolean [default: false]
  max_emails int [default: 10000]
  
  // Event Extraction
  extract_meetings boolean [default: false]
  extract_tasks boolean [default: false]
  
  indexes {
    connector_id [unique]
  }
  
  Note: 'Outlook connector configuration (pm4py.connectors.extract_log_outlook)'
}

Table connector_github_configs {
  id uuid [pk, default: `gen_random_uuid()`]
  connector_id uuid [ref: > connectors.id, unique, not null]
  
  // Repository
  owner varchar(255) [not null]
  repo varchar(255) [not null]
  
  // OAuth token stored in connector.connection_config_encrypted
  
  // Extraction Options
  extract_issues boolean [default: true]
  extract_pull_requests boolean [default: true]
  extract_commits boolean [default: false]
  extract_reviews boolean [default: false]
  extract_comments boolean [default: false]
  
  // Filters
  state github_state_filter [default: 'ALL']
  labels text[] [default: '{}']
  assignees text[] [default: '{}']
  
  // Date Filters
  created_after timestamp [default: null]
  created_before timestamp [default: null]
  
  // Limits
  max_items int [default: 10000]
  
  indexes {
    connector_id [unique]
  }
  
  Note: 'GitHub connector configuration (pm4py.connectors.extract_log_github)'
}

// ============================================================================
// L3-234: DESKTOP CONNECTOR SUBSYSTEM
// ============================================================================

Table connector_browser_configs {
  id uuid [pk, default: `gen_random_uuid()`]
  connector_id uuid [ref: > connectors.id, unique, not null]
  
  // Browser Type (pm4py.connectors browser history)
  browser_type browser_type [not null]
  
  // Profile
  profile_path text [default: null]
  profile_name varchar(255) [default: null]
  
  // Filters
  domain_whitelist text[] [default: '{}']
  domain_blacklist text[] [default: '{}']
  url_pattern text [default: null]
  
  // Date Filters
  date_from timestamp [default: null]
  date_to timestamp [default: null]
  
  // Options
  include_titles boolean [default: true]
  include_visit_count boolean [default: true]
  deduplicate_visits boolean [default: true]
  
  indexes {
    connector_id [unique]
  }
  
  Note: 'Browser history connector (pm4py.connectors.extract_log_chrome/firefox)'
}

Table connector_windows_configs {
  id uuid [pk, default: `gen_random_uuid()`]
  connector_id uuid [ref: > connectors.id, unique, not null]
  
  // Log Selection (pm4py.connectors.extract_log_windows_events)
  log_names text[] [default: '{Application, System, Security}']
  
  // Event Filters
  event_ids int[] [default: '{}']
  event_levels int[] [default: '{}', note: '1=Critical, 2=Error, 3=Warning, 4=Info']
  providers text[] [default: '{}']
  
  // Date Filters
  date_from timestamp [default: null]
  date_to timestamp [default: null]
  
  // Options
  max_events int [default: 100000]
  include_event_data boolean [default: true]
  
  indexes {
    connector_id [unique]
  }
  
  Note: 'Windows Event Log connector (pm4py.connectors.extract_log_windows_events)'
}

// ============================================================================
// L3-235: SYNC MANAGEMENT SUBSYSTEM
// ============================================================================

Table sync_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  connector_id uuid [ref: > connectors.id, not null]
  org_id uuid [ref: > organizations.id, not null]
  
  // Job Type
  sync_type sync_job_type [not null]
  
  status job_status [default: 'PENDING']
  priority job_priority [default: 'NORMAL']
  
  // Trigger
  triggered_by sync_trigger [default: 'MANUAL']
  triggered_by_user uuid [ref: > users.id, default: null]
  
  // Scope
  incremental_from text [default: null]
  incremental_to text [default: null]
  
  // Results
  events_extracted bigint [default: 0]
  cases_extracted bigint [default: 0]
  objects_extracted bigint [default: 0]
  bytes_processed bigint [default: 0]
  
  result_event_log_id uuid [ref: > event_logs.id, default: null]
  result_ocel_log_id uuid [ref: > ocel_logs.id, default: null]
  
  // Timing
  queued_at timestamp [default: null]
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  // Errors
  error_message text [default: null]
  error_details jsonb [default: null]
  retry_count int [default: 0]
  next_retry_at timestamp [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (connector_id, status)
    (org_id, status)
    (connector_id, created_at)
    queued_at
  }
  
  Note: 'Data synchronization jobs'
}

Table sync_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  sync_job_id uuid [ref: > sync_jobs.id, not null]
  
  // Log Entry
  level log_level [not null]
  message text [not null]
  
  // Context
  phase sync_phase [default: null]
  progress_percent int [default: null]
  records_processed bigint [default: null]
  
  // Details
  details jsonb [default: null]
  
  timestamp timestamp [default: `now()`]
  
  indexes {
    (sync_job_id, timestamp)
    (sync_job_id, level)
  }
  
  Note: 'Detailed sync job logs'
}

Table connector_schemas {
  id uuid [pk, default: `gen_random_uuid()`]
  connector_id uuid [ref: > connectors.id, not null]
  
  // Schema Identity
  schema_type schema_type [not null]
  name varchar(255) [not null]
  
  // For tables
  table_schema varchar(255) [default: null]
  table_name varchar(255) [default: null]
  
  // Column Information
  columns jsonb [default: '[]']
  primary_key text[] [default: '{}']
  row_count bigint [default: null]
  
  // Discovery
  discovered_at timestamp [default: `now()`]
  
  indexes {
    (connector_id, schema_type, name)
  }
  
  Note: 'Discovered schemas from connectors'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum connector_category {
  DATABASE [note: 'Relational databases']
  ENTERPRISE [note: 'Enterprise systems (SAP, etc.)']
  PRODUCTIVITY [note: 'Productivity tools (Outlook, GitHub)']
  DESKTOP [note: 'Desktop sources (browser, OS)']
  CLOUD_STORAGE [note: 'Cloud storage (S3, Azure, GCS)']
  API [note: 'Generic REST APIs']
}

Enum db_auth_type {
  PASSWORD
  IAM
  KERBEROS
  CERTIFICATE
}

Enum sap_connection_type {
  RFC [note: 'Remote Function Call']
  ODATA [note: 'OData API']
  HANA [note: 'Direct HANA connection']
}

Enum camunda_auth_type {
  BASIC
  OAUTH2
  API_KEY
}

Enum outlook_mailbox_type {
  USER [note: 'User mailbox']
  SHARED [note: 'Shared mailbox']
  GROUP [note: 'Group mailbox']
}

Enum github_state_filter {
  ALL
  OPEN
  CLOSED
}

Enum sync_trigger {
  MANUAL [note: 'User-initiated']
  SCHEDULED [note: 'Cron-triggered']
  WEBHOOK [note: 'External webhook']
  API [note: 'API call']
}

Enum log_level {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

Enum sync_phase {
  CONNECTING
  AUTHENTICATING
  SCHEMA_DISCOVERY
  DATA_EXTRACTION
  TRANSFORMATION
  LOADING
  VALIDATION
  CLEANUP
}

Enum schema_type {
  TABLE
  VIEW
  PROCEDURE
  API_ENDPOINT
}
-e 


// ============================================================================
// L2-240: DATA QUALITY SYSTEM (DQS)
// File: L1-200_data_segment/L2-240_data_quality.dbml
// Segment: L1-200 Data Segment
// ============================================================================
// Subsystems:
//   L3-241: Validation Subsystem
//   L3-242: Filtering Subsystem
//   L3-243: Privacy Subsystem (SaCoFa, PRIPEL)
// ============================================================================
// PM4Py Modules: pm4py.filtering, pm4py.privacy
// ============================================================================

// ============================================================================
// L3-241: VALIDATION SUBSYSTEM
// ============================================================================

Table validation_rules {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  name varchar(255) [not null]
  description text [default: null]
  
  rule_type validation_rule_type [not null]
  status rule_status [default: 'ACTIVE']
  severity validation_severity [default: 'WARNING']
  
  // Rule Definition
  rule_config jsonb [not null]
  
  // Scope
  applies_to_formats event_log_format[] [default: '{}']
  
  // Actions
  fail_action fail_action [default: 'WARN']
  auto_fix boolean [default: false]
  fix_config jsonb [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, status)
    (org_id, rule_type)
  }
  
  Note: 'Event log validation rules'
}

Table validation_results {
  id uuid [pk, default: `gen_random_uuid()`]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  status validation_status [default: 'PENDING']
  
  // Summary
  total_rules_checked int [default: 0]
  passed_rules int [default: 0]
  failed_rules int [default: 0]
  warning_rules int [default: 0]
  
  total_issues int [default: 0]
  critical_issues int [default: 0]
  
  // Overall verdict
  is_valid boolean [default: null]
  
  // Timing
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    event_log_id
    (event_log_id, status)
  }
  
  Note: 'Event log validation results'
}

Table validation_issues {
  id uuid [pk, default: `gen_random_uuid()`]
  validation_result_id uuid [ref: > validation_results.id, not null]
  rule_id uuid [ref: > validation_rules.id, default: null]
  
  issue_type validation_issue_type [not null]
  severity validation_severity [not null]
  
  // Location
  case_id varchar(255) [default: null]
  event_index int [default: null]
  column_name varchar(255) [default: null]
  row_number bigint [default: null]
  
  // Issue Details
  message text [not null]
  details jsonb [default: null]
  
  // Fix
  is_fixable boolean [default: false]
  was_fixed boolean [default: false]
  fix_applied text [default: null]
  
  indexes {
    (validation_result_id, severity)
    (validation_result_id, issue_type)
  }
  
  Note: 'Individual validation issues'
}

// ============================================================================
// L3-242: FILTERING SUBSYSTEM (pm4py.filtering)
// ============================================================================

Table saved_filters {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  name varchar(255) [not null]
  description text [default: null]
  
  // Scope
  event_log_id uuid [ref: > event_logs.id, default: null, note: 'null = reusable across logs']
  process_id uuid [ref: > processes.id, default: null]
  
  // Filter Definition
  filter_type filter_type [not null]
  filter_config jsonb [not null]
  
  // PM4Py Filter Function Mapping
  pm4py_function varchar(100) [default: null, note: 'e.g., filter_start_activities']
  
  // Usage
  use_count int [default: 0]
  last_used_at timestamp [default: null]
  
  // Sharing
  is_shared boolean [default: false]
  shared_with_teams uuid[] [default: '{}']
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id)
    (org_id, filter_type)
    (event_log_id)
    (process_id)
  }
  
  Note: 'Saved filter configurations (pm4py.filtering)'
}

Table filter_presets {
  id uuid [pk, default: `gen_random_uuid()`]
  
  name varchar(255) [not null]
  description text [default: null]
  category varchar(100) [default: null]
  
  filter_type filter_type [not null]
  filter_config jsonb [not null]
  pm4py_function varchar(100) [not null]
  
  // Documentation
  example_use_case text [default: null]
  
  is_system boolean [default: true]
  display_order int [default: 0]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (filter_type)
    (category)
  }
  
  Note: 'System-defined filter presets'
}

Table filtered_event_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  
  source_event_log_id uuid [ref: > event_logs.id, not null]
  result_event_log_id uuid [ref: > event_logs.id, not null]
  
  // Filter applied
  saved_filter_id uuid [ref: > saved_filters.id, default: null]
  filter_config jsonb [not null]
  
  // Statistics
  original_events bigint [not null]
  filtered_events bigint [not null]
  events_removed bigint [not null]
  event_removal_rate float [not null]
  
  original_cases bigint [not null]
  filtered_cases bigint [not null]
  cases_removed bigint [not null]
  case_removal_rate float [not null]
  
  // Execution
  filter_duration_ms int [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    source_event_log_id
    result_event_log_id
    saved_filter_id
  }
  
  Note: 'Filtered event log derivations'
}

// ============================================================================
// L3-243: PRIVACY SUBSYSTEM (pm4py.privacy)
// ============================================================================

Table privacy_configs {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  name varchar(255) [not null]
  description text [default: null]
  
  algorithm privacy_algorithm [not null]
  
  // Common Parameters
  epsilon float [default: 1.0, note: 'Differential privacy epsilon']
  
  // SaCoFa Parameters
  sacofa_k int [default: null, note: 'Sequence length parameter']
  
  // PRIPEL Parameters
  pripel_n int [default: null, note: 'Number of synthetic traces']
  
  // Column Selection
  sensitive_columns text[] [default: '{}']
  anonymize_case_ids boolean [default: true]
  anonymize_resources boolean [default: true]
  
  // Additional Config
  additional_params jsonb [default: '{}']
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (org_id, algorithm)
  }
  
  Note: 'Privacy configuration templates (pm4py.privacy)'
}

Table privacy_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  source_event_log_id uuid [ref: > event_logs.id, not null]
  config_id uuid [ref: > privacy_configs.id, default: null]
  
  status job_status [default: 'PENDING']
  
  // Algorithm (can override config)
  algorithm privacy_algorithm [not null]
  params jsonb [default: '{}']
  
  // Result
  result_event_log_id uuid [ref: > event_logs.id, default: null]
  
  // Statistics
  original_cases bigint [default: null]
  anonymized_cases bigint [default: null]
  original_variants int [default: null]
  anonymized_variants int [default: null]
  original_activities int [default: null]
  anonymized_activities int [default: null]
  
  // Privacy Metrics
  information_loss float [default: null]
  utility_score float [default: null]
  
  // Execution
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  error_message text [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (org_id, status)
    source_event_log_id
    result_event_log_id
  }
  
  Note: 'Privacy processing jobs'
}

Table anonymization_mappings {
  id uuid [pk, default: `gen_random_uuid()`]
  privacy_job_id uuid [ref: > privacy_jobs.id, not null]
  
  // Mapping type
  mapping_type anonymization_mapping_type [not null]
  
  // Original → Anonymized (encrypted storage)
  mappings_encrypted text [not null]
  
  // Statistics
  unique_values_count int [not null]
  
  // For auditing (time-limited)
  expires_at timestamp [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    privacy_job_id
    (privacy_job_id, mapping_type)
  }
  
  Note: 'Anonymization mappings (encrypted, for potential reversal)'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum validation_rule_type {
  SCHEMA [note: 'Schema validation']
  COMPLETENESS [note: 'Missing values']
  CONSISTENCY [note: 'Data consistency']
  TIMESTAMP [note: 'Timestamp validity']
  ACTIVITY [note: 'Activity validation']
  CASE [note: 'Case structure']
  CUSTOM [note: 'Custom rule']
}

Enum validation_severity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

Enum fail_action {
  IGNORE [note: 'Log and continue']
  WARN [note: 'Warn user']
  REJECT [note: 'Reject upload']
  FIX [note: 'Auto-fix if possible']
}

Enum validation_status {
  PENDING
  RUNNING
  PASSED
  FAILED
  WARNING
}

Enum validation_issue_type {
  MISSING_VALUE [note: 'Required value missing']
  INVALID_FORMAT [note: 'Wrong data format']
  INVALID_TIMESTAMP [note: 'Invalid timestamp']
  DUPLICATE [note: 'Duplicate entry']
  ORPHAN [note: 'Orphan record']
  OUT_OF_RANGE [note: 'Value out of range']
  INCONSISTENT [note: 'Inconsistent data']
  ENCODING [note: 'Encoding issue']
}

Enum filter_type {
  // Activity filters
  START_ACTIVITIES [note: 'Filter by start activities']
  END_ACTIVITIES [note: 'Filter by end activities']
  ACTIVITIES [note: 'Filter by activities (keep/remove)']
  ACTIVITY_FREQUENCY [note: 'Filter by activity frequency']
  
  // Time filters
  TIMEFRAME [note: 'Filter by time range']
  TIMESTAMP [note: 'Filter by timestamp condition']
  CASE_PERFORMANCE [note: 'Filter by case duration']
  
  // Case filters
  CASE_SIZE [note: 'Filter by number of events']
  VARIANTS [note: 'Filter by variants']
  VARIANT_TOP_K [note: 'Keep top K variants']
  
  // Path filters
  PATHS [note: 'Filter by activity paths']
  EVENTUALLY_FOLLOWS [note: 'Eventually follows filter']
  DIRECTLY_FOLLOWS [note: 'Directly follows filter']
  
  // Resource filters
  RESOURCE [note: 'Filter by resource']
  
  // Attribute filters
  ATTRIBUTE [note: 'Generic attribute filter']
  
  // Special filters
  FOUR_EYES_PRINCIPLE [note: 'Four-eyes principle']
  REWORK [note: 'Filter cases with rework']
  PREFIX [note: 'Prefix filter']
  SUFFIX [note: 'Suffix filter']
  BETWEEN [note: 'Between activities filter']
}

Enum anonymization_mapping_type {
  CASE_ID [note: 'Case ID mapping']
  RESOURCE [note: 'Resource mapping']
  ACTIVITY [note: 'Activity mapping']
  ATTRIBUTE [note: 'Attribute mapping']
}
-e 


// ============================================================================
// L2-310: PROCESS DISCOVERY SYSTEM (PDS)
// File: L1-300_processing_segment/L2-310_discovery.dbml
// Segment: L1-300 Processing Segment
// ============================================================================
// Subsystems:
//   L3-311: Procedural Discovery (Alpha, Heuristics, Inductive, ILP)
//   L3-312: Declarative Discovery (DECLARE, Log Skeleton)
//   L3-313: DFG Discovery
//   L3-314: Advanced Discovery (POWL, Temporal Profile)
// ============================================================================
// PM4Py Modules: pm4py.discovery (all 10+ algorithms)
// ============================================================================
// Interfaces:
//   IF-002: Receives event logs from ELMS (L2-210)
//   IF-004: Provides models to PMS (L2-320)
// ============================================================================

// ============================================================================
// L3-311: PROCEDURAL DISCOVERY SUBSYSTEM
// ============================================================================

Table discovery_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  process_id uuid [ref: > processes.id, default: null]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  // Job Identity
  name varchar(255) [default: null]
  
  status job_status [default: 'PENDING']
  priority job_priority [default: 'NORMAL']
  
  // Algorithm Configuration
  algorithm discovery_algorithm [not null]
  output_model_type model_type [not null]
  
  // Algorithm Parameters (varies by algorithm)
  params jsonb [default: '{}']
  
  // Common Parameters
  noise_threshold float [default: 0.0, note: 'For infrequent behavior filtering']
  dependency_threshold float [default: 0.5, note: 'For heuristics miner']
  
  // Result
  result_model_id uuid [default: null, note: 'FK to process_models']
  
  // Quality Metrics (post-discovery)
  fitness float [default: null]
  precision float [default: null]
  generalization float [default: null]
  simplicity float [default: null]
  
  // Execution
  queued_at timestamp [default: null]
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  // Resource Usage
  memory_peak_mb int [default: null]
  cpu_time_ms int [default: null]
  
  // Error
  error_message text [default: null]
  error_stack text [default: null]
  retry_count int [default: 0]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (org_id, status)
    (process_id)
    (event_log_id)
    (algorithm)
    created_at
  }
  
  Note: 'Process discovery job queue and history'
}

Table discovery_templates {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, default: null, note: 'null = system template']
  
  name varchar(255) [not null]
  description text [default: null]
  
  algorithm discovery_algorithm [not null]
  output_model_type model_type [not null]
  params jsonb [not null]
  
  // Recommended use cases
  recommended_for text [default: null]
  
  is_default boolean [default: false]
  is_system boolean [default: false]
  
  created_by uuid [ref: > users.id, default: null]
  created_at timestamp [default: `now()`]
  
  indexes {
    (org_id, algorithm)
    (org_id, is_default)
  }
  
  Note: 'Reusable discovery configurations'
}

// ============================================================================
// L3-312: DECLARATIVE DISCOVERY SUBSYSTEM (DECLARE, Log Skeleton)
// ============================================================================

Table declare_models {
  id uuid [pk, default: `gen_random_uuid()`]
  process_id uuid [ref: > processes.id, not null]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  name varchar(255) [not null]
  description text [default: null]
  status model_status [default: 'DRAFT']
  
  // Discovery Parameters
  support_threshold float [default: 0.8]
  confidence_threshold float [default: 0.8]
  
  // Statistics
  constraint_count int [default: 0]
  activity_count int [default: 0]
  
  // Discovery
  discovered_at timestamp [default: null]
  discovery_duration_ms int [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (process_id)
    (event_log_id)
  }
  
  Note: 'DECLARE declarative process models (pm4py.discovery.declare)'
}

Table declare_constraints {
  id uuid [pk, default: `gen_random_uuid()`]
  declare_model_id uuid [ref: > declare_models.id, not null]
  
  // Constraint Definition
  constraint_type declare_constraint_type [not null]
  
  // Activities (A → B patterns)
  activity_a varchar(255) [not null]
  activity_b varchar(255) [default: null, note: 'For binary constraints']
  
  // For cardinality constraints (EXACTLY, EXISTENCE, ABSENCE)
  cardinality int [default: null]
  
  // Discovered Metrics
  support float [default: null, note: 'Frequency of pattern']
  confidence float [default: null, note: 'Reliability of pattern']
  
  // State
  is_active boolean [default: true]
  is_user_defined boolean [default: false]
  
  // Violation tracking
  last_violation_count int [default: 0]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (declare_model_id, constraint_type)
    (declare_model_id, activity_a)
    (declare_model_id, is_active)
  }
  
  Note: 'Individual DECLARE constraints'
}

Table log_skeletons {
  id uuid [pk, default: `gen_random_uuid()`]
  process_id uuid [ref: > processes.id, not null]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  name varchar(255) [not null]
  description text [default: null]
  status model_status [default: 'DRAFT']
  
  // Discovery Parameters
  noise_threshold float [default: 0.0]
  
  // Log Skeleton Relations (pm4py.discovery.log_skeleton)
  // Stored as adjacency sets
  equivalence jsonb [default: '{}', note: 'activity → equivalent activities']
  always_after jsonb [default: '{}', note: 'activity → always-after activities']
  always_before jsonb [default: '{}', note: 'activity → always-before activities']
  never_together jsonb [default: '{}', note: 'activity → never-with activities']
  directly_follows jsonb [default: '{}', note: 'activity → directly-follows activities']
  
  // Activity Frequencies
  activ_freq jsonb [default: '{}', note: 'activity → {min, max} occurrences']
  
  // Statistics
  activity_count int [default: 0]
  relation_count int [default: 0]
  
  discovered_at timestamp [default: null]
  discovery_duration_ms int [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (process_id)
    (event_log_id)
  }
  
  Note: 'Log skeleton models (pm4py.discovery.log_skeleton)'
}

// ============================================================================
// L3-313: DFG DISCOVERY SUBSYSTEM
// ============================================================================

Table dfg_discovery_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  discovery_job_id uuid [ref: > discovery_jobs.id, not null]
  
  // DFG Type
  is_performance_dfg boolean [default: false]
  
  // Filtering
  activity_threshold float [default: 0.0]
  edge_threshold float [default: 0.0]
  
  // Result
  dfg_model_id uuid [default: null, note: 'FK to dfg_models in PMS']
  
  indexes {
    discovery_job_id
  }
  
  Note: 'DFG-specific discovery parameters'
}

// ============================================================================
// L3-314: ADVANCED DISCOVERY SUBSYSTEM (POWL, Temporal Profile, etc.)
// ============================================================================

Table temporal_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  process_id uuid [ref: > processes.id, not null]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  name varchar(255) [not null]
  status model_status [default: 'DRAFT']
  
  // Statistics
  transition_count int [default: 0]
  activity_count int [default: 0]
  
  discovered_at timestamp [default: null]
  discovery_duration_ms int [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (process_id)
    (event_log_id)
  }
  
  Note: 'Temporal profiles (pm4py.discovery.temporal_profile)'
}

Table temporal_profile_entries {
  id uuid [pk, default: `gen_random_uuid()`]
  temporal_profile_id uuid [ref: > temporal_profiles.id, not null]
  
  source_activity varchar(255) [not null]
  target_activity varchar(255) [not null]
  
  // Temporal Statistics
  avg_duration_seconds float [not null]
  stdev_duration_seconds float [not null]
  min_duration_seconds float [default: null]
  max_duration_seconds float [default: null]
  
  // Frequency
  occurrence_count bigint [default: 0]
  
  indexes {
    (temporal_profile_id, source_activity, target_activity) [unique]
  }
  
  Note: 'Temporal profile transitions'
}

Table batch_detections {
  id uuid [pk, default: `gen_random_uuid()`]
  event_log_id uuid [ref: > event_logs.id, not null]
  process_id uuid [ref: > processes.id, default: null]
  
  // Batch Definition
  activity varchar(255) [not null]
  resource varchar(255) [default: null]
  
  batch_type batch_type [not null]
  
  // Batch Statistics (pm4py.discovery.batches)
  batch_count int [default: 0]
  avg_batch_size float [default: null]
  max_batch_size int [default: null]
  min_batch_size int [default: null]
  
  // Timing
  avg_batch_duration_seconds float [default: null]
  
  detected_at timestamp [default: `now()`]
  
  indexes {
    (event_log_id, activity)
    (event_log_id, resource)
  }
  
  Note: 'Batch behavior detection (pm4py.discovery.batches)'
}

Table transition_systems {
  id uuid [pk, default: `gen_random_uuid()`]
  process_id uuid [ref: > processes.id, not null]
  event_log_id uuid [ref: > event_logs.id, not null]
  model_id uuid [ref: > process_models.id, not null]
  
  name varchar(255) [not null]
  
  // Configuration
  direction ts_direction [default: 'FORWARD']
  window_size int [default: 2]
  
  // Statistics
  state_count int [default: 0]
  transition_count int [default: 0]
  
  discovered_at timestamp [default: `now()`]
  
  indexes {
    (process_id)
    (event_log_id)
  }
  
  Note: 'Transition system models (pm4py.discovery.transition_system)'
}

Table prefix_trees {
  id uuid [pk, default: `gen_random_uuid()`]
  process_id uuid [ref: > processes.id, not null]
  event_log_id uuid [ref: > event_logs.id, not null]
  model_id uuid [ref: > process_models.id, not null]
  
  name varchar(255) [not null]
  
  // Statistics
  node_count int [default: 0]
  edge_count int [default: 0]
  max_depth int [default: 0]
  
  discovered_at timestamp [default: `now()`]
  
  indexes {
    (process_id)
    (event_log_id)
  }
  
  Note: 'Prefix tree models (pm4py.discovery.prefix_tree)'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum job_priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

Enum ts_direction {
  FORWARD [note: 'Future-looking states']
  BACKWARD [note: 'Past-looking states']
  BOTH [note: 'Bidirectional']
}
-e 


// ============================================================================
// L2-320: PROCESS MODEL SYSTEM (PMS)
// File: L1-300_processing_segment/L2-320_process_models.dbml
// Segment: L1-300 Processing Segment
// ============================================================================
// Subsystems:
//   L3-321: Petri Net Subsystem
//   L3-322: BPMN Subsystem
//   L3-323: Process Tree Subsystem
//   L3-324: POWL Subsystem
//   L3-325: DFG Model Subsystem
// ============================================================================
// PM4Py Modules: pm4py.objects, pm4py.convert
// ============================================================================

// ============================================================================
// CORE PROCESS & MODEL TABLES
// ============================================================================

Table processes {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  project_id uuid [ref: > projects.id, default: null]
  
  // Identity
  name varchar(255) [not null]
  description text [default: null]
  code varchar(50) [default: null, note: 'Short identifier']
  
  // Classification
  category varchar(100) [default: null]
  tags text[] [default: '{}']
  
  // Status
  status process_status [default: 'DRAFT']
  type process_type [default: 'DISCOVERED']
  
  // Primary Data Sources
  primary_event_log_id uuid [ref: > event_logs.id, default: null]
  
  // Current Published Model
  published_model_id uuid [default: null]
  published_at timestamp [default: null]
  
  // Aggregated Metrics (denormalized)
  current_metrics jsonb [default: '{}']
  
  // Ownership
  owner_id uuid [ref: > users.id, default: null]
  owner_team_id uuid [ref: > teams.id, default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  archived_at timestamp [default: null]
  
  indexes {
    (org_id, status)
    (org_id, category)
    (project_id)
    (primary_event_log_id)
  }
  
  Note: 'Business processes being analyzed'
}

Table process_models {
  id uuid [pk, default: `gen_random_uuid()`]
  process_id uuid [ref: > processes.id, not null]
  event_log_id uuid [ref: > event_logs.id, default: null]
  
  // Identity
  name varchar(255) [not null]
  description text [default: null]
  version varchar(20) [default: '1.0.0']
  
  status model_status [default: 'DRAFT']
  
  // Model Type
  model_type model_type [not null]
  model_format model_format [not null]
  
  // Discovery Information
  discovery_job_id uuid [ref: > discovery_jobs.id, default: null]
  discovery_algorithm discovery_algorithm [default: null]
  discovery_params jsonb [default: '{}']
  discovered_at timestamp [default: null]
  
  // Serialized Model Data
  model_data text [default: null, note: 'PNML, BPMN XML, PTML, etc.']
  model_data_format varchar(50) [default: null]
  
  // Visual Representation
  svg_content text [default: null]
  layout_data jsonb [default: '{}', note: 'Node positions']
  
  // Model Statistics
  node_count int [default: 0]
  edge_count int [default: 0]
  activity_count int [default: 0]
  gateway_count int [default: 0]
  
  // Quality Metrics
  fitness float [default: null]
  precision float [default: null]
  generalization float [default: null]
  simplicity float [default: null]
  f_measure float [default: null]
  
  // Soundness (pm4py.analysis.check_soundness)
  is_sound boolean [default: null]
  soundness_checked_at timestamp [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (process_id, status)
    (process_id, model_type)
    (event_log_id)
    (discovery_job_id)
  }
  
  Note: 'Process models in various representations'
}

// ============================================================================
// L3-321: PETRI NET SUBSYSTEM (pm4py.objects.petri_net)
// ============================================================================

Table petri_net_places {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [ref: > process_models.id, not null]
  
  // Identity
  name varchar(255) [not null]
  label varchar(255) [default: null]
  
  // Type
  is_source boolean [default: false]
  is_sink boolean [default: false]
  
  // Initial/Final Marking
  initial_tokens int [default: 0]
  
  // Layout
  position_x float [default: null]
  position_y float [default: null]
  
  indexes {
    (model_id, name) [unique]
    (model_id, is_source)
    (model_id, is_sink)
  }
  
  Note: 'Places in Petri net models'
}

Table petri_net_transitions {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [ref: > process_models.id, not null]
  
  // Identity
  name varchar(255) [not null]
  label varchar(255) [default: null, note: 'null = invisible/tau transition']
  
  // Type
  is_silent boolean [default: false]
  
  // Stochastic Information
  weight float [default: 1.0]
  
  // Performance (from event log)
  avg_duration_seconds float [default: null]
  frequency bigint [default: null]
  
  // Layout
  position_x float [default: null]
  position_y float [default: null]
  
  indexes {
    (model_id, name) [unique]
    (model_id, is_silent)
  }
  
  Note: 'Transitions in Petri net models'
}

Table petri_net_arcs {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [ref: > process_models.id, not null]
  
  arc_type arc_type [not null]
  
  // Source/Target (one pair filled based on arc_type)
  source_place_id uuid [ref: > petri_net_places.id, default: null]
  source_transition_id uuid [ref: > petri_net_transitions.id, default: null]
  target_place_id uuid [ref: > petri_net_places.id, default: null]
  target_transition_id uuid [ref: > petri_net_transitions.id, default: null]
  
  weight int [default: 1]
  
  // Performance
  frequency bigint [default: null]
  
  indexes {
    model_id
  }
  
  Note: 'Arcs connecting places and transitions'
}

// ============================================================================
// L3-322: BPMN SUBSYSTEM
// ============================================================================

Table bpmn_elements {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [ref: > process_models.id, not null]
  
  // BPMN Identity
  bpmn_id varchar(255) [not null]
  element_type bpmn_element_type [not null]
  name varchar(255) [default: null]
  
  // For gateways
  gateway_direction gateway_direction [default: null]
  
  // For tasks
  task_type bpmn_task_type [default: null]
  
  // Documentation
  documentation text [default: null]
  
  // Layout
  position_x float [default: null]
  position_y float [default: null]
  width float [default: null]
  height float [default: null]
  
  // Container
  parent_id uuid [ref: > bpmn_elements.id, default: null]
  lane_id uuid [ref: > bpmn_elements.id, default: null]
  
  // Performance Overlay
  frequency bigint [default: null]
  avg_duration_seconds float [default: null]
  
  indexes {
    (model_id, bpmn_id) [unique]
    (model_id, element_type)
    parent_id
  }
  
  Note: 'BPMN diagram elements'
}

Table bpmn_flows {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [ref: > process_models.id, not null]
  
  bpmn_id varchar(255) [not null]
  flow_type bpmn_flow_type [not null]
  
  source_element_id uuid [ref: > bpmn_elements.id, not null]
  target_element_id uuid [ref: > bpmn_elements.id, not null]
  
  name varchar(255) [default: null]
  condition_expression text [default: null]
  
  // Waypoints
  waypoints jsonb [default: '[]']
  
  // Performance
  frequency bigint [default: null]
  avg_duration_seconds float [default: null]
  
  indexes {
    (model_id, bpmn_id) [unique]
    source_element_id
    target_element_id
  }
  
  Note: 'BPMN flows between elements'
}

// ============================================================================
// L3-323: PROCESS TREE SUBSYSTEM (pm4py.objects.process_tree)
// ============================================================================

Table process_tree_nodes {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [ref: > process_models.id, not null]
  parent_id uuid [ref: > process_tree_nodes.id, default: null]
  
  // Node Type
  node_type process_tree_operator [not null]
  
  // For leaf nodes
  label varchar(255) [default: null]
  
  // Ordering
  child_order int [default: 0]
  
  // Tree Position
  depth int [default: 0]
  subtree_size int [default: 1]
  
  // Layout
  position_x float [default: null]
  position_y float [default: null]
  
  indexes {
    (model_id, parent_id, child_order)
    (model_id, node_type)
    (model_id, depth)
  }
  
  Note: 'Process tree nodes (operators and leaves)'
}

// ============================================================================
// L3-324: POWL SUBSYSTEM (pm4py.objects.powl)
// ============================================================================

Table powl_nodes {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [ref: > process_models.id, not null]
  
  node_type powl_node_type [not null]
  label varchar(255) [default: null]
  
  // For operator nodes
  operator powl_operator [default: null]
  
  // For loop nodes
  min_iterations int [default: null]
  max_iterations int [default: null]
  
  // Layout
  position_x float [default: null]
  position_y float [default: null]
  
  indexes {
    model_id
    (model_id, node_type)
  }
  
  Note: 'POWL (Partially Ordered Workflow Language) nodes'
}

Table powl_edges {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [ref: > process_models.id, not null]
  
  source_node_id uuid [ref: > powl_nodes.id, not null]
  target_node_id uuid [ref: > powl_nodes.id, not null]
  
  // For partial order edges
  order_index int [default: 0]
  
  indexes {
    model_id
    (source_node_id, target_node_id)
  }
  
  Note: 'POWL edges'
}

// ============================================================================
// L3-325: DFG MODEL SUBSYSTEM
// ============================================================================

Table dfg_models {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [ref: > process_models.id, not null, unique]
  
  // DFG Type
  is_performance_dfg boolean [default: false]
  
  // Start/End Activities
  start_activities jsonb [default: '{}', note: 'activity → count']
  end_activities jsonb [default: '{}', note: 'activity → count']
  
  // Statistics
  activity_count int [default: 0]
  edge_count int [default: 0]
  
  indexes {
    model_id [unique]
  }
  
  Note: 'Directly-Follows Graph metadata'
}

Table dfg_activities {
  id uuid [pk, default: `gen_random_uuid()`]
  dfg_model_id uuid [ref: > dfg_models.id, not null]
  
  activity varchar(255) [not null]
  
  frequency bigint [default: 0]
  
  // Performance
  avg_duration_seconds float [default: null]
  
  // Layout
  position_x float [default: null]
  position_y float [default: null]
  
  indexes {
    (dfg_model_id, activity) [unique]
  }
  
  Note: 'DFG activity nodes'
}

Table dfg_edges {
  id uuid [pk, default: `gen_random_uuid()`]
  dfg_model_id uuid [ref: > dfg_models.id, not null]
  
  source_activity varchar(255) [not null]
  target_activity varchar(255) [not null]
  
  // Frequency
  frequency bigint [default: 0]
  
  // Performance (for Performance DFG)
  avg_duration_seconds float [default: null]
  min_duration_seconds float [default: null]
  max_duration_seconds float [default: null]
  median_duration_seconds float [default: null]
  stdev_duration_seconds float [default: null]
  
  indexes {
    (dfg_model_id, source_activity, target_activity) [unique]
    dfg_model_id
  }
  
  Note: 'DFG edges with frequency and performance'
}

// ============================================================================
// MODEL CONVERSION TRACKING
// ============================================================================

Table model_conversions {
  id uuid [pk, default: `gen_random_uuid()`]
  
  source_model_id uuid [ref: > process_models.id, not null]
  target_model_id uuid [ref: > process_models.id, not null]
  
  source_type model_type [not null]
  target_type model_type [not null]
  
  // Conversion Info
  conversion_algorithm varchar(100) [default: null]
  conversion_params jsonb [default: '{}']
  
  // Quality
  is_lossless boolean [default: null]
  conversion_notes text [default: null]
  
  converted_at timestamp [default: `now()`]
  converted_by uuid [ref: > users.id]
  
  indexes {
    source_model_id
    target_model_id
    (source_type, target_type)
  }
  
  Note: 'Model conversion history (pm4py.convert)'
}
-e 


// ============================================================================
// L2-330: CONFORMANCE CHECKING SYSTEM (CCS)
// File: L1-300_processing_segment/L2-330_conformance.dbml
// Segment: L1-300 Processing Segment
// ============================================================================
// Subsystems:
//   L3-331: Token Replay Subsystem
//   L3-332: Alignment Subsystem
//   L3-333: Declarative Conformance Subsystem
//   L3-334: Temporal Conformance Subsystem
//   L3-335: Footprint Subsystem
// ============================================================================
// PM4Py Modules: pm4py.conformance
// ============================================================================

// ============================================================================
// CORE CONFORMANCE TABLES
// ============================================================================

Table conformance_checks {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  process_id uuid [ref: > processes.id, not null]
  event_log_id uuid [ref: > event_logs.id, not null]
  model_id uuid [ref: > process_models.id, default: null]
  
  // Check Identity
  name varchar(255) [default: null]
  
  status job_status [default: 'PENDING']
  priority job_priority [default: 'NORMAL']
  
  // Conformance Type
  conformance_type conformance_type [not null]
  params jsonb [default: '{}']
  
  // Aggregate Results
  fitness float [default: null]
  precision float [default: null]
  generalization float [default: null]
  f_measure float [default: null]
  
  // Case Statistics
  total_cases bigint [default: 0]
  fitting_cases bigint [default: 0]
  non_fitting_cases bigint [default: 0]
  fitness_rate float [default: null]
  
  // Deviation Statistics
  total_deviations bigint [default: 0]
  avg_deviations_per_case float [default: null]
  
  // Execution
  queued_at timestamp [default: null]
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  // Resources
  memory_peak_mb int [default: null]
  
  // Error
  error_message text [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (org_id, process_id)
    (org_id, status)
    (model_id)
    (event_log_id)
    created_at
  }
  
  Note: 'Conformance checking jobs and results'
}

// ============================================================================
// L3-331: TOKEN REPLAY SUBSYSTEM (pm4py.conformance.token_replay)
// ============================================================================

Table token_replay_results {
  id uuid [pk, default: `gen_random_uuid()`]
  conformance_check_id uuid [ref: > conformance_checks.id, not null, unique]
  
  // Aggregate Token Statistics
  total_produced_tokens bigint [default: 0]
  total_consumed_tokens bigint [default: 0]
  total_missing_tokens bigint [default: 0]
  total_remaining_tokens bigint [default: 0]
  
  // Averages
  avg_produced_tokens float [default: null]
  avg_consumed_tokens float [default: null]
  avg_missing_tokens float [default: null]
  avg_remaining_tokens float [default: null]
  
  // Fitness Calculation
  fitness_formula varchar(50) [default: 'token_based']
  
  indexes {
    conformance_check_id [unique]
  }
  
  Note: 'Token replay aggregate results'
}

Table token_replay_case_results {
  id uuid [pk, default: `gen_random_uuid()`]
  conformance_check_id uuid [ref: > conformance_checks.id, not null]
  case_id varchar(255) [not null]
  
  // Fitness
  is_fit boolean [not null]
  trace_fitness float [not null]
  
  // Token Counts
  produced_tokens int [default: 0]
  consumed_tokens int [default: 0]
  missing_tokens int [default: 0]
  remaining_tokens int [default: 0]
  
  // Missing Token Details
  missing_token_places jsonb [default: '[]', note: 'Places where tokens were missing']
  
  // Remaining Token Details
  remaining_token_places jsonb [default: '[]', note: 'Places with remaining tokens']
  
  // Activated Transitions
  activated_transitions text[] [default: '{}']
  
  indexes {
    (conformance_check_id, case_id) [unique]
    (conformance_check_id, is_fit)
    (conformance_check_id, trace_fitness)
  }
  
  Note: 'Token replay per-case results'
}

// ============================================================================
// L3-332: ALIGNMENT SUBSYSTEM (pm4py.conformance.alignments)
// ============================================================================

Table alignment_results {
  id uuid [pk, default: `gen_random_uuid()`]
  conformance_check_id uuid [ref: > conformance_checks.id, not null, unique]
  
  // Aggregate Move Statistics
  total_sync_moves bigint [default: 0]
  total_log_moves bigint [default: 0]
  total_model_moves bigint [default: 0]
  
  // Averages
  avg_alignment_cost float [default: null]
  avg_sync_moves float [default: null]
  avg_log_moves float [default: null]
  avg_model_moves float [default: null]
  
  // Cost Configuration
  sync_cost float [default: 0]
  log_move_cost float [default: 1]
  model_move_cost float [default: 1]
  
  // Algorithm Used
  algorithm alignment_algorithm [default: 'A_STAR']
  
  indexes {
    conformance_check_id [unique]
  }
  
  Note: 'Alignment aggregate results'
}

Table alignment_case_results {
  id uuid [pk, default: `gen_random_uuid()`]
  conformance_check_id uuid [ref: > conformance_checks.id, not null]
  case_id varchar(255) [not null]
  
  // Fitness
  is_fit boolean [not null]
  trace_fitness float [not null]
  
  // Alignment Cost
  alignment_cost float [not null]
  
  // Move Counts
  sync_moves int [default: 0]
  log_moves int [default: 0]
  model_moves int [default: 0]
  total_moves int [default: 0]
  
  // Full Alignment Sequence
  alignment jsonb [not null, note: 'Array of (log_move, model_move) tuples']
  
  // Computation
  computation_time_ms int [default: null]
  states_visited int [default: null]
  
  indexes {
    (conformance_check_id, case_id) [unique]
    (conformance_check_id, is_fit)
    (conformance_check_id, alignment_cost)
  }
  
  Note: 'Alignment per-case results'
}

Table alignment_deviations {
  id uuid [pk, default: `gen_random_uuid()`]
  case_result_id uuid [ref: > alignment_case_results.id, not null]
  
  // Deviation Position
  position int [not null]
  
  // Deviation Type
  deviation_type deviation_type [not null]
  
  // For Log Moves (activity in log but not model)
  log_activity varchar(255) [default: null]
  
  // For Model Moves (activity in model but not log)
  model_transition varchar(255) [default: null]
  
  // Context
  preceding_activity varchar(255) [default: null]
  following_activity varchar(255) [default: null]
  
  indexes {
    (case_result_id, position)
    (case_result_id, deviation_type)
  }
  
  Note: 'Individual alignment deviations'
}

// ============================================================================
// L3-333: DECLARATIVE CONFORMANCE SUBSYSTEM
// ============================================================================

Table declare_conformance_results {
  id uuid [pk, default: `gen_random_uuid()`]
  conformance_check_id uuid [ref: > conformance_checks.id, not null]
  declare_model_id uuid [ref: > declare_models.id, not null]
  
  // Aggregate Results
  overall_fitness float [default: null]
  constraints_checked int [default: 0]
  constraints_satisfied int [default: 0]
  constraints_violated int [default: 0]
  
  // Case Statistics
  fully_compliant_cases bigint [default: 0]
  partially_compliant_cases bigint [default: 0]
  non_compliant_cases bigint [default: 0]
  
  indexes {
    (conformance_check_id, declare_model_id)
  }
  
  Note: 'DECLARE conformance aggregate results'
}

Table declare_constraint_results {
  id uuid [pk, default: `gen_random_uuid()`]
  declare_conformance_id uuid [ref: > declare_conformance_results.id, not null]
  constraint_id uuid [ref: > declare_constraints.id, not null]
  
  // Constraint Statistics
  satisfaction_rate float [default: null]
  cases_satisfying bigint [default: 0]
  cases_violating bigint [default: 0]
  total_violations bigint [default: 0]
  
  indexes {
    (declare_conformance_id, constraint_id)
  }
  
  Note: 'Per-constraint conformance results'
}

Table declare_case_violations {
  id uuid [pk, default: `gen_random_uuid()`]
  declare_conformance_id uuid [ref: > declare_conformance_results.id, not null]
  constraint_id uuid [ref: > declare_constraints.id, not null]
  case_id varchar(255) [not null]
  
  // Violation Details
  is_violated boolean [not null]
  violation_count int [default: 0]
  
  // Violation Context
  violation_details jsonb [default: null]
  first_violation_position int [default: null]
  
  indexes {
    (declare_conformance_id, case_id)
    (declare_conformance_id, constraint_id, is_violated)
  }
  
  Note: 'Per-case DECLARE violations'
}

// Log Skeleton Conformance (pm4py.conformance.log_skeleton)
Table log_skeleton_conformance_results {
  id uuid [pk, default: `gen_random_uuid()`]
  conformance_check_id uuid [ref: > conformance_checks.id, not null]
  log_skeleton_id uuid [ref: > log_skeletons.id, not null]
  
  // Aggregate Results
  overall_fitness float [default: null]
  deviations_count bigint [default: 0]
  
  // By Relation Type
  equivalence_violations bigint [default: 0]
  always_after_violations bigint [default: 0]
  always_before_violations bigint [default: 0]
  never_together_violations bigint [default: 0]
  directly_follows_violations bigint [default: 0]
  activity_freq_violations bigint [default: 0]
  
  indexes {
    (conformance_check_id, log_skeleton_id)
  }
  
  Note: 'Log skeleton conformance results'
}

// ============================================================================
// L3-334: TEMPORAL CONFORMANCE SUBSYSTEM
// ============================================================================

Table temporal_conformance_results {
  id uuid [pk, default: `gen_random_uuid()`]
  conformance_check_id uuid [ref: > conformance_checks.id, not null]
  temporal_profile_id uuid [ref: > temporal_profiles.id, not null]
  
  // Configuration
  z_score_threshold float [default: 2.0]
  
  // Aggregate Results
  total_transitions_checked bigint [default: 0]
  total_deviations bigint [default: 0]
  deviation_rate float [default: null]
  
  // Cases
  cases_with_deviations bigint [default: 0]
  
  indexes {
    (conformance_check_id, temporal_profile_id)
  }
  
  Note: 'Temporal profile conformance results'
}

Table temporal_deviations {
  id uuid [pk, default: `gen_random_uuid()`]
  temporal_conformance_id uuid [ref: > temporal_conformance_results.id, not null]
  case_id varchar(255) [not null]
  
  source_activity varchar(255) [not null]
  target_activity varchar(255) [not null]
  
  // Actual vs Expected
  actual_duration_seconds float [not null]
  expected_avg_seconds float [not null]
  expected_stdev_seconds float [not null]
  
  // Deviation
  z_score float [not null]
  deviation_direction deviation_direction [not null]
  
  // Position in Trace
  event_position int [default: null]
  
  indexes {
    (temporal_conformance_id, case_id)
    (temporal_conformance_id, source_activity, target_activity)
    (temporal_conformance_id, z_score)
  }
  
  Note: 'Individual temporal deviations'
}

// ============================================================================
// L3-335: FOOTPRINT SUBSYSTEM (pm4py.conformance.footprints)
// ============================================================================

Table footprint_matrices {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Source
  source_type footprint_source_type [not null]
  event_log_id uuid [ref: > event_logs.id, default: null]
  model_id uuid [ref: > process_models.id, default: null]
  
  // Activities
  activities text[] [not null]
  
  // Footprint Relations (stored as adjacency)
  // Key: "activity1,activity2", Value: relation type
  dfg_matrix jsonb [default: '{}', note: 'Directly-follows relations']
  sequence_matrix jsonb [default: '{}', note: 'Sequence relations (→)']
  parallel_matrix jsonb [default: '{}', note: 'Parallel relations (||)']
  
  // Start/End Activities
  start_activities text[] [default: '{}']
  end_activities text[] [default: '{}']
  
  computed_at timestamp [default: `now()`]
  
  indexes {
    (event_log_id)
    (model_id)
  }
  
  Note: 'Footprint matrices for logs and models'
}

Table footprint_comparisons {
  id uuid [pk, default: `gen_random_uuid()`]
  conformance_check_id uuid [ref: > conformance_checks.id, not null]
  
  log_footprint_id uuid [ref: > footprint_matrices.id, not null]
  model_footprint_id uuid [ref: > footprint_matrices.id, not null]
  
  // Comparison Results
  fitness float [default: null]
  precision float [default: null]
  
  // Deviation Counts
  log_model_deviations int [default: 0, note: 'In log but not model']
  model_log_deviations int [default: 0, note: 'In model but not log']
  
  // Detailed Deviations
  deviations jsonb [default: '[]']
  
  indexes {
    conformance_check_id
  }
  
  Note: 'Footprint comparison results'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum alignment_algorithm {
  A_STAR [note: 'A* algorithm']
  DIJKSTRA [note: 'Dijkstra algorithm']
  STATE_EQUATION [note: 'State equation']
  APPROX [note: 'Approximation algorithm']
}

Enum deviation_type {
  LOG_MOVE [note: 'Activity in log but not model']
  MODEL_MOVE [note: 'Activity in model but not log']
  SYNC_MOVE [note: 'Synchronized move']
}

Enum deviation_direction {
  FASTER [note: 'Faster than expected']
  SLOWER [note: 'Slower than expected']
}
-e 


// ============================================================================
// L2-340: ANALYSIS & METRICS SYSTEM (AMS)
// L2-350: SIMULATION SYSTEM (SS)
// File: L1-300_processing_segment/L2-340_350_analysis_simulation.dbml
// Segment: L1-300 Processing Segment
// ============================================================================
// L2-340 Subsystems:
//   L3-341: Soundness Analysis Subsystem
//   L3-342: Simplicity Metrics Subsystem
//   L3-343: Variant Analysis Subsystem
//   L3-344: Performance Metrics Subsystem
//   L3-345: Batch Detection Subsystem
// L2-350 Subsystems:
//   L3-351: Playout Subsystem
//   L3-352: Stochastic Simulation Subsystem
// ============================================================================
// PM4Py Modules: pm4py.analysis, pm4py.stats, pm4py.sim
// ============================================================================

// ============================================================================
// L2-340: ANALYSIS & METRICS SYSTEM
// ============================================================================

// L3-341: SOUNDNESS ANALYSIS SUBSYSTEM

Table soundness_analyses {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [ref: > process_models.id, not null]
  
  // Results (pm4py.analysis.check_soundness)
  is_sound boolean [default: null]
  is_relaxed_sound boolean [default: null]
  is_easy_sound boolean [default: null]
  
  // Detailed Issues
  uncovered_places_count int [default: 0]
  uncovered_places jsonb [default: '[]']
  dead_transitions_count int [default: 0]
  dead_transitions jsonb [default: '[]']
  
  // Reachability
  is_bounded boolean [default: null]
  max_tokens_in_place int [default: null]
  
  // Live transitions
  live_transitions_count int [default: 0]
  non_live_transitions jsonb [default: '[]']
  
  checked_at timestamp [default: `now()`]
  duration_ms int [default: null]
  
  indexes {
    model_id
  }
  
  Note: 'Petri net soundness analysis (pm4py.analysis.check_soundness)'
}

// L3-342: SIMPLICITY METRICS SUBSYSTEM

Table simplicity_metrics {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [ref: > process_models.id, not null]
  
  // pm4py.analysis.simplicity
  arc_degree float [default: null, note: 'Average arc degree']
  extended_cardoso float [default: null]
  extended_cyclomatic float [default: null]
  
  // Additional complexity metrics
  node_count int [default: null]
  edge_count int [default: null]
  gateway_count int [default: null]
  
  // Derived
  density float [default: null]
  coefficient_of_connectivity float [default: null]
  
  calculated_at timestamp [default: `now()`]
  
  indexes {
    model_id
  }
  
  Note: 'Model simplicity metrics (pm4py.analysis.simplicity)'
}

// L3-343: VARIANT ANALYSIS SUBSYSTEM

Table variant_clusters {
  id uuid [pk, default: `gen_random_uuid()`]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  name varchar(255) [default: null]
  
  // Clustering Configuration
  algorithm clustering_algorithm [not null]
  params jsonb [default: '{}']
  n_clusters int [default: null]
  
  // Statistics
  variant_count int [default: 0]
  case_count bigint [default: 0]
  
  // Quality Metrics
  silhouette_score float [default: null]
  calinski_harabasz float [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (event_log_id, algorithm)
  }
  
  Note: 'Variant clustering results (pm4py.analysis clustering)'
}

Table variant_cluster_members {
  id uuid [pk, default: `gen_random_uuid()`]
  cluster_id uuid [ref: > variant_clusters.id, not null]
  variant_id uuid [ref: > variants.id, not null]
  
  cluster_index int [not null]
  
  // Distance metrics
  distance_to_centroid float [default: null]
  
  // Is representative
  is_representative boolean [default: false]
  
  indexes {
    (cluster_id, variant_id) [unique]
    (cluster_id, cluster_index)
  }
  
  Note: 'Variant-to-cluster assignments'
}

// Similarity Analysis (pm4py.analysis)
Table similarity_analyses {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  analysis_type similarity_type [not null]
  
  // Sources (depending on type)
  source_event_log_id uuid [ref: > event_logs.id, default: null]
  target_event_log_id uuid [ref: > event_logs.id, default: null]
  source_model_id uuid [ref: > process_models.id, default: null]
  target_model_id uuid [ref: > process_models.id, default: null]
  
  // Result
  similarity_score float [not null]
  
  // Details
  details jsonb [default: '{}']
  
  calculated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, analysis_type)
    source_event_log_id
    target_event_log_id
  }
  
  Note: 'Behavioral/structural similarity (pm4py.analysis)'
}

// EMD (Earth Mover's Distance)
Table emd_comparisons {
  id uuid [pk, default: `gen_random_uuid()`]
  
  source_event_log_id uuid [ref: > event_logs.id, not null]
  
  // Target (one of these)
  target_event_log_id uuid [ref: > event_logs.id, default: null]
  target_model_id uuid [ref: > process_models.id, default: null]
  
  // Result (pm4py.analysis.emd)
  emd_value float [not null]
  
  // Computation
  variant_limit int [default: null]
  
  calculated_at timestamp [default: `now()`]
  
  indexes {
    source_event_log_id
    target_event_log_id
    target_model_id
  }
  
  Note: 'Earth Mover\'s Distance comparisons (pm4py.analysis.emd)'
}

// L3-344: PERFORMANCE METRICS SUBSYSTEM

Table process_metrics {
  id uuid [pk, default: `gen_random_uuid()`]
  process_id uuid [ref: > processes.id, not null]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  // Snapshot timestamp
  snapshot_at timestamp [default: `now()`]
  
  // Volume Metrics
  total_cases bigint [default: 0]
  total_events bigint [default: 0]
  unique_activities int [default: 0]
  unique_variants int [default: 0]
  unique_resources int [default: 0]
  
  // Time Metrics (pm4py.stats)
  avg_case_duration_seconds float [default: null]
  median_case_duration_seconds float [default: null]
  min_case_duration_seconds float [default: null]
  max_case_duration_seconds float [default: null]
  stdev_case_duration_seconds float [default: null]
  p95_case_duration_seconds float [default: null]
  
  // Arrival/Throughput (pm4py.stats)
  avg_cases_per_day float [default: null]
  avg_events_per_case float [default: null]
  avg_cycle_time_seconds float [default: null]
  
  // Waiting Time
  avg_waiting_time_seconds float [default: null]
  total_waiting_time_seconds bigint [default: null]
  waiting_time_ratio float [default: null]
  
  // Rework (pm4py.stats rework)
  cases_with_rework bigint [default: 0]
  rework_rate float [default: 0]
  avg_rework_per_case float [default: null]
  
  // Cost
  total_cost decimal(15,2) [default: null]
  avg_cost_per_case decimal(15,2) [default: null]
  
  // Time Coverage
  data_start_time timestamp [default: null]
  data_end_time timestamp [default: null]
  
  indexes {
    (process_id, snapshot_at)
    (event_log_id)
  }
  
  Note: 'Process performance metrics snapshots (pm4py.stats)'
}

Table activity_performance {
  id uuid [pk, default: `gen_random_uuid()`]
  process_metrics_id uuid [ref: > process_metrics.id, not null]
  activity_id uuid [ref: > activities.id, not null]
  
  // Service Time (pm4py.stats service_time)
  avg_service_time_seconds float [default: null]
  median_service_time_seconds float [default: null]
  min_service_time_seconds float [default: null]
  max_service_time_seconds float [default: null]
  
  // Waiting Time (pm4py.stats sojourn_time)
  avg_waiting_time_seconds float [default: null]
  
  // Overlap (pm4py.stats)
  avg_concurrent_activities float [default: null]
  
  indexes {
    (process_metrics_id, activity_id)
  }
  
  Note: 'Activity-level performance metrics'
}

// Self-Distance (pm4py.stats)
Table self_distance_results {
  id uuid [pk, default: `gen_random_uuid()`]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  // Matrix
  distance_matrix jsonb [not null]
  
  // Summary stats
  avg_distance float [default: null]
  max_distance float [default: null]
  min_distance float [default: null]
  
  calculated_at timestamp [default: `now()`]
  
  indexes {
    event_log_id
  }
  
  Note: 'Self-distance matrix (pm4py.stats.self_distance)'
}

// L3-345: BATCH DETECTION SUBSYSTEM

Table batch_analyses {
  id uuid [pk, default: `gen_random_uuid()`]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  // Parameters
  min_batch_size int [default: 2]
  merge_distance_seconds float [default: null]
  
  // Results
  total_batches int [default: 0]
  activities_with_batches int [default: 0]
  
  analyzed_at timestamp [default: `now()`]
  
  indexes {
    event_log_id
  }
  
  Note: 'Batch detection analysis (pm4py.discovery.batches)'
}

Table batch_detections {
  id uuid [pk, default: `gen_random_uuid()`]
  batch_analysis_id uuid [ref: > batch_analyses.id, not null]
  
  activity varchar(255) [not null]
  resource varchar(255) [default: null]
  
  batch_type batch_type [not null]
  
  // Statistics
  batch_count int [default: 0]
  avg_batch_size float [default: null]
  max_batch_size int [default: null]
  min_batch_size int [default: null]
  
  avg_batch_duration_seconds float [default: null]
  
  // Impact
  cases_affected bigint [default: 0]
  events_in_batches bigint [default: 0]
  
  indexes {
    (batch_analysis_id, activity)
  }
  
  Note: 'Individual batch detections'
}

// ============================================================================
// L2-350: SIMULATION SYSTEM
// ============================================================================

// L3-351: PLAYOUT SUBSYSTEM

Table simulation_configs {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  process_id uuid [ref: > processes.id, default: null]
  model_id uuid [ref: > process_models.id, not null]
  
  name varchar(255) [not null]
  description text [default: null]
  
  simulation_type simulation_type [not null]
  
  // Basic Parameters
  num_traces int [default: 1000]
  max_trace_length int [default: 100]
  
  // Timing (optional)
  use_timing boolean [default: false]
  default_activity_duration_seconds float [default: 60]
  
  // Stochastic parameters (for stochastic nets)
  use_stochastic_weights boolean [default: false]
  
  // Resource parameters
  simulate_resources boolean [default: false]
  resource_config jsonb [default: '{}']
  
  // Additional parameters
  params jsonb [default: '{}']
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, process_id)
    (model_id)
  }
  
  Note: 'Simulation configurations (pm4py.sim)'
}

Table simulation_runs {
  id uuid [pk, default: `gen_random_uuid()`]
  config_id uuid [ref: > simulation_configs.id, not null]
  org_id uuid [ref: > organizations.id, not null]
  
  name varchar(255) [default: null]
  
  status job_status [default: 'PENDING']
  
  // Override parameters
  num_traces int [default: null]
  random_seed int [default: null]
  
  // Result
  result_event_log_id uuid [ref: > event_logs.id, default: null]
  
  // Statistics
  traces_generated int [default: 0]
  events_generated bigint [default: 0]
  
  // Quality Metrics (compared to original log if available)
  trace_length_similarity float [default: null]
  activity_distribution_similarity float [default: null]
  
  // Timing
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  error_message text [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (config_id, status)
    (org_id, status)
    created_at
  }
  
  Note: 'Simulation run executions'
}

// L3-352: STOCHASTIC SIMULATION SUBSYSTEM

Table stochastic_petri_nets {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [ref: > process_models.id, not null]
  
  // Learned from
  source_event_log_id uuid [ref: > event_logs.id, default: null]
  
  // Type
  spn_type spn_type [default: 'GSPN']
  
  // Statistics
  transition_count int [default: 0]
  
  learned_at timestamp [default: null]
  
  indexes {
    model_id
  }
  
  Note: 'Stochastic Petri net parameters'
}

Table stochastic_transition_params {
  id uuid [pk, default: `gen_random_uuid()`]
  spn_id uuid [ref: > stochastic_petri_nets.id, not null]
  transition_id uuid [ref: > petri_net_transitions.id, not null]
  
  // Transition Type
  transition_type spn_transition_type [not null]
  
  // Weight (for immediate transitions)
  weight float [default: 1.0]
  
  // Rate (for timed transitions)
  firing_rate float [default: null]
  
  // Distribution (for timed transitions)
  distribution distribution_type [default: 'EXPONENTIAL']
  distribution_params jsonb [default: '{}']
  
  indexes {
    (spn_id, transition_id) [unique]
  }
  
  Note: 'Stochastic parameters per transition'
}

// What-If Scenarios
Table simulation_scenarios {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  name varchar(255) [not null]
  description text [default: null]
  
  // Baseline
  baseline_config_id uuid [ref: > simulation_configs.id, not null]
  
  // Modifications
  modifications jsonb [not null, note: 'Changes to apply']
  
  status scenario_status [default: 'DRAFT']
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (org_id)
  }
  
  Note: 'What-if simulation scenarios'
}

Table scenario_comparisons {
  id uuid [pk, default: `gen_random_uuid()`]
  scenario_id uuid [ref: > simulation_scenarios.id, not null]
  
  baseline_run_id uuid [ref: > simulation_runs.id, not null]
  scenario_run_id uuid [ref: > simulation_runs.id, not null]
  
  // Comparison Results
  throughput_change_percent float [default: null]
  cycle_time_change_percent float [default: null]
  cost_change_percent float [default: null]
  resource_utilization_change_percent float [default: null]
  
  detailed_comparison jsonb [default: '{}']
  
  compared_at timestamp [default: `now()`]
  
  indexes {
    scenario_id
  }
  
  Note: 'Scenario comparison results'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum similarity_type {
  BEHAVIORAL [note: 'Behavioral similarity']
  STRUCTURAL [note: 'Structural similarity']
  LABEL [note: 'Label-based similarity']
}

Enum spn_type {
  GSPN [note: 'Generalized Stochastic Petri Net']
  SPN [note: 'Standard Stochastic Petri Net']
}

Enum spn_transition_type {
  IMMEDIATE [note: 'Immediate (tau=0)']
  TIMED [note: 'Timed transition']
}

Enum distribution_type {
  EXPONENTIAL
  NORMAL
  UNIFORM
  LOGNORMAL
  GAMMA
  WEIBULL
  CONSTANT
}

Enum scenario_status {
  DRAFT
  RUNNING
  COMPLETED
  FAILED
}
-e 


// ============================================================================
// L2-410: MACHINE LEARNING SYSTEM (MLS)
// L2-420: LLM INTEGRATION SYSTEM (LIS)
// File: L1-400_intelligence_segment/L2-410_420_ml_llm.dbml
// Segment: L1-400 Intelligence Segment
// ============================================================================
// PM4Py Modules: pm4py.ml, pm4py.llm
// ============================================================================

// ============================================================================
// L2-410: MACHINE LEARNING SYSTEM
// ============================================================================
// Subsystems:
//   L3-411: Feature Engineering Subsystem
//   L3-412: Model Training Subsystem
//   L3-413: Prediction Subsystem
// ============================================================================

// L3-411: FEATURE ENGINEERING SUBSYSTEM

Table ml_datasets {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  event_log_id uuid [ref: > event_logs.id, not null]
  ocel_log_id uuid [ref: > ocel_logs.id, default: null]
  
  name varchar(255) [not null]
  description text [default: null]
  
  // Dataset Type (pm4py.ml)
  dataset_type ml_dataset_type [not null]
  
  // Splitting Configuration
  split_method split_method [default: 'TEMPORAL']
  train_ratio float [default: 0.8]
  validation_ratio float [default: 0.1]
  test_ratio float [default: 0.1]
  random_seed int [default: 42]
  temporal_split_date timestamp [default: null]
  
  // Feature Configuration
  feature_config jsonb [default: '{}']
  encoding_config jsonb [default: '{}', note: 'Categorical encoding settings']
  
  // Target Configuration
  target_type ml_target_type [not null]
  target_column varchar(255) [default: null]
  target_config jsonb [default: '{}']
  
  // Statistics
  total_samples int [default: 0]
  train_samples int [default: 0]
  validation_samples int [default: 0]
  test_samples int [default: 0]
  feature_count int [default: 0]
  
  // Class Distribution (for classification)
  class_distribution jsonb [default: null]
  
  // Storage
  train_file_path text [default: null]
  validation_file_path text [default: null]
  test_file_path text [default: null]
  
  status dataset_status [default: 'DRAFT']
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, event_log_id)
    (org_id, status)
    (org_id, target_type)
  }
  
  Note: 'ML dataset configurations (pm4py.ml split)'
}

Table ml_features {
  id uuid [pk, default: `gen_random_uuid()`]
  dataset_id uuid [ref: > ml_datasets.id, not null]
  
  // Feature Identity
  feature_name varchar(255) [not null]
  display_name varchar(255) [default: null]
  
  feature_type ml_feature_type [not null]
  feature_category feature_category [default: 'EVENT']
  
  // Source
  source_column varchar(255) [default: null]
  derivation_formula text [default: null]
  
  // For aggregated features
  aggregation aggregation_type [default: null]
  window_size int [default: null]
  
  // Statistics
  mean float [default: null]
  std float [default: null]
  min float [default: null]
  max float [default: null]
  null_rate float [default: null]
  unique_values int [default: null]
  
  // Encoding (for categorical)
  encoding_type encoding_type [default: null]
  encoding_mapping jsonb [default: null]
  
  // Feature Importance (after training)
  importance_score float [default: null]
  
  is_active boolean [default: true]
  
  indexes {
    (dataset_id, feature_name) [unique]
    (dataset_id, feature_category)
    (dataset_id, is_active)
  }
  
  Note: 'ML feature definitions and statistics'
}

// L3-412: MODEL TRAINING SUBSYSTEM

Table ml_experiments {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  dataset_id uuid [ref: > ml_datasets.id, not null]
  
  name varchar(255) [not null]
  description text [default: null]
  
  // Experiment Configuration
  task_type ml_task_type [not null]
  
  status experiment_status [default: 'CREATED']
  
  // Best Model
  best_model_id uuid [default: null]
  best_metric_name varchar(100) [default: null]
  best_metric_value float [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, dataset_id)
    (org_id, status)
  }
  
  Note: 'ML experiment tracking'
}

Table ml_models {
  id uuid [pk, default: `gen_random_uuid()`]
  experiment_id uuid [ref: > ml_experiments.id, not null]
  org_id uuid [ref: > organizations.id, not null]
  dataset_id uuid [ref: > ml_datasets.id, not null]
  
  name varchar(255) [not null]
  
  // Model Type
  model_type ml_model_type [not null]
  task_type ml_task_type [not null]
  
  status model_training_status [default: 'PENDING']
  
  // Hyperparameters
  hyperparameters jsonb [default: '{}']
  
  // Training Info
  training_started_at timestamp [default: null]
  training_completed_at timestamp [default: null]
  training_duration_ms int [default: null]
  epochs_completed int [default: null]
  
  // Model Storage
  model_file_path text [default: null]
  model_file_size_bytes bigint [default: null]
  model_framework varchar(50) [default: null]
  model_version varchar(50) [default: null]
  
  // Metrics (on test set)
  metrics jsonb [default: '{}', note: 'accuracy, f1, mae, rmse, etc.']
  
  // For classification
  confusion_matrix jsonb [default: null]
  classification_report jsonb [default: null]
  roc_auc float [default: null]
  
  // For regression
  mae float [default: null]
  rmse float [default: null]
  r2_score float [default: null]
  
  // Feature Importance
  feature_importances jsonb [default: null]
  
  // Deployment
  is_deployed boolean [default: false]
  deployed_at timestamp [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (org_id, task_type)
    (experiment_id, status)
    (dataset_id)
    (org_id, is_deployed)
  }
  
  Note: 'Trained ML models'
}

// L3-413: PREDICTION SUBSYSTEM

Table ml_prediction_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  model_id uuid [ref: > ml_models.id, not null]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  status job_status [default: 'PENDING']
  
  // Prediction Configuration
  prediction_mode prediction_mode [default: 'BATCH']
  
  // For prefix-based predictions
  prefix_length int [default: null]
  
  // Results
  total_predictions int [default: 0]
  
  // Timing
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  error_message text [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (org_id, status)
    (model_id)
    created_at
  }
  
  Note: 'Batch prediction jobs'
}

Table ml_predictions {
  id uuid [pk, default: `gen_random_uuid()`]
  job_id uuid [ref: > ml_prediction_jobs.id, default: null]
  model_id uuid [ref: > ml_models.id, not null]
  
  // Input Reference
  case_id varchar(255) [not null]
  prefix_length int [default: null]
  
  // Input Features (snapshot)
  input_features jsonb [not null]
  
  // Prediction Output
  prediction jsonb [not null]
  
  // Confidence
  confidence float [default: null]
  probabilities jsonb [default: null, note: 'Class probabilities']
  
  // For evaluation
  actual_value jsonb [default: null]
  is_correct boolean [default: null]
  
  predicted_at timestamp [default: `now()`]
  
  indexes {
    (job_id)
    (model_id, case_id)
    (model_id, predicted_at)
  }
  
  Note: 'Individual predictions'
}

// ============================================================================
// L2-420: LLM INTEGRATION SYSTEM (pm4py.llm)
// ============================================================================
// Subsystems:
//   L3-421: LLM Session Subsystem
//   L3-422: Log Abstraction Subsystem
//   L3-423: Hypothesis Generation Subsystem
// ============================================================================

// L3-421: LLM SESSION SUBSYSTEM

Table llm_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  user_id uuid [ref: > users.id, not null]
  
  // Context
  event_log_id uuid [ref: > event_logs.id, default: null]
  process_id uuid [ref: > processes.id, default: null]
  ocel_log_id uuid [ref: > ocel_logs.id, default: null]
  
  // Provider Configuration
  provider llm_provider_type [not null]
  model varchar(100) [not null]
  
  // Session Configuration
  system_prompt text [default: null]
  temperature float [default: 0.7]
  max_tokens int [default: 4096]
  
  status llm_session_status [default: 'ACTIVE']
  
  // Usage Tracking
  total_tokens_used int [default: 0]
  prompt_tokens_used int [default: 0]
  completion_tokens_used int [default: 0]
  total_requests int [default: 0]
  total_cost_cents int [default: 0]
  
  // Timing
  created_at timestamp [default: `now()`]
  last_message_at timestamp [default: null]
  ended_at timestamp [default: null]
  
  indexes {
    (org_id, user_id)
    (org_id, status)
    (event_log_id)
    (process_id)
  }
  
  Note: 'LLM conversation sessions (pm4py.llm)'
}

Table llm_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [ref: > llm_sessions.id, not null]
  
  // Message
  role message_role [not null]
  content text [not null]
  
  // For function calls
  function_call jsonb [default: null]
  function_result jsonb [default: null]
  
  // Token Usage
  prompt_tokens int [default: null]
  completion_tokens int [default: null]
  
  // Performance
  latency_ms int [default: null]
  
  // Error
  error_message text [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (session_id, created_at)
    (session_id, role)
  }
  
  Note: 'Messages in LLM sessions'
}

// L3-422: LOG ABSTRACTION SUBSYSTEM

Table llm_abstractions {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  event_log_id uuid [ref: > event_logs.id, default: null]
  ocel_log_id uuid [ref: > ocel_logs.id, default: null]
  process_id uuid [ref: > processes.id, default: null]
  model_id uuid [ref: > process_models.id, default: null]
  
  // Abstraction Type (pm4py.llm abstraction functions)
  abstraction_type llm_abstraction_type [not null]
  
  // The abstracted content
  abstraction_text text [not null]
  
  // Parameters used
  params jsonb [default: '{}']
  max_variants int [default: null]
  include_performance boolean [default: false]
  
  // Token count (for context management)
  token_count int [default: null]
  
  // Caching
  cache_key varchar(255) [default: null]
  expires_at timestamp [default: null]
  
  created_by uuid [ref: > users.id, default: null]
  created_at timestamp [default: `now()`]
  
  indexes {
    (event_log_id, abstraction_type)
    (process_id, abstraction_type)
    cache_key
  }
  
  Note: 'LLM-ready abstractions of process data'
}

// L3-423: HYPOTHESIS GENERATION SUBSYSTEM

Table llm_hypotheses {
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [ref: > llm_sessions.id, default: null]
  org_id uuid [ref: > organizations.id, not null]
  event_log_id uuid [ref: > event_logs.id, default: null]
  process_id uuid [ref: > processes.id, default: null]
  
  // Hypothesis
  hypothesis_text text [not null]
  hypothesis_type hypothesis_type [not null]
  
  // Generated from
  source_abstraction_id uuid [ref: > llm_abstractions.id, default: null]
  
  // Validation
  is_validated boolean [default: false]
  validation_method varchar(100) [default: null]
  validation_result jsonb [default: null]
  validation_score float [default: null]
  
  // Status
  status hypothesis_status [default: 'GENERATED']
  
  // User feedback
  user_rating int [default: null, note: '1-5 rating']
  user_feedback text [default: null]
  
  created_at timestamp [default: `now()`]
  validated_at timestamp [default: null]
  
  indexes {
    (org_id, hypothesis_type)
    (session_id)
    (event_log_id)
    (process_id)
    (status)
  }
  
  Note: 'LLM-generated hypotheses about processes'
}

Table llm_queries {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  session_id uuid [ref: > llm_sessions.id, default: null]
  
  // Natural Language Query
  query_text text [not null]
  
  // Generated SQL/Code
  generated_query text [default: null]
  query_type query_type [default: 'SQL']
  
  // Target
  target_event_log_id uuid [ref: > event_logs.id, default: null]
  
  // Execution
  is_executed boolean [default: false]
  execution_result jsonb [default: null]
  execution_time_ms int [default: null]
  
  // Safety
  is_safe boolean [default: null]
  safety_notes text [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (org_id)
    (session_id)
    created_at
  }
  
  Note: 'NL-to-SQL queries (pm4py.llm)'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum split_method {
  RANDOM [note: 'Random split']
  TEMPORAL [note: 'Time-based split']
  STRATIFIED [note: 'Stratified by target']
  CASE_BASED [note: 'Split by case']
}

Enum feature_category {
  EVENT [note: 'Event-level feature']
  CASE [note: 'Case-level feature']
  TEMPORAL [note: 'Time-based feature']
  AGGREGATE [note: 'Aggregated feature']
  EMBEDDING [note: 'Learned embedding']
}

Enum encoding_type {
  ONE_HOT [note: 'One-hot encoding']
  LABEL [note: 'Label encoding']
  TARGET [note: 'Target encoding']
  FREQUENCY [note: 'Frequency encoding']
  EMBEDDING [note: 'Neural embedding']
}

Enum dataset_status {
  DRAFT
  PROCESSING
  READY
  ERROR
}

Enum experiment_status {
  CREATED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

Enum model_training_status {
  PENDING
  TRAINING
  EVALUATING
  COMPLETED
  FAILED
}

Enum prediction_mode {
  BATCH [note: 'Batch prediction']
  REALTIME [note: 'Real-time prediction']
  STREAMING [note: 'Streaming prediction']
}

Enum hypothesis_status {
  GENERATED [note: 'Just generated']
  PENDING_VALIDATION [note: 'Awaiting validation']
  VALIDATED [note: 'Successfully validated']
  REJECTED [note: 'Validation failed']
  ACCEPTED [note: 'User accepted']
}

Enum query_type {
  SQL [note: 'SQL query']
  PANDAS [note: 'Pandas code']
  PM4PY [note: 'PM4Py code']
}
-e 


// ============================================================================
// L2-430: SOCIAL NETWORK ANALYSIS SYSTEM (SNAS)
// File: L1-400_intelligence_segment/L2-430_social_network.dbml
// Segment: L1-400 Intelligence Segment
// ============================================================================
// Subsystems:
//   L3-431: Network Analysis Subsystem
//   L3-432: Organizational Mining Subsystem
// ============================================================================
// PM4Py Modules: pm4py.org (SNA)
// ============================================================================

// ============================================================================
// L3-431: NETWORK ANALYSIS SUBSYSTEM
// ============================================================================

Table sna_analyses {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  event_log_id uuid [ref: > event_logs.id, not null]
  process_id uuid [ref: > processes.id, default: null]
  
  // Analysis Identity
  name varchar(255) [not null]
  description text [default: null]
  
  // Analysis Type (pm4py.org)
  analysis_type sna_type [not null]
  
  // Parameters
  params jsonb [default: '{}']
  
  // For working_together and subcontracting
  threshold float [default: 0.0]
  
  // Status
  status job_status [default: 'PENDING']
  
  // Network Statistics
  node_count int [default: 0]
  edge_count int [default: 0]
  
  // Global Network Metrics
  density float [default: null]
  avg_degree float [default: null]
  avg_clustering_coefficient float [default: null]
  avg_path_length float [default: null]
  diameter int [default: null]
  
  // Components
  num_components int [default: null]
  largest_component_size int [default: null]
  
  // Network Data Storage
  network_data jsonb [default: null, note: 'For small networks']
  network_file_path text [default: null, note: 'For large networks']
  
  // Execution
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (org_id, event_log_id)
    (org_id, analysis_type)
    (process_id)
    (org_id, status)
  }
  
  Note: 'Social Network Analysis results (pm4py.org)'
}

Table sna_resources {
  id uuid [pk, default: `gen_random_uuid()`]
  sna_analysis_id uuid [ref: > sna_analyses.id, not null]
  
  // Resource Identity
  resource_name varchar(255) [not null]
  resource_id uuid [ref: > resources.id, default: null]
  
  // Node Metrics
  node_index int [not null]
  
  // Centrality Metrics
  degree_centrality float [default: null]
  in_degree_centrality float [default: null]
  out_degree_centrality float [default: null]
  betweenness_centrality float [default: null]
  closeness_centrality float [default: null]
  eigenvector_centrality float [default: null]
  pagerank float [default: null]
  
  // Clustering
  clustering_coefficient float [default: null]
  
  // Activity Profile
  activities_performed text[] [default: '{}']
  primary_activity varchar(255) [default: null]
  
  // Event Statistics
  event_count bigint [default: 0]
  case_count bigint [default: 0]
  
  // Handover Specific (for HANDOVER_OF_WORK)
  total_handovers_out int [default: 0]
  total_handovers_in int [default: 0]
  
  indexes {
    (sna_analysis_id, resource_name) [unique]
    (sna_analysis_id, degree_centrality)
    (sna_analysis_id, betweenness_centrality)
  }
  
  Note: 'Resource nodes in SNA'
}

Table sna_edges {
  id uuid [pk, default: `gen_random_uuid()`]
  sna_analysis_id uuid [ref: > sna_analyses.id, not null]
  
  source_resource_id uuid [ref: > sna_resources.id, not null]
  target_resource_id uuid [ref: > sna_resources.id, not null]
  
  // Edge Weight
  weight float [default: 1.0]
  frequency int [default: 1]
  
  // For different analysis types
  // HANDOVER_OF_WORK: number of handovers
  // WORKING_TOGETHER: number of co-occurrences
  // SUBCONTRACTING: subcontracting instances
  // SIMILAR_ACTIVITIES: similarity score
  
  // Normalized Weight
  normalized_weight float [default: null]
  
  indexes {
    (sna_analysis_id, source_resource_id, target_resource_id) [unique]
    (sna_analysis_id, weight)
  }
  
  Note: 'Edges in social network'
}

Table sna_communities {
  id uuid [pk, default: `gen_random_uuid()`]
  sna_analysis_id uuid [ref: > sna_analyses.id, not null]
  
  // Community Identity
  community_index int [not null]
  name varchar(255) [default: null]
  
  // Statistics
  member_count int [default: 0]
  internal_edges int [default: 0]
  external_edges int [default: 0]
  
  // Density within community
  internal_density float [default: null]
  
  // Modularity contribution
  modularity_contribution float [default: null]
  
  indexes {
    (sna_analysis_id, community_index) [unique]
  }
  
  Note: 'Detected communities in network'
}

Table sna_community_members {
  id uuid [pk, default: `gen_random_uuid()`]
  community_id uuid [ref: > sna_communities.id, not null]
  resource_id uuid [ref: > sna_resources.id, not null]
  
  // Membership strength (for fuzzy communities)
  membership_score float [default: 1.0]
  
  indexes {
    (community_id, resource_id) [unique]
  }
  
  Note: 'Community membership'
}

// ============================================================================
// L3-432: ORGANIZATIONAL MINING SUBSYSTEM
// ============================================================================

Table organizational_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  // Role Identity
  role_name varchar(255) [not null]
  description text [default: null]
  
  // Discovery Method
  discovery_method role_discovery_method [not null]
  
  // Members
  member_count int [default: 0]
  
  // Activities
  activities text[] [default: '{}']
  primary_activities text[] [default: '{}']
  
  // Statistics
  total_events bigint [default: 0]
  avg_events_per_member float [default: null]
  
  discovered_at timestamp [default: `now()`]
  
  indexes {
    (event_log_id, role_name) [unique]
    (org_id, event_log_id)
  }
  
  Note: 'Discovered organizational roles (pm4py.org.roles)'
}

Table role_members {
  id uuid [pk, default: `gen_random_uuid()`]
  role_id uuid [ref: > organizational_roles.id, not null]
  resource_name varchar(255) [not null]
  resource_id uuid [ref: > resources.id, default: null]
  
  // Membership Score (for soft clustering)
  membership_score float [default: 1.0]
  
  // Activity Overlap
  activity_overlap_score float [default: null]
  
  indexes {
    (role_id, resource_name) [unique]
  }
  
  Note: 'Resource-to-role assignments'
}

Table resource_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  event_log_id uuid [ref: > event_logs.id, not null]
  resource_id uuid [ref: > resources.id, not null]
  
  // Work Pattern Analysis
  active_hours jsonb [default: '{}', note: 'Hour -> event_count']
  active_days jsonb [default: '{}', note: 'Day -> event_count']
  
  // Performance Metrics
  avg_processing_time_seconds float [default: null]
  avg_cases_per_day float [default: null]
  avg_events_per_case float [default: null]
  
  // Workload Distribution
  workload_variance float [default: null]
  peak_hour int [default: null]
  peak_day int [default: null]
  
  // Collaboration Metrics
  unique_collaborators int [default: 0]
  collaboration_score float [default: null]
  
  // Quality Metrics (if available)
  rework_rate float [default: null]
  
  analyzed_at timestamp [default: `now()`]
  
  indexes {
    (event_log_id, resource_id) [unique]
    (org_id, event_log_id)
  }
  
  Note: 'Resource performance profiles'
}

Table resource_similarities {
  id uuid [pk, default: `gen_random_uuid()`]
  event_log_id uuid [ref: > event_logs.id, not null]
  
  resource_a_id uuid [ref: > resources.id, not null]
  resource_b_id uuid [ref: > resources.id, not null]
  
  // Similarity Type
  similarity_type similarity_type [not null]
  
  // Similarity Score
  similarity_score float [not null]
  
  computed_at timestamp [default: `now()`]
  
  indexes {
    (event_log_id, resource_a_id, resource_b_id, similarity_type) [unique]
    (event_log_id, similarity_score)
  }
  
  Note: 'Resource similarity matrix'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum role_discovery_method {
  ACTIVITY_CLUSTERING [note: 'Cluster by activities performed']
  CASE_CLUSTERING [note: 'Cluster by case involvement']
  HYBRID [note: 'Combined approach']
  MANUAL [note: 'User-defined roles']
}

Enum similarity_type {
  ACTIVITY_JACCARD [note: 'Jaccard similarity of activities']
  ACTIVITY_COSINE [note: 'Cosine similarity of activity vectors']
  CASE_OVERLAP [note: 'Shared case involvement']
  TEMPORAL [note: 'Similar working hours']
}
-e 


// ============================================================================
// L2-510: AUTOMATION SYSTEM (AS)
// L2-520: ALERT & NOTIFICATION SYSTEM (ANS)
// File: L1-500_mission_control/L2-510_520_automation_alerts.dbml
// Segment: L1-500 Mission Control
// ============================================================================
// L2-510 Subsystems:
//   L3-511: Trigger Subsystem
//   L3-512: Action Execution Subsystem
//   L3-513: Workflow Orchestration Subsystem
// L2-520 Subsystems:
//   L3-521: Alert Management Subsystem
//   L3-522: Incident Management Subsystem
//   L3-523: Notification Delivery Subsystem
// ============================================================================

// ============================================================================
// L2-510: AUTOMATION SYSTEM
// ============================================================================

// L3-511: TRIGGER SUBSYSTEM

Table automations {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  process_id uuid [ref: > processes.id, default: null]
  project_id uuid [ref: > projects.id, default: null]
  
  // Identity
  name varchar(255) [not null]
  description text [default: null]
  
  // Type
  automation_type automation_type [not null]
  status automation_status [default: 'DRAFT']
  
  // Priority
  priority automation_priority [default: 'NORMAL']
  
  // Trigger Configuration
  trigger_type trigger_type [not null]
  trigger_config jsonb [not null]
  
  // For scheduled triggers
  schedule_cron varchar(100) [default: null]
  schedule_timezone varchar(50) [default: 'UTC']
  next_scheduled_run timestamp [default: null]
  
  // For event triggers
  event_source varchar(100) [default: null]
  event_filter jsonb [default: null]
  
  // Conditions (evaluated before execution)
  conditions jsonb [default: '[]', note: 'Array of condition groups (AND/OR)']
  
  // Actions
  actions jsonb [not null, note: 'Array of action definitions']
  
  // Error Handling
  on_error_action error_action [default: 'STOP']
  retry_config jsonb [default: '{}']
  max_retries int [default: 3]
  
  // Rate Limiting
  cooldown_seconds int [default: 0]
  max_executions_per_hour int [default: null]
  
  // Statistics
  total_executions bigint [default: 0]
  successful_executions bigint [default: 0]
  failed_executions bigint [default: 0]
  last_execution_at timestamp [default: null]
  last_success_at timestamp [default: null]
  last_failure_at timestamp [default: null]
  
  // Ownership
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, status)
    (org_id, automation_type)
    (process_id)
    next_scheduled_run
  }
  
  Note: 'Automation definitions'
}

Table automation_triggers {
  id uuid [pk, default: `gen_random_uuid()`]
  automation_id uuid [ref: > automations.id, not null]
  
  trigger_type trigger_type [not null]
  
  // Schedule Trigger
  cron_expression varchar(100) [default: null]
  timezone varchar(50) [default: 'UTC']
  
  // Event Trigger
  event_type event_trigger_type [default: null]
  event_source_type varchar(100) [default: null]
  event_source_id uuid [default: null]
  event_filter jsonb [default: null]
  
  // Threshold Trigger
  metric_name varchar(255) [default: null]
  threshold_operator comparison_operator [default: null]
  threshold_value float [default: null]
  evaluation_window_minutes int [default: null]
  
  // Webhook Trigger
  webhook_secret_hash varchar(255) [default: null]
  
  is_active boolean [default: true]
  
  indexes {
    (automation_id)
    (event_type, event_source_id)
  }
  
  Note: 'Automation trigger configurations'
}

// L3-512: ACTION EXECUTION SUBSYSTEM

Table automation_executions {
  id uuid [pk, default: `gen_random_uuid()`]
  automation_id uuid [ref: > automations.id, not null]
  org_id uuid [ref: > organizations.id, not null]
  
  status execution_status [default: 'PENDING']
  
  // Trigger Information
  triggered_by trigger_source [not null]
  triggered_by_user uuid [ref: > users.id, default: null]
  trigger_data jsonb [default: '{}']
  
  // Execution Context
  context jsonb [default: '{}', note: 'Variables available to actions']
  
  // Results
  result jsonb [default: null]
  
  // Action Statistics
  total_actions int [default: 0]
  completed_actions int [default: 0]
  failed_actions int [default: 0]
  skipped_actions int [default: 0]
  
  // Timing
  queued_at timestamp [default: null]
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  // Error
  error_message text [default: null]
  error_action_index int [default: null]
  
  // Retry
  retry_count int [default: 0]
  parent_execution_id uuid [ref: > automation_executions.id, default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (automation_id, status)
    (org_id, status)
    (automation_id, created_at)
    started_at
  }
  
  Note: 'Automation execution instances'
}

Table automation_action_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  execution_id uuid [ref: > automation_executions.id, not null]
  
  // Action Identity
  action_index int [not null]
  action_type action_type [not null]
  action_name varchar(255) [default: null]
  
  status execution_status [default: 'PENDING']
  
  // Input/Output
  input jsonb [default: '{}']
  output jsonb [default: null]
  
  // Timing
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  // Error
  error_message text [default: null]
  error_details jsonb [default: null]
  
  // Retry
  retry_count int [default: 0]
  
  indexes {
    (execution_id, action_index)
    (execution_id, status)
  }
  
  Note: 'Individual action execution logs'
}

// L3-513: WORKFLOW ORCHESTRATION SUBSYSTEM

Table workflow_definitions {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  name varchar(255) [not null]
  description text [default: null]
  version varchar(20) [default: '1.0.0']
  
  // Workflow Definition (DAG)
  definition jsonb [not null, note: 'Nodes and edges']
  
  status workflow_status [default: 'DRAFT']
  
  // Variables
  input_schema jsonb [default: '{}']
  output_schema jsonb [default: '{}']
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, status)
  }
  
  Note: 'Complex multi-step workflow definitions'
}

Table workflow_instances {
  id uuid [pk, default: `gen_random_uuid()`]
  workflow_id uuid [ref: > workflow_definitions.id, not null]
  org_id uuid [ref: > organizations.id, not null]
  
  status workflow_instance_status [default: 'PENDING']
  
  // Input/Output
  input_data jsonb [default: '{}']
  output_data jsonb [default: null]
  
  // State
  current_nodes text[] [default: '{}']
  completed_nodes text[] [default: '{}']
  
  // Timing
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  
  // Error
  error_message text [default: null]
  
  triggered_by uuid [ref: > users.id, default: null]
  created_at timestamp [default: `now()`]
  
  indexes {
    (workflow_id, status)
    (org_id, status)
  }
  
  Note: 'Workflow execution instances'
}

// ============================================================================
// L2-520: ALERT & NOTIFICATION SYSTEM
// ============================================================================

// L3-521: ALERT MANAGEMENT SUBSYSTEM

Table alerts {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  process_id uuid [ref: > processes.id, default: null]
  
  // Identity
  name varchar(255) [not null]
  description text [default: null]
  
  // Alert Type
  alert_type alert_type [not null]
  status alert_status [default: 'ACTIVE']
  severity alert_severity [default: 'MEDIUM']
  
  // Condition
  condition_type condition_type [not null]
  condition_config jsonb [not null]
  
  // For metric-based alerts
  metric_name varchar(255) [default: null]
  metric_source metric_source [default: null]
  threshold_operator comparison_operator [default: null]
  threshold_value float [default: null]
  evaluation_window_minutes int [default: 5]
  
  // For anomaly detection
  anomaly_algorithm anomaly_algorithm [default: null]
  anomaly_sensitivity float [default: 0.5]
  
  // Notification Configuration
  notification_channels notification_channel[] [default: '{}']
  notification_config jsonb [default: '{}']
  notification_template_id uuid [ref: > notification_templates.id, default: null]
  
  // Recipients
  notify_users uuid[] [default: '{}']
  notify_teams uuid[] [default: '{}']
  notify_emails text[] [default: '{}']
  
  // Cooldown
  cooldown_minutes int [default: 60]
  
  // Statistics
  last_triggered_at timestamp [default: null]
  trigger_count int [default: 0]
  last_value float [default: null]
  
  // Ownership
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, status)
    (org_id, alert_type)
    (process_id)
  }
  
  Note: 'Alert definitions'
}

// L3-522: INCIDENT MANAGEMENT SUBSYSTEM

Table alert_incidents {
  id uuid [pk, default: `gen_random_uuid()`]
  alert_id uuid [ref: > alerts.id, not null]
  org_id uuid [ref: > organizations.id, not null]
  
  status incident_status [default: 'OPEN']
  severity alert_severity [not null]
  
  // Trigger Details
  triggered_at timestamp [not null]
  trigger_value float [default: null]
  trigger_details jsonb [default: null]
  threshold_value float [default: null]
  
  // Duration
  duration_minutes int [default: null]
  
  // Assignment
  assigned_to uuid [ref: > users.id, default: null]
  assigned_at timestamp [default: null]
  
  // Acknowledgment
  acknowledged_at timestamp [default: null]
  acknowledged_by uuid [ref: > users.id, default: null]
  
  // Resolution
  resolved_at timestamp [default: null]
  resolved_by uuid [ref: > users.id, default: null]
  resolution_type resolution_type [default: null]
  resolution_notes text [default: null]
  
  // Escalation
  escalation_level int [default: 0]
  escalated_at timestamp [default: null]
  
  indexes {
    (alert_id, status)
    (org_id, status)
    (org_id, severity, status)
    triggered_at
  }
  
  Note: 'Alert incidents (triggered alerts)'
}

Table incident_timeline {
  id uuid [pk, default: `gen_random_uuid()`]
  incident_id uuid [ref: > alert_incidents.id, not null]
  
  event_type incident_event_type [not null]
  
  // Actor
  user_id uuid [ref: > users.id, default: null]
  system_generated boolean [default: false]
  
  // Details
  description text [default: null]
  details jsonb [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (incident_id, created_at)
  }
  
  Note: 'Incident activity timeline'
}

// L3-523: NOTIFICATION DELIVERY SUBSYSTEM

Table notification_templates {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, default: null, note: 'null = system template']
  
  name varchar(255) [not null]
  description text [default: null]
  
  // Channel
  channel notification_channel [not null]
  
  // Template Content
  subject_template text [default: null]
  body_template text [not null]
  
  // For Slack/Teams
  blocks_template jsonb [default: null]
  
  // Variables
  available_variables text[] [default: '{}']
  
  is_system boolean [default: false]
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, channel)
  }
  
  Note: 'Notification message templates'
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  // Source
  incident_id uuid [ref: > alert_incidents.id, default: null]
  automation_execution_id uuid [ref: > automation_executions.id, default: null]
  
  // Channel & Recipient
  channel notification_channel [not null]
  recipient varchar(500) [not null]
  recipient_user_id uuid [ref: > users.id, default: null]
  
  // Content
  subject varchar(500) [default: null]
  body text [not null]
  
  // Status
  status notification_status [default: 'PENDING']
  
  // Delivery
  sent_at timestamp [default: null]
  delivered_at timestamp [default: null]
  opened_at timestamp [default: null]
  clicked_at timestamp [default: null]
  
  // Error
  error_message text [default: null]
  retry_count int [default: 0]
  
  // External ID (for tracking)
  external_id varchar(255) [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (org_id, status)
    (incident_id)
    (recipient_user_id, created_at)
    created_at
  }
  
  Note: 'Notification delivery log'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum automation_priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

Enum trigger_type {
  SCHEDULE [note: 'Cron-based']
  EVENT [note: 'Event-driven']
  THRESHOLD [note: 'Metric threshold']
  WEBHOOK [note: 'External webhook']
  MANUAL [note: 'User-triggered']
}

Enum event_trigger_type {
  LOG_UPLOADED
  DISCOVERY_COMPLETED
  CONFORMANCE_COMPLETED
  ALERT_TRIGGERED
  CASE_STARTED
  CASE_COMPLETED
  SLA_BREACH
  CUSTOM
}

Enum trigger_source {
  SCHEDULE
  EVENT
  THRESHOLD
  WEBHOOK
  MANUAL
  API
  RETRY
}

Enum error_action {
  STOP [note: 'Stop execution']
  CONTINUE [note: 'Continue to next action']
  RETRY [note: 'Retry failed action']
  ROLLBACK [note: 'Rollback previous actions']
}

Enum workflow_status {
  DRAFT
  ACTIVE
  DEPRECATED
  DELETED
}

Enum workflow_instance_status {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

Enum condition_type {
  METRIC_THRESHOLD
  ANOMALY_DETECTION
  CONFORMANCE_DEVIATION
  SLA_BREACH
  TREND_CHANGE
  PATTERN_MATCH
  CUSTOM
}

Enum metric_source {
  EVENT_LOG
  PROCESS
  MODEL
  SYSTEM
  CUSTOM
}

Enum anomaly_algorithm {
  ISOLATION_FOREST
  ZSCORE
  MAD
  PROPHET
}

Enum comparison_operator {
  EQ [note: 'Equal']
  NE [note: 'Not equal']
  GT [note: 'Greater than']
  GE [note: 'Greater or equal']
  LT [note: 'Less than']
  LE [note: 'Less or equal']
}

Enum incident_event_type {
  TRIGGERED
  ACKNOWLEDGED
  ASSIGNED
  ESCALATED
  COMMENTED
  RESOLVED
  REOPENED
  AUTO_RESOLVED
}
-e 


// ============================================================================
// L2-530: REPORTING SYSTEM (RS)
// L2-540: VISUALIZATION SYSTEM (VS)
// L2-550: COLLABORATION SYSTEM (CS)
// File: L1-500_mission_control/L2-530_540_550_reporting_viz_collab.dbml
// Segment: L1-500 Mission Control
// ============================================================================
// PM4Py Modules: pm4py.vis
// ============================================================================

// ============================================================================
// L2-530: REPORTING SYSTEM
// ============================================================================
// Subsystems:
//   L3-531: Report Generation Subsystem
//   L3-532: Export Subsystem
//   L3-533: Scheduling Subsystem
// ============================================================================

Table reports {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  project_id uuid [ref: > projects.id, default: null]
  
  // Identity
  name varchar(255) [not null]
  description text [default: null]
  
  report_type report_type [not null]
  status report_status [default: 'DRAFT']
  
  // Template
  template_id uuid [ref: > report_templates.id, default: null]
  
  // Data Sources
  source_process_ids uuid[] [default: '{}']
  source_event_log_ids uuid[] [default: '{}']
  source_model_ids uuid[] [default: '{}']
  
  // Configuration
  config jsonb [default: '{}']
  sections jsonb [default: '[]', note: 'Report sections definition']
  
  // Filters
  date_range_type date_range_type [default: 'LAST_30_DAYS']
  date_from timestamp [default: null]
  date_to timestamp [default: null]
  filters jsonb [default: '{}']
  
  // Scheduling
  is_scheduled boolean [default: false]
  schedule_cron varchar(100) [default: null]
  schedule_timezone varchar(50) [default: 'UTC']
  next_scheduled_run timestamp [default: null]
  
  // Recipients
  recipients text[] [default: '{}']
  recipient_user_ids uuid[] [default: '{}']
  recipient_team_ids uuid[] [default: '{}']
  
  // Delivery
  delivery_format export_format [default: 'PDF']
  delivery_method delivery_method [default: 'EMAIL']
  
  // Statistics
  last_generated_at timestamp [default: null]
  generation_count int [default: 0]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, status)
    (org_id, report_type)
    (project_id)
    next_scheduled_run
  }
  
  Note: 'Report definitions'
}

Table report_templates {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, default: null, note: 'null = system template']
  
  name varchar(255) [not null]
  description text [default: null]
  
  template_type report_type [not null]
  
  // Template Content
  template_content text [not null, note: 'HTML/Markdown template']
  
  // Sections
  sections_schema jsonb [default: '[]']
  
  // Variables
  available_variables jsonb [default: '{}']
  
  // Styling
  css_styles text [default: null]
  header_template text [default: null]
  footer_template text [default: null]
  
  is_system boolean [default: false]
  is_default boolean [default: false]
  
  created_by uuid [ref: > users.id, default: null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, template_type)
  }
  
  Note: 'Report templates'
}

Table report_executions {
  id uuid [pk, default: `gen_random_uuid()`]
  report_id uuid [ref: > reports.id, not null]
  org_id uuid [ref: > organizations.id, not null]
  
  status job_status [default: 'PENDING']
  
  // Trigger
  triggered_by report_trigger [default: 'MANUAL']
  triggered_by_user uuid [ref: > users.id, default: null]
  
  // Parameters (snapshot)
  parameters jsonb [default: '{}']
  date_from timestamp [default: null]
  date_to timestamp [default: null]
  
  // Output
  output_format export_format [not null]
  output_file_path text [default: null]
  output_file_size_bytes bigint [default: null]
  output_page_count int [default: null]
  
  // Timing
  queued_at timestamp [default: null]
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  // Delivery
  delivery_status delivery_status [default: 'PENDING']
  delivered_at timestamp [default: null]
  
  // Error
  error_message text [default: null]
  
  created_at timestamp [default: `now()`]
  expires_at timestamp [default: null]
  
  indexes {
    (report_id, status)
    (org_id, status)
    created_at
  }
  
  Note: 'Report generation history'
}

Table exports {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  // Export Type
  export_type export_type [not null]
  export_format export_format [not null]
  
  // Source
  event_log_id uuid [ref: > event_logs.id, default: null]
  ocel_log_id uuid [ref: > ocel_logs.id, default: null]
  model_id uuid [ref: > process_models.id, default: null]
  dashboard_id uuid [ref: > dashboards.id, default: null]
  report_execution_id uuid [ref: > report_executions.id, default: null]
  
  status job_status [default: 'PENDING']
  
  // Configuration
  config jsonb [default: '{}']
  
  // Output
  file_path text [default: null]
  file_size_bytes bigint [default: null]
  download_url text [default: null]
  
  // Timing
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  expires_at timestamp [default: null]
  
  indexes {
    (org_id, status)
    (org_id, export_type)
    created_at
  }
  
  Note: 'Data export jobs'
}

// ============================================================================
// L2-540: VISUALIZATION SYSTEM (pm4py.vis)
// ============================================================================
// Subsystems:
//   L3-541: Process Visualization Subsystem
//   L3-542: Analytics Visualization Subsystem
//   L3-543: Interactive Exploration Subsystem
// ============================================================================

Table dashboards {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  project_id uuid [ref: > projects.id, default: null]
  
  // Identity
  name varchar(255) [not null]
  description text [default: null]
  
  dashboard_type dashboard_type [default: 'CUSTOM']
  
  // Layout
  layout_type layout_type [default: 'GRID']
  layout_config jsonb [default: '{}']
  columns int [default: 12]
  row_height int [default: 50]
  
  // Access
  visibility visibility_type [default: 'PRIVATE']
  shared_with_users uuid[] [default: '{}']
  shared_with_teams uuid[] [default: '{}']
  
  // Refresh
  auto_refresh boolean [default: false]
  refresh_interval_seconds int [default: 300]
  
  // Default Filters
  default_filters jsonb [default: '{}']
  
  // Statistics
  view_count int [default: 0]
  last_viewed_at timestamp [default: null]
  
  // Ownership
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (org_id, visibility)
    (org_id, dashboard_type)
    (project_id)
    (created_by)
  }
  
  Note: 'Dashboard definitions'
}

Table dashboard_widgets {
  id uuid [pk, default: `gen_random_uuid()`]
  dashboard_id uuid [ref: > dashboards.id, not null]
  
  // Identity
  name varchar(255) [not null]
  widget_type widget_type [not null]
  
  // Position & Size (grid layout)
  position_x int [default: 0]
  position_y int [default: 0]
  width int [default: 4]
  height int [default: 3]
  
  // Data Source
  event_log_id uuid [ref: > event_logs.id, default: null]
  process_id uuid [ref: > processes.id, default: null]
  model_id uuid [ref: > process_models.id, default: null]
  
  // Configuration
  config jsonb [default: '{}']
  
  // Visualization (pm4py.vis)
  visualization_type visualization_type [default: null]
  visualization_params jsonb [default: '{}']
  
  // Styling
  style_config jsonb [default: '{}']
  
  // Caching
  cache_ttl_seconds int [default: 300]
  last_refreshed_at timestamp [default: null]
  cached_data jsonb [default: null]
  
  display_order int [default: 0]
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (dashboard_id, display_order)
    (dashboard_id)
  }
  
  Note: 'Dashboard widgets'
}

Table saved_visualizations {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  name varchar(255) [not null]
  description text [default: null]
  
  // Visualization Type (pm4py.vis)
  visualization_type visualization_type [not null]
  
  // Source
  event_log_id uuid [ref: > event_logs.id, default: null]
  model_id uuid [ref: > process_models.id, default: null]
  sna_analysis_id uuid [ref: > sna_analyses.id, default: null]
  conformance_check_id uuid [ref: > conformance_checks.id, default: null]
  
  // Parameters
  params jsonb [default: '{}']
  
  // Generated Content
  svg_content text [default: null]
  png_content bytea [default: null]
  html_content text [default: null]
  
  // Metadata
  width int [default: null]
  height int [default: null]
  
  // Visibility
  visibility visibility_type [default: 'PRIVATE']
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (org_id, visualization_type)
    (event_log_id)
    (model_id)
  }
  
  Note: 'Saved visualizations (pm4py.vis output)'
}

Table exploration_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  user_id uuid [ref: > users.id, not null]
  
  // Context
  event_log_id uuid [ref: > event_logs.id, default: null]
  process_id uuid [ref: > processes.id, default: null]
  
  // Session State
  current_view visualization_type [default: null]
  current_filters jsonb [default: '{}']
  view_stack jsonb [default: '[]', note: 'Navigation history']
  
  // Selections
  selected_activities text[] [default: '{}']
  selected_variants uuid[] [default: '{}']
  selected_cases text[] [default: '{}']
  
  // Timing
  started_at timestamp [default: `now()`]
  last_activity_at timestamp [default: `now()`]
  
  indexes {
    (user_id, started_at)
    (org_id, event_log_id)
  }
  
  Note: 'Interactive exploration sessions'
}

// ============================================================================
// L2-550: COLLABORATION SYSTEM
// ============================================================================
// Subsystems:
//   L3-551: Dashboard Subsystem (above)
//   L3-552: Commentary Subsystem
//   L3-553: Annotation Subsystem
// ============================================================================

Table comments {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  // Target Entity
  entity_type varchar(100) [not null]
  entity_id uuid [not null]
  
  // Threading
  parent_id uuid [ref: > comments.id, default: null]
  thread_root_id uuid [ref: > comments.id, default: null]
  
  // Content
  content text [not null]
  content_format content_format [default: 'MARKDOWN']
  
  // Attachments
  attachments jsonb [default: '[]']
  
  // Mentions
  mentioned_users uuid[] [default: '{}']
  
  // Reactions
  reactions jsonb [default: '{}', note: 'emoji -> user_id[]']
  
  // Status
  is_resolved boolean [default: false]
  resolved_by uuid [ref: > users.id, default: null]
  resolved_at timestamp [default: null]
  
  // Editing
  is_edited boolean [default: false]
  edited_at timestamp [default: null]
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp [default: null]
  
  indexes {
    (entity_type, entity_id)
    (parent_id)
    (thread_root_id)
    (org_id, created_at)
  }
  
  Note: 'Comments on any entity'
}

Table annotations {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  // Target
  model_id uuid [ref: > process_models.id, default: null]
  visualization_id uuid [ref: > saved_visualizations.id, default: null]
  dashboard_id uuid [ref: > dashboards.id, default: null]
  
  // Position
  position_x float [not null]
  position_y float [not null]
  
  // Anchor (for model elements)
  anchor_type anchor_type [default: null]
  anchor_element_id varchar(255) [default: null]
  
  // Content
  content text [not null]
  
  // Style
  color varchar(7) [default: '#ffeb3b']
  icon varchar(50) [default: 'note']
  
  // Visibility
  visibility visibility_type [default: 'PRIVATE']
  
  created_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (model_id)
    (visualization_id)
    (dashboard_id)
    (org_id, created_by)
  }
  
  Note: 'Visual annotations on models and visualizations'
}

Table bookmarks {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id, not null]
  org_id uuid [ref: > organizations.id, not null]
  
  // Target
  entity_type varchar(100) [not null]
  entity_id uuid [not null]
  
  // Metadata
  name varchar(255) [default: null]
  notes text [default: null]
  
  // Organization
  folder varchar(255) [default: null]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (user_id, entity_type, entity_id) [unique]
    (user_id, folder)
  }
  
  Note: 'User bookmarks'
}

Table shares {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  
  // Source
  entity_type varchar(100) [not null]
  entity_id uuid [not null]
  
  // Share Type
  share_type share_type [not null]
  
  // For LINK shares
  share_token varchar(255) [default: null, unique]
  password_hash varchar(255) [default: null]
  
  // For USER/TEAM shares
  shared_with_user_id uuid [ref: > users.id, default: null]
  shared_with_team_id uuid [ref: > teams.id, default: null]
  
  // Permissions
  permission permission_level [default: 'VIEW']
  
  // Expiration
  expires_at timestamp [default: null]
  
  // Usage
  access_count int [default: 0]
  last_accessed_at timestamp [default: null]
  
  shared_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (entity_type, entity_id)
    share_token [unique]
    (shared_with_user_id)
    (shared_with_team_id)
  }
  
  Note: 'Resource sharing'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum report_status {
  DRAFT
  ACTIVE
  ARCHIVED
}

Enum date_range_type {
  CUSTOM
  TODAY
  YESTERDAY
  LAST_7_DAYS
  LAST_30_DAYS
  LAST_90_DAYS
  THIS_MONTH
  LAST_MONTH
  THIS_QUARTER
  LAST_QUARTER
  THIS_YEAR
  LAST_YEAR
  ALL_TIME
}

Enum delivery_method {
  EMAIL
  DOWNLOAD
  WEBHOOK
  SLACK
  TEAMS
}

Enum delivery_status {
  PENDING
  SENT
  DELIVERED
  FAILED
}

Enum report_trigger {
  MANUAL
  SCHEDULED
  API
  EVENT
}

Enum layout_type {
  GRID
  FREEFORM
  FIXED
}

Enum content_format {
  PLAIN
  MARKDOWN
  HTML
}

Enum anchor_type {
  ACTIVITY
  TRANSITION
  GATEWAY
  PLACE
  EDGE
  REGION
}

Enum share_type {
  LINK [note: 'Public link with optional password']
  USER [note: 'Specific user']
  TEAM [note: 'Team members']
  ORGANIZATION [note: 'All org members']
}
-e 


// ============================================================================
// INTERFACE CONTROL DOCUMENT (ICD)
// File: interfaces/interface_tables.dbml
// Cross-System Reference Tables & Integration Points
// ============================================================================

// ============================================================================
// INTERFACE SUMMARY
// ============================================================================
// 
// IF-001: IAMS (L2-110) → ALL         | Auth Tokens (JWT/OAuth2)
// IF-002: ELMS (L2-210) → PDS (L2-310) | Event Logs
// IF-003: ELMS (L2-210) → CCS (L2-330) | Event Logs
// IF-004: PDS (L2-310) → PMS (L2-320)  | Process Models
// IF-005: PMS (L2-320) → CCS (L2-330)  | Process Models
// IF-006: DCS (L2-230) → ELMS (L2-210) | Raw Events
// IF-007: OCELS (L2-220) → ELMS        | Flattened Logs
// IF-008: AMS (L2-340) → VS (L2-540)   | Metrics
// IF-009: MLS (L2-410) → AS (L2-510)   | Predictions
// IF-010: LIS (L2-420) → External LLM  | Prompts/Responses
// IF-011: ANS (L2-520) → External      | Notifications
// IF-012: ACS (L2-130) ← ALL           | Audit Events
//
// ============================================================================

// ============================================================================
// EVENT BUS (Async Communication)
// ============================================================================

Table event_bus_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Event Identity
  event_type event_bus_type [not null]
  event_version varchar(10) [default: '1.0']
  
  // Source
  source_system varchar(50) [not null]
  source_subsystem varchar(50) [default: null]
  
  // Correlation
  correlation_id uuid [not null]
  causation_id uuid [default: null]
  
  // Tenant
  org_id uuid [ref: > organizations.id, not null]
  
  // Payload
  payload jsonb [not null]
  
  // Metadata
  metadata jsonb [default: '{}']
  
  // Status
  status message_status [default: 'PENDING']
  
  // Processing
  processed_at timestamp [default: null]
  processed_by varchar(100) [default: null]
  retry_count int [default: 0]
  
  // Error
  error_message text [default: null]
  
  created_at timestamp [default: `now()`]
  expires_at timestamp [default: null]
  
  indexes {
    (event_type, status)
    (org_id, event_type)
    correlation_id
    created_at
  }
  
  Note: 'Async event bus for system integration'
}

Table event_subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Subscriber
  subscriber_system varchar(50) [not null]
  subscriber_endpoint varchar(500) [not null]
  
  // Event Filter
  event_types event_bus_type[] [not null]
  filter_expression jsonb [default: null]
  
  // Delivery
  delivery_mode delivery_mode [default: 'PUSH']
  batch_size int [default: 1]
  batch_timeout_ms int [default: 1000]
  
  // Retry
  max_retries int [default: 3]
  retry_backoff_ms int [default: 1000]
  
  is_active boolean [default: true]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (subscriber_system, is_active)
    (event_types)
  }
  
  Note: 'Event bus subscriptions'
}

// ============================================================================
// SYSTEM HEALTH & MONITORING
// ============================================================================

Table system_health {
  id uuid [pk, default: `gen_random_uuid()`]
  
  system_id varchar(50) [not null]
  subsystem_id varchar(50) [default: null]
  
  // Health Status
  status health_status [not null]
  
  // Metrics
  cpu_percent float [default: null]
  memory_percent float [default: null]
  disk_percent float [default: null]
  
  // Latency
  avg_latency_ms float [default: null]
  p95_latency_ms float [default: null]
  p99_latency_ms float [default: null]
  
  // Throughput
  requests_per_second float [default: null]
  errors_per_second float [default: null]
  
  // Queue Depths
  queue_depth int [default: null]
  
  // Custom Metrics
  custom_metrics jsonb [default: '{}']
  
  recorded_at timestamp [default: `now()`]
  
  indexes {
    (system_id, recorded_at)
    (system_id, subsystem_id, recorded_at)
  }
  
  Note: 'System health metrics (time-series)'
}

Table interface_metrics {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Interface
  interface_id varchar(20) [not null, note: 'e.g., IF-001']
  source_system varchar(50) [not null]
  target_system varchar(50) [not null]
  
  // Time Period
  period_start timestamp [not null]
  period_end timestamp [not null]
  period_type period_type [not null]
  
  // Volume
  total_calls bigint [default: 0]
  successful_calls bigint [default: 0]
  failed_calls bigint [default: 0]
  
  // Latency
  avg_latency_ms float [default: null]
  min_latency_ms float [default: null]
  max_latency_ms float [default: null]
  p50_latency_ms float [default: null]
  p95_latency_ms float [default: null]
  p99_latency_ms float [default: null]
  
  // Data Volume
  bytes_transferred bigint [default: 0]
  
  // Errors
  error_breakdown jsonb [default: '{}', note: 'error_code -> count']
  
  created_at timestamp [default: `now()`]
  
  indexes {
    (interface_id, period_start)
    (source_system, target_system, period_start)
  }
  
  Note: 'Interface performance metrics'
}

// ============================================================================
// FEATURE FLAGS & CONFIGURATION
// ============================================================================

Table feature_flags {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Flag Identity
  flag_key varchar(100) [not null, unique]
  name varchar(255) [not null]
  description text [default: null]
  
  // Type
  flag_type flag_type [default: 'BOOLEAN']
  default_value jsonb [not null]
  
  // State
  is_enabled boolean [default: false]
  
  // Targeting
  targeting_rules jsonb [default: '[]']
  
  // Rollout
  rollout_percentage float [default: 100]
  
  // Metadata
  owner varchar(255) [default: null]
  tags text[] [default: '{}']
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  indexes {
    flag_key [unique]
    (is_enabled)
  }
  
  Note: 'Feature flags for gradual rollout'
}

Table org_feature_overrides {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [ref: > organizations.id, not null]
  flag_id uuid [ref: > feature_flags.id, not null]
  
  // Override Value
  value jsonb [not null]
  is_enabled boolean [not null]
  
  // Reason
  reason text [default: null]
  
  enabled_by uuid [ref: > users.id]
  enabled_at timestamp [default: `now()`]
  expires_at timestamp [default: null]
  
  indexes {
    (org_id, flag_id) [unique]
  }
  
  Note: 'Per-organization feature flag overrides'
}

// ============================================================================
// JOB QUEUE (Cross-System)
// ============================================================================

Table job_queue {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Job Identity
  job_type job_queue_type [not null]
  job_name varchar(255) [default: null]
  
  // Tenant
  org_id uuid [ref: > organizations.id, not null]
  
  // Status
  status job_status [default: 'PENDING']
  priority job_priority [default: 'NORMAL']
  
  // Routing
  target_system varchar(50) [not null]
  target_subsystem varchar(50) [default: null]
  
  // Payload
  payload jsonb [not null]
  
  // Scheduling
  scheduled_at timestamp [default: null]
  not_before timestamp [default: null]
  
  // Execution
  worker_id varchar(100) [default: null]
  started_at timestamp [default: null]
  completed_at timestamp [default: null]
  duration_ms int [default: null]
  
  // Result
  result jsonb [default: null]
  
  // Error Handling
  error_message text [default: null]
  error_count int [default: 0]
  max_retries int [default: 3]
  next_retry_at timestamp [default: null]
  
  // Dependencies
  depends_on uuid[] [default: '{}']
  
  created_by uuid [ref: > users.id, default: null]
  created_at timestamp [default: `now()`]
  
  indexes {
    (status, priority, scheduled_at)
    (org_id, status)
    (target_system, status)
    (job_type, status)
    worker_id
  }
  
  Note: 'Distributed job queue'
}

// ============================================================================
// RATE LIMITING
// ============================================================================

Table rate_limits {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Limit Identity
  limit_key varchar(255) [not null, unique]
  
  // Limit Configuration
  requests_per_second int [default: null]
  requests_per_minute int [default: null]
  requests_per_hour int [default: null]
  requests_per_day int [default: null]
  
  // Burst
  burst_size int [default: null]
  
  // Scope
  scope_type rate_limit_scope [not null]
  
  is_active boolean [default: true]
  
  created_at timestamp [default: `now()`]
  
  indexes {
    limit_key [unique]
    (scope_type, is_active)
  }
  
  Note: 'Rate limit configurations'
}

Table rate_limit_counters {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Key
  limit_key varchar(255) [not null]
  identifier varchar(255) [not null, note: 'org_id, user_id, IP, etc.']
  window_start timestamp [not null]
  window_type rate_window_type [not null]
  
  // Counter
  request_count int [default: 0]
  
  // Last Update
  last_request_at timestamp [default: null]
  
  indexes {
    (limit_key, identifier, window_start, window_type) [unique]
    (window_start)
  }
  
  Note: 'Rate limit counters (ephemeral)'
}

// ============================================================================
// DISTRIBUTED LOCKS
// ============================================================================

Table distributed_locks {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // Lock Identity
  lock_key varchar(255) [not null, unique]
  
  // Owner
  owner_id varchar(255) [not null]
  owner_system varchar(50) [not null]
  
  // TTL
  acquired_at timestamp [default: `now()`]
  expires_at timestamp [not null]
  
  // Metadata
  metadata jsonb [default: '{}']
  
  indexes {
    lock_key [unique]
    expires_at
  }
  
  Note: 'Distributed locks for coordination'
}

// ============================================================================
// CROSS-SYSTEM REFERENCE TABLES
// ============================================================================

// Maps PM4Py operations to system/subsystem
Table pm4py_operation_mapping {
  id uuid [pk, default: `gen_random_uuid()`]
  
  // PM4Py Reference
  pm4py_module varchar(50) [not null]
  pm4py_function varchar(100) [not null]
  
  // System Mapping
  system_id varchar(50) [not null]
  subsystem_id varchar(50) [not null]
  
  // Operation Info
  description text [default: null]
  input_types text[] [default: '{}']
  output_type varchar(100) [default: null]
  
  // Async?
  is_async boolean [default: false]
  typical_duration_ms int [default: null]
  
  indexes {
    (pm4py_module, pm4py_function) [unique]
  }
  
  Note: 'Maps PM4Py functions to platform systems'
}

// ============================================================================
// SUPPORTING ENUMS
// ============================================================================

Enum event_bus_type {
  // Ground Segment
  USER_CREATED
  USER_UPDATED
  ORG_CREATED
  ORG_UPDATED
  
  // Data Segment
  EVENT_LOG_UPLOADED
  EVENT_LOG_PROCESSED
  EVENT_LOG_DELETED
  OCEL_LOG_UPLOADED
  OCEL_LOG_PROCESSED
  CONNECTOR_SYNCED
  
  // Processing Segment
  DISCOVERY_STARTED
  DISCOVERY_COMPLETED
  DISCOVERY_FAILED
  CONFORMANCE_STARTED
  CONFORMANCE_COMPLETED
  MODEL_CREATED
  MODEL_PUBLISHED
  
  // Intelligence Segment
  ML_TRAINING_STARTED
  ML_TRAINING_COMPLETED
  PREDICTION_GENERATED
  LLM_SESSION_CREATED
  SNA_ANALYSIS_COMPLETED
  
  // Mission Control
  ALERT_TRIGGERED
  ALERT_RESOLVED
  AUTOMATION_EXECUTED
  REPORT_GENERATED
}

Enum message_status {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

Enum delivery_mode {
  PUSH [note: 'HTTP POST to subscriber']
  PULL [note: 'Subscriber polls']
}

Enum period_type {
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
}

Enum flag_type {
  BOOLEAN
  STRING
  NUMBER
  JSON
}

Enum job_queue_type {
  DISCOVERY
  CONFORMANCE
  ANALYSIS
  ML_TRAINING
  ML_PREDICTION
  SYNC
  EXPORT
  REPORT
  NOTIFICATION
  CLEANUP
}

Enum rate_limit_scope {
  GLOBAL
  ORGANIZATION
  USER
  API_KEY
  IP
  ENDPOINT
}

Enum rate_window_type {
  SECOND
  MINUTE
  HOUR
  DAY
}
