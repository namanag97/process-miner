flowchart TD
    %% ═══════════════════════════════════════════════════════
    %% API ROUTE HIERARCHY - PROCESS MINING MVP
    %% ═══════════════════════════════════════════════════════

    API["/api/v1"]
    
    %% ════════════════════════════════════════════════════════
    %% LEVEL 1: TOP LEVEL MODULES
    %% ════════════════════════════════════════════════════════
    
    API --> Health["/health"]
    API --> Auth["/auth"]
    API --> Orgs["/organizations"]
    API --> Workspaces["/workspaces"]
    API --> Projects["/projects"]
    API --> Datasets["/datasets"]
    API --> Jobs["/jobs"]
    API --> Admin["/admin"]

    %% ════════════════════════════════════════════════════════
    %% HEALTH
    %% ════════════════════════════════════════════════════════
    
    Health --> H1["GET /"]
    Health --> H2["GET /ready"]
    Health --> H3["GET /live"]

    %% ════════════════════════════════════════════════════════
    %% AUTH
    %% ════════════════════════════════════════════════════════
    
    Auth --> AuthCore["Core"]
    Auth --> AuthOAuth["/oauth"]
    
    AuthCore --> AC1["POST /register"]
    AuthCore --> AC2["POST /login"]
    AuthCore --> AC3["POST /logout"]
    AuthCore --> AC4["POST /refresh"]
    AuthCore --> AC5["GET|PUT /me"]
    AuthCore --> AC6["POST /forgot-password"]
    AuthCore --> AC7["POST /reset-password"]
    AuthCore --> AC8["POST /change-password"]
    
    AuthOAuth --> AO1["GET /google"]
    AuthOAuth --> AO2["GET /google/callback"]
    AuthOAuth --> AO3["GET /github"]
    AuthOAuth --> AO4["GET /github/callback"]

    %% ════════════════════════════════════════════════════════
    %% ORGANIZATIONS
    %% ════════════════════════════════════════════════════════
    
    Orgs --> OrgCRUD["CRUD"]
    Orgs --> OrgID["/:org_id"]
    
    OrgCRUD --> OC1["GET /"]
    OrgCRUD --> OC2["POST /"]
    
    OrgID --> OI1["GET /"]
    OrgID --> OI2["PUT /"]
    OrgID --> OI3["DELETE /"]
    OrgID --> OrgMembers["/members"]
    OrgID --> OrgBilling["/billing"]
    
    OrgMembers --> OM1["GET /"]
    OrgMembers --> OM2["POST /invite"]
    OrgMembers --> OM3["DELETE /:user_id"]
    OrgMembers --> OM4["PUT /:user_id/role"]

    %% ════════════════════════════════════════════════════════
    %% WORKSPACES
    %% ════════════════════════════════════════════════════════
    
    Workspaces --> WSCRUD["CRUD"]
    Workspaces --> WSID["/:ws_id"]
    
    WSCRUD --> WC1["GET /?org_id=x"]
    WSCRUD --> WC2["POST /"]
    
    WSID --> WI1["GET /"]
    WSID --> WI2["PUT /"]
    WSID --> WI3["DELETE /"]
    WSID --> WSMembers["/members"]
    
    WSMembers --> WM1["GET /"]
    WSMembers --> WM2["POST /"]
    WSMembers --> WM3["PUT /:user_id"]
    WSMembers --> WM4["DELETE /:user_id"]

    %% ════════════════════════════════════════════════════════
    %% PROJECTS
    %% ════════════════════════════════════════════════════════
    
    Projects --> ProjCRUD["CRUD"]
    Projects --> ProjID["/:proj_id"]
    
    ProjCRUD --> PC1["GET /?workspace_id=x"]
    ProjCRUD --> PC2["POST /"]
    
    ProjID --> PI1["GET /"]
    ProjID --> PI2["PUT /"]
    ProjID --> PI3["DELETE /"]
    ProjID --> PI4["POST /archive"]
    ProjID --> PI5["POST /restore"]

    %% ════════════════════════════════════════════════════════
    %% DATASETS (Critical - Expanded)
    %% ════════════════════════════════════════════════════════
    
    Datasets --> DSCRUD["CRUD"]
    Datasets --> DSUpload["Upload"]
    Datasets --> DSID["/:ds_id"]
    
    DSCRUD --> DC1["GET /?project_id=x"]
    
    DSUpload --> DU1["POST / (direct)"]
    DSUpload --> DU2["POST /presign"]
    
    DSID --> DI1["GET /"]
    DSID --> DI2["PUT /"]
    DSID --> DI3["DELETE /"]
    DSID --> DI4["POST /uploaded"]
    DSID --> DSMapping["/mapping ⚠️"]
    DSID --> DSColumns["/columns"]
    DSID --> DSIngest["/ingest"]
    DSID --> DSData["Data Access"]
    DSID --> DSExport["Export"]
    
    DSColumns --> DCO1["GET /"]
    
    DSMapping --> DM1["GET /"]
    DSMapping --> DM2["POST /"]
    DSMapping --> DM3["PUT /"]
    
    DSIngest --> DIN1["POST /"]
    DSIngest --> DIN2["POST /reingest"]
    DSID --> DIN3["POST /preview"]
    
    DSData --> DD1["GET /events"]
    DSData --> DD2["GET /cases"]
    DSData --> DD3["GET /activities"]
    DSData --> DD4["GET /metadata"]
    
    DSExport --> DE1["POST /export"]
    DSExport --> DE2["GET /download"]

    %% ════════════════════════════════════════════════════════
    %% JOBS
    %% ════════════════════════════════════════════════════════
    
    Jobs --> JobList["GET /?filters"]
    Jobs --> JobID["/:job_id"]
    
    JobID --> JI1["GET /"]
    JobID --> JI2["POST /cancel"]
    JobID --> JI3["GET /logs"]

    %% ════════════════════════════════════════════════════════
    %% ADMIN
    %% ════════════════════════════════════════════════════════
    
    Admin --> AdminUsers["/users"]
    Admin --> AdminErrors["/errors"]
    Admin --> AdminStats["GET /stats"]
    
    AdminUsers --> AU1["GET /"]
    AdminUsers --> AU2["GET /:user_id"]
    AdminUsers --> AU3["PUT /:user_id"]
    AdminUsers --> AU4["POST /:user_id/disable"]
    
    AdminErrors --> AE1["GET /"]
    AdminErrors --> AE2["GET /:error_id"]
    AdminErrors --> AE3["PUT /:error_id/resolve"]

    %% ════════════════════════════════════════════════════════
    %% STYLING
    %% ════════════════════════════════════════════════════════
    
    style API fill:#1a1a2e,color:#fff,stroke:#16213e
    
    style Health fill:#4caf50,color:#fff
    style Auth fill:#ff9800,color:#fff
    style Orgs fill:#2196f3,color:#fff
    style Workspaces fill:#9c27b0,color:#fff
    style Projects fill:#009688,color:#fff
    style Datasets fill:#f44336,color:#fff
    style Jobs fill:#795548,color:#fff
    style Admin fill:#607d8b,color:#fff
    
    style DSMapping fill:#ffeb3b,color:#000,stroke:#f57f17,stroke-width:3px
    style DSColumns fill:#fff9c4,stroke:#f57f17
    style DSIngest fill:#fff9c4,stroke:#f57f17
    style DSData fill:#fff9c4,stroke:#f57f17
    
    style AuthOAuth fill:#ffe0b2,stroke:#ff9800
    style OrgMembers fill:#bbdefb,stroke:#2196f3
    style WSMembers fill:#e1bee7,stroke:#9c27b0
