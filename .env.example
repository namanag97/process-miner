# ===========================================
# Process Mining Platform - Environment Config
# ===========================================
# Copy this file to .env.local for local development

# Backend API URL (change for production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===========================================
# Sentry Error Tracking (Optional - get from sentry.io)
# ===========================================
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=process-miner-frontend

# ===========================================
# Backend Environment Variables
# ===========================================
# In backend/.env or as environment variables:
# DEBUG=true
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
